package jscapi

// GENERATED by a script from the signatures of the API procedures (one exported forwarder each): with
// -define:JSCAPI_EXPORT=true C code that still calls the QuickJS API links against these symbols.
// The forwarders are separate procedures because a conditionally exported API procedure referenced from
// another package makes the compiler lose the body check (llvm_backend_proc.cpp: was parapoly).

when JSCAPI_EXPORT {

@(export, link_name = "JS_NewRuntime")
export_JS_NewRuntime :: proc "c" () -> ^Runtime {return JS_NewRuntime()}
