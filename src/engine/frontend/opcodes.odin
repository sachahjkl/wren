package frontend

// The QuickJS-ng 0.17 instruction set, transcribed from quickjs-opcode.h. This is one half of the contract
// with E2 (the runtime): the opcode byte values, their operand formats and their stack effects must match
// QuickJS exactly, because the bytecode we emit is read back by a runtime that decodes these same bytes, and
// because the differential judge compares our output with QuickJS's byte for byte.
//
// QuickJS numbers opcodes in a subtle way (OPCodeEnum in quickjs.c). It first assigns every DEF() opcode a
// contiguous value: invalid=0, push_i32=1, ..., nop, then the short opcodes push_minus1 ... typeof_is_function,
// then OP_COUNT. The temporary def() opcodes (enter_scope ... source_loc) do NOT get their own byte values; they
// "overlap with the short opcodes", starting again at OP_nop+1. They never appear in final bytecode: phase 1
// emits them, phase 2/3 removes them. So the real byte space is the DEF() opcodes only, and they must be < 256.
//
// We reproduce this exactly: `Opcode` lists only the DEF() opcodes, in source order, with the short opcodes
// placed right after `nop` (so push_minus1 gets the value QuickJS gives it). The temporary opcodes live in a
// separate `Temp_Op` enum; they are a parser/first-phase device and carry no byte-value contract, so giving them
// distinct Odin values is fine. The emitter works on a `Bc_Op` union of the two during phases 1-2.

Opcode :: enum u8 {
	invalid = 0,

	// --- push values ---
	push_i32,
	push_const,
	fclosure,
	push_atom_value,
	private_symbol,
	undefined,
	null,
	push_this,
	push_false,
	push_true,
	object,
	special_object,
	rest,

	drop,
	nip,
	nip1,
	dup,
	dup1,
	dup2,
	dup3,
	insert2,
	insert3,
	insert4,
	perm3,
	perm4,
	perm5,
	swap,
	swap2,
	rot3l,
	rot3r,
	rot4l,
	rot5l,

	call_constructor,
	call,
	tail_call,
	call_method,
	tail_call_method,
	array_from,
	apply,
	ret_,                 // "return" is a keyword in Odin; the QuickJS name is OP_return
	return_undef,
	check_ctor_return,
	check_ctor,
	init_ctor,
	check_brand,
	add_brand,
	return_async,
	throw_,               // OP_throw
	throw_error,
	eval,
	apply_eval,
	regexp,
	get_super,
	import_,              // OP_import

	get_var_undef,
	get_var,
	put_var,
	put_var_init,

	get_ref_value,
	put_ref_value,

	define_var,
	check_define_var,
	define_func,

	get_field,
	get_field2,
	put_field,

	get_private_field,
	put_private_field,
	define_private_field,
	get_array_el,
	get_array_el2,
	put_array_el,
	get_super_value,
	put_super_value,
	define_field,
	set_name,
	set_name_computed,
	set_proto,
	set_home_object,
	define_array_el,
	append,
	copy_data_properties,
	define_method,
	define_method_computed,
	define_class,
	define_class_computed,

	get_loc,
	put_loc,
	set_loc,
	get_arg,
	put_arg,
	set_arg,
	get_var_ref,
	put_var_ref,
	set_var_ref,
	set_loc_uninitialized,
	get_loc_check,
	put_loc_check,
	put_loc_check_init,
	get_var_ref_check,
	put_var_ref_check,
	put_var_ref_check_init,
	close_loc,
	if_false,
	if_true,
	goto,
	catch,
	gosub,
	ret,
	nip_catch,

	check_object,
	to_object,
	to_propkey,
	to_propkey2,

	with_get_var,
	with_put_var,
	with_delete_var,
	with_make_ref,
	with_get_ref,
	with_get_ref_undef,

	make_loc_ref,
	make_arg_ref,
	make_var_ref_ref,
	make_var_ref,

	for_in_start,
	for_of_start,
	for_await_of_start,
	for_in_next,
	for_of_next,
	iterator_get_value_done,
	iterator_close,
	iterator_next,
	iterator_call,
	initial_yield,
	yield,
	yield_star,
	async_yield_star,
	await,

	// --- arithmetic/logic ---
	neg,
	plus,
	dec,
	inc,
	post_dec,
	post_inc,
	dec_loc,
	inc_loc,
	add_loc,
	not,
	lnot,
	typeof_,              // OP_typeof
	delete_,              // OP_delete
	delete_var,

	mul,
	div,
	mod,
	add,
	sub,
	shl,
	sar,
	shr,
	and,
	xor,
	or,
	pow,

	lt,
	lte,
	gt,
	gte,
	instanceof,
	in_,                  // OP_in
	eq,
	neq,
	strict_eq,
	strict_neq,
	is_undefined_or_null,
	private_in,
	push_bigint_i32,
	using_dispose_init,
	using_dispose,
	using_dispose_async,
	using_dispose_merge,
	using_dispose_end,
	using_check,
	nop,

	// --- short opcodes (continue the byte space right after nop, as in QuickJS) ---
	push_minus1,
	push_0,
	push_1,
	push_2,
	push_3,
	push_4,
	push_5,
	push_6,
	push_7,
	push_i8,
	push_i16,
	push_const8,
	fclosure8,
	push_empty_string,

	get_loc8,
	put_loc8,
	set_loc8,

	get_loc0_loc1,
	get_loc0,
	get_loc1,
	get_loc2,
	get_loc3,
	put_loc0,
	put_loc1,
	put_loc2,
	put_loc3,
	set_loc0,
	set_loc1,
	set_loc2,
	set_loc3,
	get_arg0,
	get_arg1,
	get_arg2,
	get_arg3,
	put_arg0,
	put_arg1,
	put_arg2,
	put_arg3,
	set_arg0,
	set_arg1,
	set_arg2,
	set_arg3,
	get_var_ref0,
	get_var_ref1,
	get_var_ref2,
	get_var_ref3,
	put_var_ref0,
	put_var_ref1,
	put_var_ref2,
	put_var_ref3,
	set_var_ref0,
	set_var_ref1,
	set_var_ref2,
	set_var_ref3,

	get_length,

	if_false8,
	if_true8,
	goto8,
	goto16,

	call0,
	call1,
	call2,
	call3,

	is_undefined,
	is_null,
	typeof_is_undefined,
	typeof_is_function,
}

// OP_COUNT: the number of real opcodes (one past typeof_is_function). Every final-bytecode opcode value is < this
// and fits in a byte, matching QuickJS's OP_COUNT.
OP_COUNT :: int(max(Opcode)) + 1

// The temporary opcodes (quickjs-opcode.h def() macros). Emitted during phase 1 (scope resolution not yet done)
// and removed during phases 2-3. They never appear in serialized bytecode, so they need no byte-value contract;
// we give them a separate enum so the real Opcode space stays a faithful 0..OP_COUNT-1. The instruction stream
// during phases 1-2 is a sequence of Bc_Op (a union of Opcode and Temp_Op); resolve_labels lowers every Temp_Op
// to real opcodes or deletes it.
Temp_Op :: enum u16 {
	enter_scope,
	leave_scope,
	label,
	scope_get_var_undef,
	scope_get_var,
	scope_put_var,
	scope_delete_var,
	scope_make_ref,
	scope_get_ref,
	scope_put_var_init,
	scope_get_private_field,
	scope_get_private_field2,
	scope_put_private_field,
	scope_in_private_field,
	get_field_opt_chain,
	get_array_el_opt_chain,
	set_class_name,
	dispose_scope,
	source_loc,
}

// Operand encoding of an opcode, mirroring the FMT() list in quickjs-opcode.h. The format, together with the
// fixed instruction size, tells the writer how many bytes an instruction occupies and where an atom operand sits
// (JS_WriteFunctionBytecode rewrites the 32-bit atom field in place for the atom formats).
Op_Fmt :: enum u8 {
	none,
	none_int,
	none_loc,
	none_arg,
	none_var_ref,
	u8,
	i8,
	loc8,
	const8,
	label8,
	u16,
	i16,
	label16,
	npop,
	npopx,
	npop_u16,
	loc,
	arg,
	var_ref,
	u32,
	u32x2,
	i32,
	const,
	label,
	atom,
	atom_u8,
	atom_u16,
	atom_label_u8,
	atom_label_u16,
	label_u16,
}

// Per-opcode static metadata: byte size (including the opcode byte), number of stack slots popped and pushed,
// and operand format. Indexed by the opcode's integer value. The values come straight from the DEF()/def() rows
// of quickjs-opcode.h. n_pop for the npop/npopx/npop_u16 formats is the fixed part only (call arguments are not
// counted), exactly as in QuickJS.
Op_Info :: struct {
	size:   u8,
	n_pop:  u8,
	n_push: u8,
	fmt:    Op_Fmt,
}

op_info := [Opcode]Op_Info {
	.invalid                 = {1, 0, 0, .none},

	.push_i32                = {5, 0, 1, .i32},
	.push_const              = {5, 0, 1, .const},
