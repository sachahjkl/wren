// Resources of wren.exe (release builds).
//   id 1, ICON       the exe icon (Explorer) and the window/taskbar icon (platform.open_window loads id 1).
//                    Generated by tools\make_logo.ps1.
//   id 1, VERSIONINFO the publisher, product and version Explorer (Properties > Details), Windows, and the security
//                    software read. The numbers come from APP_VERSION through build\wren_version.h
//                    (tools\make_version_h.ps1, run by build.bat).
//   id 1, RT_MANIFEST runs as the invoking user and declares Windows 10 and 11 (wren.manifest).
#include "../../build/wren_version.h"

1 ICON "..\\..\\assets\\wren.ico"
1 24 "wren.manifest"

1 VERSIONINFO
FILEVERSION WREN_VER_MAJOR, WREN_VER_MINOR, WREN_VER_PATCH, 0
PRODUCTVERSION WREN_VER_MAJOR, WREN_VER_MINOR, WREN_VER_PATCH, 0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "Froment Software"
            VALUE "FileDescription", "Wren web browser"
            VALUE "FileVersion", WREN_VER_STRING
            VALUE "InternalName", "wren"
            VALUE "LegalCopyright", "Copyright (c) 2026 Froment Software. MIT License."
            VALUE "OriginalFilename", "wren.exe"
            VALUE "ProductName", "Wren"
            VALUE "ProductVersion", WREN_VER_STRING
            VALUE "Comments", "https://github.com/sachahjkl/wren"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
