// Resources of the development builds (every build but build.bat release): the blueprint icon, so a dev build is
// told from a release one in Explorer, the taskbar and the window's title bar (generated by tools\make_logo.ps1 -Variant
// dev), the same manifest as the release build, and a version resource that says "development build".
#include "../../build/wren_version.h"

1 ICON "..\\..\\assets\\dev\\wren_dev.ico"
1 24 "wren.manifest"

1 VERSIONINFO
FILEVERSION WREN_VER_MAJOR, WREN_VER_MINOR, WREN_VER_PATCH, 0
PRODUCTVERSION WREN_VER_MAJOR, WREN_VER_MINOR, WREN_VER_PATCH, 0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x2L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "Froment Software"
            VALUE "FileDescription", "Wren (development build)"
            VALUE "FileVersion", WREN_VER_STRING
            VALUE "InternalName", "wren"
            VALUE "LegalCopyright", "Copyright (c) 2026 Sacha Froment (Froment Software). MIT License."
            VALUE "OriginalFilename", "wren.exe"
            VALUE "ProductName", "Wren"
            VALUE "ProductVersion", WREN_VER_PRODUCT
            VALUE "Comments", "https://github.com/sachahjkl/wren"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
