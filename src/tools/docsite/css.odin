package docsite

// The documentation stylesheet, layered over site/style.css. It adds the three-column doc layout (sidebar, article,
// table of contents), the prose styles for rendered Markdown, syntax-highlighting colours (sharing .k/.s/.c/.f/.t
// with the main site), the client search panel, a light theme under prefers-color-scheme: light, a responsive
// collapse of the sidebar on narrow screens, visible focus rings, and a clean print layout. No remote fonts, no
// color-mix or :has (Wren itself must render this).
docs_css :: proc() -> string {
	return `/* Generated by src/tools/docsite. Layers over style.css. */

:root {
  --doc-side: 272px;
  --doc-toc: 220px;
  --doc-max: 820px;
}

/* A readable light theme for people who ask the OS for one; the site's default stays dark. */
@media (prefers-color-scheme: light) {
  :root {
    color-scheme: light;
    --edge: #eceef1;
    --bg: #ffffff;
    --surface: #f6f7f9;
    --surface-2: #eceef1;
    --line: rgba(0, 0, 0, 0.10);
    --line-2: rgba(0, 0, 0, 0.18);
    --text: #15181c;
    --muted: #55606b;
    --soft: #7b858f;
    --accent: #0a6ebd;
    --accent-ink: #ffffff;
    --accent-dim: #dcecf8;
  }
  .top { background: rgba(255, 255, 255, 0.86); }
  .code, .doc-article pre { background: #f3f4f6; }
}

body.docs { overflow-x: hidden; }

.doc-shell {
  display: grid;
  grid-template-columns: var(--doc-side) minmax(0, 1fr);
  gap: 0;
  max-width: 1500px;
  margin: 0 auto;
  align-items: start;
}

/* sidebar */
.doc-side {
  position: sticky;
  top: 54px;
  align-self: start;
  height: calc(100vh - 54px);
  overflow-y: auto;
  border-right: 1px solid var(--line);
  padding: 22px 18px 60px;
  background: var(--bg);
}
.doc-tree { font-size: 14px; }
.doc-search { margin: 0 0 18px; position: relative; }
.doc-search input {
  width: 100%;
  padding: 9px 12px;
  border: 1px solid var(--line-2);
  border-radius: 8px;
  background: var(--surface);
  color: var(--text);
  font: inherit;
  font-size: 14px;
}
.doc-search input:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
.doc-search-results {
  position: absolute;
  left: 0; right: 0;
  z-index: 20;
  margin-top: 6px;
  max-height: 60vh;
  overflow-y: auto;
  background: var(--surface);
  border: 1px solid var(--line-2);
  border-radius: 10px;
  box-shadow: 0 16px 40px rgba(0, 0, 0, 0.4);
}
.doc-search-results ul { margin: 0; padding: 6px; list-style: none; }
.doc-search-results a { display: block; padding: 9px 10px; border-radius: 7px; color: var(--text); }
.doc-search-results a:hover { background: var(--surface-2); text-decoration: none; }
.doc-search-results .r-sec { display: block; color: var(--accent); font-size: 11px; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; }
.doc-search-results strong { display: block; font-weight: 650; }
.doc-search-results .r-snip { display: block; color: var(--muted); font-size: 12.5px; line-height: 1.4; margin-top: 2px; }
.doc-search-none { margin: 0; padding: 12px; color: var(--muted); font-size: 13px; }

.doc-sec { margin-bottom: 20px; }
.doc-sec-title { margin: 0 0 6px; color: var(--soft); font-size: 11px; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; }
.doc-links { margin: 0; padding: 0; list-style: none; }
.doc-links li { margin: 0; }
.doc-links a { display: block; padding: 5px 10px; border-radius: 6px; color: var(--muted); font-weight: 500; }
.doc-links a:hover { color: var(--text); background: var(--surface); text-decoration: none; }
.doc-links a.active { color: var(--accent); background: var(--accent-dim); font-weight: 650; }
.doc-group details > summary { cursor: pointer; padding: 5px 10px; border-radius: 6px; color: var(--text); font-weight: 600; list-style: none; }
.doc-group details > summary::-webkit-details-marker { display: none; }
.doc-group details > summary::before { content: "▸"; display: inline-block; width: 1em; color: var(--soft); }
.doc-group details[open] > summary::before { content: "▾"; }
.doc-group .doc-links { margin-left: 12px; border-left: 1px solid var(--line); padding-left: 4px; }

/* the mobile sidebar toggle, no script */
.doc-nav-toggle { position: absolute; width: 1px; height: 1px; opacity: 0; pointer-events: none; }
.doc-nav-open { display: none; }

/* main column */
.doc-main {
  display: grid;
  grid-template-columns: minmax(0, 1fr) var(--doc-toc);
  gap: 40px;
  padding: 34px 40px 80px;
  align-items: start;
}
.doc-article { min-width: 0; max-width: var(--doc-max); }
.doc-article h1 { font-size: 40px; margin-bottom: 0.4em; }
.doc-article h2 { font-size: 27px; margin-top: 1.6em; padding-top: 0.3em; border-top: 1px solid var(--line); }
.doc-article h3 { font-size: 20px; margin-top: 1.4em; }
.doc-article h4 { font-size: 16px; margin-top: 1.2em; color: var(--text); }
.doc-article p, .doc-article li { font-size: 16px; line-height: 1.62; color: var(--text); }
.doc-article li { margin-bottom: 4px; }
.doc-article ul, .doc-article ol { padding-left: 24px; }
.doc-article a { color: var(--accent); font-weight: 500; }
.doc-article blockquote {
  margin: 1em 0;
  padding: 2px 18px;
  border-left: 3px solid var(--accent);
  background: var(--surface);
  border-radius: 0 8px 8px 0;
  color: var(--muted);
}
.doc-article img { border-radius: 8px; border: 1px solid var(--line); margin: 1em 0; }
.doc-article table { margin: 1em 0; }
.doc-article .table-box { margin: 1em 0; }

/* heading anchors appear on hover */
.doc-article h1 .anchor, .doc-article h2 .anchor, .doc-article h3 .anchor,
.doc-article h4 .anchor, .doc-article h5 .anchor, .doc-article h6 .anchor {
  float: left;
  margin-left: -0.9em;
  padding-right: 0.25em;
  color: var(--soft);
  opacity: 0;
  font-weight: 400;
  text-decoration: none;
}
.doc-article h1:hover .anchor, .doc-article h2:hover .anchor, .doc-article h3:hover .anchor,
.doc-article h4:hover .anchor { opacity: 1; }
.anchor:focus-visible { opacity: 1; outline: 2px solid var(--accent); }

/* code blocks reuse the site's .code shell and token classes (.k .s .c .f .t) from style.css */
.doc-article .code { margin: 1.2em 0; }
.doc-article pre { margin: 0; padding: 14px 16px; white-space: pre-wrap; overflow-wrap: anywhere; line-height: 1.55; font-size: 13.5px; tab-size: 4; }
.doc-article :not(pre) > code { white-space: pre-wrap; overflow-wrap: anywhere; }

/* breadcrumb */
.doc-crumbs { margin-bottom: 18px; }
.doc-crumbs ol { display: flex; flex-wrap: wrap; gap: 6px; margin: 0; padding: 0; list-style: none; font-size: 12.5px; color: var(--soft); }
.doc-crumbs li + li::before { content: "/"; margin-right: 6px; color: var(--line-2); }
.doc-crumbs a { color: var(--muted); font-weight: 600; }

/* previous / next */
.doc-seq { display: flex; gap: 14px; margin-top: 48px; padding-top: 22px; border-top: 1px solid var(--line); }
.doc-seq a { flex: 1; padding: 14px 16px; border: 1px solid var(--line); border-radius: 10px; background: var(--surface); color: var(--text); }
.doc-seq a:hover { border-color: var(--accent); text-decoration: none; }
.doc-seq a span { display: block; color: var(--soft); font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; }
.doc-seq .doc-next { text-align: right; }
.doc-seq strong { color: var(--text); font-weight: 650; }

.doc-edit { margin-top: 26px; font-size: 13.5px; color: var(--soft); }

/* table of contents */
.doc-toc { position: sticky; top: 70px; align-self: start; font-size: 13px; }
.doc-toc-title { margin: 0 0 8px; color: var(--soft); font-size: 11px; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; }
.doc-toc ul { margin: 0; padding: 0; list-style: none; border-left: 1px solid var(--line); }
.doc-toc li { margin: 0; }
.doc-toc a { display: block; padding: 4px 12px; color: var(--muted); }
.doc-toc a:hover { color: var(--text); text-decoration: none; }
.doc-toc .lvl3 a { padding-left: 24px; font-size: 12.5px; }

/* the WPT chart on the conformance page */
.doc-chart { margin: 1.4em 0; }
.doc-chart svg { width: 100%; height: auto; border: 1px solid var(--line); border-radius: 10px; background: #0b0b10; }
.doc-chart figcaption { margin-top: 8px; color: var(--soft); font-size: 13px; }

@media (max-width: 1180px) {
  .doc-main { grid-template-columns: minmax(0, 1fr); }
  .doc-toc { display: none; }
}

@media (max-width: 860px) {
  .doc-shell { grid-template-columns: minmax(0, 1fr); }
  .doc-nav-open {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 14px 20px 0;
    padding: 10px 14px;
    border: 1px solid var(--line-2);
    border-radius: 8px;
    background: var(--surface);
    color: var(--text);
    font-weight: 650;
    cursor: pointer;
  }
  /* the three bars, stacked in a small fixed-height column */
  .doc-nav-open { position: relative; padding-left: 40px; }
  .doc-nav-open span {
    position: absolute;
    left: 14px;
    width: 18px;
    height: 2px;
    border-radius: 2px;
    background: var(--text);
  }
  .doc-nav-open span:nth-child(1) { top: calc(50% - 6px); }
  .doc-nav-open span:nth-child(2) { top: calc(50% - 1px); }
  .doc-nav-open span:nth-child(3) { top: calc(50% + 4px); }
  .doc-side { display: none; position: static; height: auto; border-right: 0; border-bottom: 1px solid var(--line); }
  .doc-nav-toggle:checked ~ .doc-side { display: block; }
  .doc-nav-toggle:focus-visible ~ .doc-nav-open { outline: 2px solid var(--accent); outline-offset: 3px; }
  .doc-main { padding: 20px; }
  .doc-article h1 { font-size: 32px; }
}

/* a clean print: no chrome, no sidebar, black on white */
@media print {
  .top, .site-foot, .doc-side, .doc-toc, .doc-seq, .doc-nav-open, .doc-edit, .skip, .anchor { display: none !important; }
  .doc-shell, .doc-main { display: block; max-width: none; padding: 0; }
  .doc-article { max-width: none; color: #000; }
  .doc-article a { color: #000; text-decoration: underline; }
  .doc-article pre, .code { background: #f4f4f4 !important; border: 1px solid #ccc; }
  body { background: #fff; color: #000; }
}
`
}
