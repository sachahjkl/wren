// docsite: turns the Markdown under docs/ into the static documentation site under site/docs/, and the site's classic
// presentation under site/classic/ (classic.odin). The pages, their menu, search, style sheet and link check are the toolkit's
// (ext/gui_toolkit/src/site, docs/site.md there); this tool gives them Wren's names, header, footer, colours and directives.
//   docsite            writes what changed (wrentool docs runs it), then checks every link, file and anchor of site/
//   docsite -check     writes nothing, fails if a generated file is missing or stale or a link is dead (CI, like wrentool changelog -Check)
//   docsite -chart f.svg   writes only the WPT conformance chart (ports make_chart.js); used on its own to refresh it
// Run from the repository root. The generation is deterministic: the same docs, _nav.txt and git history produce the
// same bytes, so CI can verify site/docs is up to date.
package docsite

import "core:fmt"
import "core:os"
import "core:path/filepath"
import "core:strings"
import "wb:base"
import tk_site "../../../ext/gui_toolkit/src/site"

DOCS_DIR  :: "docs"
OUT_DIR   :: "site/docs"
SITE_DIR  :: "site"
REPO_URL  :: "https://github.com/sachahjkl/wren"
REPO_BRANCH :: "master"
SITE_URL  :: "https://wren.froment.software/"   // where site/ is published (GitHub Pages, on the domain wren.froment.software)
GENERATED_NOTE :: "<!-- Generated by src/tools/docsite from docs/. DO NOT EDIT; edit the .md and run wrentool docs. -->"

// The documentation site being made, and its writer (docs.writer: what changed, what is out of date with -check).
docs: tk_site.Docs
// The classic pages written, from site/classic/: the others there that docsite made are removed.
classic_keep: map[string]bool

main :: proc() {
	args := os.args[1:]
	if len(args) >= 1 && args[0] == "-chart" {
		out := len(args) >= 2 ? args[1] : "site/docs/wpt-chart.svg"
		svg := build_wpt_chart(".")
		if err := os.write_entire_file(out, transmute([]u8)svg); err != nil {
			fmt.eprintfln("docsite: cannot write %s: %v", out, err)
			os.exit(1)
		}
		fmt.printfln("docsite: wrote %s", out)
		return
	}
	check_only := false
	for a in args {
		switch a {
		case "-check": check_only = true
		case "-chart-update": chart_update = true
		case:
			fmt.eprintfln("docsite: unknown argument %s (usage: docsite [-check] [-chart-update] | docsite -chart out.svg)", a)
			os.exit(2)
		}
	}

	docs = wren_docs(check_only)
	classic_keep = make(map[string]bool)
	if !tk_site.build_docs(&docs) { os.exit(1) }
	// the classic docs search with the modern docs' index
	emit(filepath.join({CLASSIC_DIR, "docs/search.js"}) or_else "", tk_site.search_js(CLASSIC_SEARCH_INDEX))
	// the releases timeline of the site's changelog page, then the classic pages made of the site's pages
	releases := read_releases()
	build_changelog_page(releases)
	build_classic_site(releases, &classic_keep)
	tk_site.prune_generated(&docs.writer, CLASSIC_DIR, classic_keep)

	if docs.writer.problems > 0 {
		if check_only { fmt.eprintfln("docsite: %d generated file(s) out of date: run docsite (wrentool docs)", docs.writer.problems) }
		os.exit(1)
	}
	if !check_only { fmt.printfln("docsite: %d file(s) written, site/docs is up to date", docs.writer.written) }
	dead, pages := tk_site.check_links(SITE_DIR, {not_files = {"wren-"}, folders = true})
	if len(dead) > 0 {
		fmt.printfln("docsite: %d dead link(s)/anchor(s) in site/:", len(dead))
		for d in dead { fmt.printfln("  %s", d) }
		os.exit(1)
	}
	fmt.printfln("docsite: %d pages of site/, every link, file and anchor resolves", pages)
}

// Wren's documentation site. wren-https:, wren-http: and wren-about: are the schemes that open a link in Wren
// (docs/desktop-integration.md): not files of the site.
wren_docs :: proc(check_only: bool) -> tk_site.Docs {
	header := strings.builder_make()
	write_header(&header, "Docs")
	return {
		source     = DOCS_DIR,
		out        = OUT_DIR,
		name       = "Wren",
		site_url   = SITE_URL,
		repository = REPO_URL,
		branch     = REPO_BRANCH,
		note       = GENERATED_NOTE,
		// icons and CSS live at the site root
		head       = "<link rel=\"icon\" type=\"image/png\" sizes=\"32x32\" href=\"/img/logo-32.png\">\n<link rel=\"stylesheet\" href=\"/style.css\">\n<link rel=\"stylesheet\" href=\"/docs/docs.css\">\n",
		header     = strings.to_string(header),
		footer     = proc(d: ^tk_site.Docs, p: ^tk_site.Doc_Page) -> string {
			b := strings.builder_make()
			write_footer(&b, strings.concatenate({"/classic", tk_site.docs_page_url(p.out_rel)}, context.temp_allocator))
			return strings.to_string(b)
		},
		expand     = proc(d: ^tk_site.Docs, p: ^tk_site.Doc_Page, source: string) -> string { return apply_directives(source) },
		rendered   = proc(d: ^tk_site.Docs, p: ^tk_site.Doc_Page, body: ^tk_site.Markdown) {
			page := strings.concatenate({"docs/", p.out_rel})
			emit(filepath.join({CLASSIC_DIR, page}) or_else "", tk_site.site_relative(classic_doc_page(p, body), page))
			classic_keep[page] = true
		},
		languages  = LANGUAGES[:],
		css        = {note = "/* Generated by src/tools/docsite. Layers over style.css. */", bar = 54, theme = DOCS_THEME, extra = DOCS_CHART_CSS},
		moved      = true,
		writer     = {tool = "docsite", check = check_only},
	}
}

emit :: proc(path, text: string) { tk_site.write_generated(&docs.writer, path, text) }

// WIDL, the API description language (api/*.widl).
@(rodata)
LANGUAGES := [?]tk_site.Code_Language{
	{
		names = {"widl"}, label = "WIDL", highlight = true, line_comment = "//", block_open = "/*", block_close = "*/", sigil = '@',
		keywords = {"module", "interface", "handle", "enum", "flags", "struct", "callback", "typedef", "raises", "optional", "out", "in", "static", "Window", "Worker", "exposed"},
		types = {"i32", "u32", "i64", "u64", "f32", "f64", "bool", "string", "usvstring", "bytes", "void"},
	},
}

// A readable light theme for people who ask the OS for one; the site's default stays dark.
DOCS_THEME :: `/* A readable light theme for people who ask the OS for one; the site's default stays dark. */
@media (prefers-color-scheme: light) {
  :root {
    color-scheme: light;
    --edge: #eceef1;
    --bg: #ffffff;
    --surface: #f6f7f9;
    --surface-2: #eceef1;
    --line: rgba(0, 0, 0, 0.10);
    --line-2: rgba(0, 0, 0, 0.18);
    --text: #15181c;
    --muted: #55606b;
    --soft: #7b858f;
    --accent: #0a6ebd;
    --accent-ink: #ffffff;
    --accent-dim: #dcecf8;
  }
  .top { background: rgba(255, 255, 255, 0.86); }
  .code, .doc-article pre { background: #f3f4f6; }
}
`

// The WPT chart on the conformance page.
DOCS_CHART_CSS :: `/* the WPT chart on the conformance page */
.doc-chart { margin: 1.4em 0; }
.doc-chart svg { width: 100%; height: auto; border: 1px solid var(--line); border-radius: 10px; background: #0b0b10; }
.doc-chart figcaption { margin-top: 8px; color: var(--soft); font-size: 13px; }
`

// The conformance page uses two directives that only docsite can fill (git history, the expectations files).
apply_directives :: proc(source: string) -> string {
	if !strings.contains(source, "<!-- docsite:") { return source }
	out := source
	if strings.contains(out, "<!-- docsite:chart -->") {
		chart := build_wpt_chart(".")
		block := strings.concatenate({"<figure class=\"doc-chart\">\n", chart, "\n<figcaption>Passing WPT subtests of Wren over time, rebuilt from the git history.</figcaption>\n</figure>"}, context.allocator)
		out, _ = strings.replace_all(out, "<!-- docsite:chart -->", block, context.allocator)
	}
	if strings.contains(out, "<!-- docsite:wpt-table -->") {
		out, _ = strings.replace_all(out, "<!-- docsite:wpt-table -->", build_wpt_table(".", "build/wpt/report.md"), context.allocator)
	}
	return out
}

// The site's top bar, with "Docs" marked current here. Kept in step with site/*.html by hand (the brief owns those).
write_header :: proc(b: ^strings.Builder, current: string) {
	ws := strings.write_string
	ws(b, "<header class=\"top\">\n<div class=\"wrap\">\n")
	ws(b, "<a class=\"brand\" href=\"/\"><img src=\"/img/logo-64.png\" alt=\"\" width=\"30\" height=\"30\">Wren</a>\n")
	ws(b, "<input class=\"menu-check\" type=\"checkbox\" id=\"menu\">\n")
	ws(b, "<label class=\"burger\" for=\"menu\" aria-label=\"Menu\"><span></span><span></span><span></span></label>\n")
	ws(b, "<ul class=\"nav\">\n")
	items := [?][2]string{
		{"/#features", "Features"},
		{"/gallery/", "Gallery"},
		{"/architecture/", "Architecture"},
		{"/docs/", "Docs"},
		{"/write/", "Write a page"},
		{"/changelog/", "Changelog"},
	}
	for it in items {
		ws(b, "<li><a href=\"")
		ws(b, it[0])
		ws(b, "\"")
		if it[1] == current { ws(b, " aria-current=\"page\"") }
		ws(b, ">")
		base.write_escaped(b, it[1])
		ws(b, "</a></li>\n")
	}
	// (the licence, as a button: the home page has the download's)
	ws(b, "<li><a class=\"btn primary nav-buy\" href=\"/pricing/\"")
	if current == "Pricing" { ws(b, " aria-current=\"page\"") }
	ws(b, ">Buy license</a></li>\n")
	ws(b, "</ul>\n</div>\n</header>\n")
}

// `classic` is the address of the page's classic presentation.
write_footer :: proc(b: ^strings.Builder, classic: string) {
	ws := strings.write_string
	ws(b, "<footer class=\"site-foot\">\n<div class=\"wrap\">\n")
	ws(b, "<p class=\"foot-line\">Wren · a browser where WebAssembly runs everything · by ")
	ws(b, "<span class=\"maker\"><img src=\"/img/froment-software-64.png\" alt=\"\" width=\"16\" height=\"16\"><a href=\"https://froment.software\">Froment Software</a></span></p>\n")
	ws(b, "<nav class=\"foot-links\">\n")
	ws(b, "<a href=\"/docs/\">Docs</a>\n")
	ws(b, "<a href=\"/changelog/\">Changelog</a>\n")
	ws(b, "<a href=\"/pricing/\">Pricing</a>\n")
	ws(b, "<a href=\"/privacy/\">Privacy</a>\n")
	ws(b, "<a href=\"/terms/\">Terms</a>\n")
	ws(b, "<a href=\"")
	ws(b, REPO_URL)
	ws(b, "\">GitHub</a>\n")
	ws(b, "<a href=\"")
	ws(b, classic)
	ws(b, "\">Classic version</a>\n")
	ws(b, "</nav>\n</div>\n</footer>\n")
}
