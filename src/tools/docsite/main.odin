// docsite: turns the Markdown under docs/ into the static documentation site under site/docs/.
//   docsite            writes what changed (tools\docs_site.ps1 runs it, then checks the links)
//   docsite -check     writes nothing, fails if a generated file is missing or stale (CI, like changelog.ps1 -Check)
//   docsite -chart f.svg   writes only the WPT conformance chart (ports make_chart.js); used on its own to refresh it
// Run from the repository root. The generation is deterministic: the same docs, _nav.txt and git history produce the
// same bytes, so CI can verify site/docs is up to date.
package docsite

import "core:fmt"
import "core:os"
import "core:path/filepath"
import "core:strings"

DOCS_DIR  :: "docs"
OUT_DIR   :: "site/docs"
NAV_FILE  :: "docs/_nav.txt"
REPO_URL  :: "https://github.com/sachahjkl/wren"
REPO_BRANCH :: "master"
GENERATED_NOTE :: "<!-- Generated by src/tools/docsite from docs/. DO NOT EDIT; edit the .md and run tools\\docs_site.ps1. -->"

check_only: bool
problems:   int
written:    int

// A page ready to render: its source, parsed nav place, title and output path.
Page :: struct {
	rel:      string,   // "cdp.md"
	out_rel:  string,   // "cdp.html"
	src_path: string,   // "docs/cdp.md"
	title:    string,   // first H1, or the nav title
	section:  string,   // the top-level section it belongs to
}

main :: proc() {
	args := os.args[1:]
	if len(args) >= 1 && args[0] == "-chart" {
		out := len(args) >= 2 ? args[1] : "site/docs/wpt-chart.svg"
		svg := build_wpt_chart(".")
		if err := os.write_entire_file(out, transmute([]u8)svg); err != nil {
			fmt.eprintfln("docsite: cannot write %s: %v", out, err)
			os.exit(1)
		}
		fmt.printfln("docsite: wrote %s", out)
		return
	}
	for a in args {
		switch a {
		case "-check": check_only = true
		case "-chart-update": chart_update = true
		case:
			fmt.eprintfln("docsite: unknown argument %s (usage: docsite [-check] [-chart-update] | docsite -chart out.svg)", a)
			os.exit(2)
		}
	}

	run()

	if problems > 0 {
		if check_only { fmt.eprintfln("docsite: %d generated file(s) out of date: run docsite (tools\\docs_site.ps1)", problems) }
		os.exit(1)
	}
	if !check_only { fmt.printfln("docsite: %d file(s) written, site/docs is up to date", written) }
}

run :: proc() {
	nav_bytes, nav_err := os.read_entire_file(NAV_FILE, context.allocator)
	if nav_err != nil { fmt.eprintfln("docsite: cannot read %s", NAV_FILE); os.exit(1) }

	docs := read_docs_tree(DOCS_DIR)
	nav := build_nav(string(nav_bytes), docs)

	// one Page per doc, titled by its first H1 (fallback: the nav title, then the file name)
	pages := make([dynamic]Page)
	page_by_rel := make(map[string]^Page)
	for rel in docs {
		p := Page{rel = rel, out_rel = out_rel_of(rel), src_path = filepath.join({DOCS_DIR, rel}) or_else ""}
		p.section = section_of(nav, rel)
		append(&pages, p)
	}
	for &p in pages { page_by_rel[p.rel] = &p }

	// first pass: read the H1 of each page for the titles used in the sidebar, prev/next and search
	for &p in pages {
		data, derr := os.read_entire_file(p.src_path, context.allocator)
		if derr != nil { continue }
		p.title = first_h1(string(data))
		if p.title == "" {
			if item, has := nav.by_rel[p.rel]; has && item.title != "" { p.title = item.title }
			else { p.title = title_from_rel(p.rel) }
		}
		// the sidebar label falls back to the page title when the nav line gave none
		if item, has := nav.by_rel[p.rel]; has && item.title == "" { item.title = p.title }
	}

	// search index entries, collected as pages render
	search := make([dynamic]Search_Doc)

	// render every page
	for &p in pages {
		html := render_page(&p, nav, pages[:], page_by_rel, &search)
		emit(filepath.join({OUT_DIR, p.out_rel}) or_else "", html)
	}

	// shared assets
	emit(filepath.join({OUT_DIR, "docs.css"}) or_else "", docs_css())
	emit(filepath.join({OUT_DIR, "search.js"}) or_else "", search_js())
	emit(filepath.join({OUT_DIR, "search-index.json"}) or_else "", build_search_index(search[:]))

	// prune generated .html the docs no longer produce
	keep := make(map[string]bool, context.temp_allocator)
	for p in pages { keep[p.out_rel] = true }
	prune_html(OUT_DIR, keep)
}

// docs/releases/v0.5.0.md -> releases/v0.5.0.html ; docs/api/README.md -> api/README.html
out_rel_of :: proc(rel: string) -> string {
	base := rel[:len(rel) - len(".md")]
	return strings.concatenate({base, ".html"}, context.allocator)
}

section_of :: proc(nav: ^Nav, rel: string) -> string {
	for sec in nav.roots {
		if contains_rel(sec, rel) { return sec.title }
	}
	return ""
}

contains_rel :: proc(item: ^Nav_Item, rel: string) -> bool {
	if item.rel == rel { return true }
	for c in item.children { if contains_rel(c, rel) { return true } }
	return false
}

first_h1 :: proc(source: string) -> string {
	for line in strings.split_lines(source, context.temp_allocator) {
		t := strings.trim_space(line)
		if strings.has_prefix(t, "# ") {
			return strip_md(strings.trim_space(t[2:]))
		}
		// a release note leads with a bold line, no '#': use its first sentence
		if strings.has_prefix(t, "**") {
			break
		}
	}
	return ""
}

// Strip the inline markers (`, *, _) from a heading so it reads as plain text in titles, breadcrumbs and prev/next.
strip_md :: proc(s: string) -> string {
	b := strings.builder_make(context.allocator)
	for i in 0 ..< len(s) {
		switch s[i] {
		case '`', '*', '_':
		case: strings.write_byte(&b, s[i])
		}
	}
	return strings.to_string(b)
}

title_from_rel :: proc(rel: string) -> string {
	base := filepath.base(rel)
	base = base[:len(base) - len(".md")]
	base, _ = strings.replace_all(base, "-", " ", context.allocator)
	if len(base) == 0 { return rel }
	return strings.concatenate({strings.to_upper(base[:1], context.allocator), base[1:]}, context.allocator)
}

// --- writing (same discipline as bindgen's emit) ----------------------------

emit :: proc(path, text: string) {
	old, err := os.read_entire_file(path, context.allocator)
	if err == nil && string(old) == text { return }
	if check_only {
		fmt.eprintfln("docsite: %s is %s", path, err == nil ? "out of date" : "missing")
		problems += 1
		return
	}
	_ = os.make_directory_all(filepath.dir(path))
	if werr := os.write_entire_file(path, transmute([]u8)text); werr != nil {
		fmt.eprintfln("docsite: cannot write %s: %v", path, werr)
		problems += 1
		return
	}
	written += 1
}

prune_html :: proc(dir: string, keep: map[string]bool) {
	walk :: proc(dir, prefix: string, keep: map[string]bool) {
		infos, err := os.read_all_directory_by_path(dir, context.allocator)
		if err != nil { return }
		for fi in infos {
			if fi.type == .Directory { walk(fi.fullpath, prefix, keep); continue }
			if !strings.has_suffix(fi.name, ".html") { continue }
			full, _ := strings.replace_all(fi.fullpath, "\\", "/", context.allocator)
			rel := strings.trim_prefix(strings.trim_prefix(full, prefix), "/")
			if rel in keep { continue }
			data, derr := os.read_entire_file(fi.fullpath, context.allocator)
			if derr != nil || !strings.contains(string(data[:min(len(data), 300)]), "docsite") { continue }
			if check_only {
				fmt.eprintfln("docsite: %s is generated but no doc produces it any more", fi.fullpath)
				problems += 1
				continue
			}
			_ = os.remove(fi.fullpath)
			written += 1
		}
	}
	walk(dir, abs_forward(dir), keep)
}
