// The classic presentation of the site, under site/classic/: every page again, plain (a line of links, a column of
// text, blue links that turn purple, thin rules; site/classic/classic.css). One source, two presentations:
//   - a doc is rendered from its Markdown a second time, in the classic frame (render_page);
//   - a hand-written page of the site gives its <main> (or some of its sections) and its scripts, its links moved
//     into the classic tree;
//   - the classic home (hand-written, site/classic/index.html) gets its top, its footer, the latest version and the
//     news of the last releases between markers.
// Every classic page links the same page of the modern site ("Modern version"), and the modern pages link back.
// In a classic page a root-absolute path names the classic tree ("/pricing/"); SITE_ROOT climbs to the site's own
// root, for the images and the modern pages ("/../img/logo-64.png").
package docsite

import "core:os"
import "core:path/filepath"
import "core:strings"
import "wb:base"

CLASSIC_DIR          :: "site/classic"
CLASSIC_HOME         :: "site/classic/index.html"
CLASSIC_NOTE         :: "<!-- Generated by src/tools/docsite from the modern page (site/) or the .md (docs/). DO NOT EDIT; edit those and run wrentool docs. -->"
CLASSIC_SEARCH_INDEX :: "../../docs/search-index.json"   // the modern docs' index, from site/classic/docs/search.js
SITE_ROOT            :: "/../"
NEWS_COUNT           :: 3                                // releases in the classic home's news column
TAGLINE              :: "a web browser where WebAssembly runs everything, JavaScript included"

// A hand-written page of the site, in the classic frame.
Classic_Page :: struct {
	folder:   string,   // its folder, the same under site/ and site/classic/ ("pricing/")
	nav:      string,   // the entry of the nav line it is ("" : none)
	from:     string,   // the modern page it is made of, when not its folder's ("index.html")
	sections: string,   // the ids of the sections of `from` it takes, in order ("" : its whole <main>)
	title:    string,   // its <h1> and title when made of sections
	modern:   string,   // its modern address from the site's root, when not its folder ("#features")
}

classic_pages := [?]Classic_Page{
	{folder = "features/", nav = "features", from = "index.html", sections = "idea features gallery status write architecture pricing license", title = "Features", modern = "#features"},
	{folder = "gallery/", nav = "screenshots"},
	{folder = "architecture/", nav = "architecture"},
	{folder = "write/", nav = "write a page"},
	{folder = "changelog/", nav = "changelog"},
	{folder = "pricing/", nav = "pricing"},
	{folder = "archive/"},
	{folder = "privacy/"},
	{folder = "terms/"},
	{folder = "refunds/"},
	{folder = "imprint/", nav = "contact"},
	{folder = "thanks/"},
}

// The nav line: classic addresses, or the outside ones.
classic_nav := [?][2]string{
	{"/", "home"},
	{REPO_URL + "/releases/latest", "download"},
	{"/features/", "features"},
	{"/gallery/", "screenshots"},
	{"/architecture/", "architecture"},
	{"/docs/", "docs"},
	{"/write/", "write a page"},
	{"/changelog/", "changelog"},
	{"/pricing/", "pricing"},
	{REPO_URL, "source code"},
	{"/imprint/", "contact"},
}

// The hand-written pages and the home; `keep` gets each page written (its path under site/classic/).
build_classic_site :: proc(releases: []Release, keep: ^map[string]bool) {
	for cp in classic_pages {
		page := strings.concatenate({cp.folder, "index.html"}, context.allocator)
		if build_classic_page(cp, page) { keep[page] = true }
	}
	build_classic_home(releases)
	keep["index.html"] = true
}

build_classic_page :: proc(cp: Classic_Page, page: string) -> bool {
	from := cp.from != "" ? cp.from : page
	data, err := os.read_entire_file(strings.concatenate({SITE_DIR, "/", from}, context.temp_allocator), context.allocator)
	if err != nil { return false }
	src := string(data)
	m0 := strings.index(src, "<main")
	m1 := strings.last_index(src, "</main>")
	if m1 < 0 { m1 = strings.last_index(src, "<footer") }   // a </main> left implied
	if m0 < 0 || m1 < m0 { return false }
	open_end := m0 + strings.index_byte(src[m0:], '>') + 1
	main_open, content := src[m0:open_end], src[open_end:m1]
	title := between(src, "<title>", "</title>")

	if cp.sections != "" {
		sb := strings.builder_make(context.allocator)
		strings.write_string(&sb, "\n<h1>")
		strings.write_string(&sb, cp.title)
		strings.write_string(&sb, "</h1>\n")
		for id in strings.fields(cp.sections, context.temp_allocator) { strings.write_string(&sb, section_by_id(src, id)); strings.write_string(&sb, "\n") }
		content = strings.to_string(sb)
		main_open = "<main id=\"main\">"
		title = strings.concatenate({cp.title, " - Wren"}, context.allocator)
	}

	dir := posix_dir(from)
	b := strings.builder_make(context.allocator)
	ws := strings.write_string
	write_classic_head(&b, title, between(src, "<meta name=\"description\" content=\"", "\""))
	write_classic_top(&b, cp.nav)
	ws(&b, main_open)
	ws(&b, classic_paths(rooted(content, dir)))
	ws(&b, "</main>\n")
	write_classic_foot(&b, strings.concatenate({SITE_ROOT, cp.modern != "" ? cp.modern : cp.folder}, context.temp_allocator))
	ws(&b, classic_paths(rooted(scripts_of(src[:m0]), dir)))
	ws(&b, classic_paths(rooted(scripts_of(src[m1:]), dir)))
	ws(&b, "</body>\n</html>\n")
	emit(filepath.join({CLASSIC_DIR, page}) or_else "", site_relative(strings.to_string(b), page))
	return true
}

// A doc in the classic frame: the sidebar beside it, its contents after its title.
classic_doc_page :: proc(p: ^Page, nav: ^Nav, by_rel: map[string]^Page, body: Rendered) -> string {
	ws := strings.write_string
	content := strings.builder_make(context.allocator)
	write_breadcrumb(&content, p)
	toc := strings.builder_make(context.temp_allocator)
	write_toc(&toc, body.headings[:])
	h1_end := strings.index(body.html, "</h1>")
	h1_end = h1_end < 0 ? 0 : h1_end + len("</h1>")
	ws(&content, body.html[:h1_end])
	ws(&content, strings.to_string(toc))
	ws(&content, body.html[h1_end:])
	write_prev_next(&content, nav, p, by_rel)
	write_edit_link(&content, p)
	side := strings.builder_make(context.allocator)
	write_sidebar(&side, nav, p.rel)

	title := strings.builder_make(context.temp_allocator)
	base.write_escaped(&title, p.title)
	ws(&title, " · Wren docs")
	desc := strings.builder_make(context.temp_allocator)
	base.write_escaped(&desc, meta_description(body.plain, p.title), {.Quote})

	b := strings.builder_make(context.allocator)
	write_classic_head(&b, strings.to_string(title), strings.to_string(desc))
	write_classic_top(&b, "docs")
	ws(&b, "<div class=\"doc-columns\">\n<main id=\"main\" class=\"doc-main\">\n")
	ws(&b, classic_paths(strings.to_string(content)))
	ws(&b, "</main>\n<aside class=\"doc-side\" aria-label=\"Documentation sections\">\n<nav class=\"doc-tree\" aria-label=\"Documentation\">\n")
	ws(&b, classic_paths(strings.to_string(side)))
	ws(&b, "</nav>\n</aside>\n</div>\n")
	write_classic_foot(&b, strings.concatenate({SITE_ROOT[:len(SITE_ROOT) - 1], url_of(p.out_rel)}, context.temp_allocator))
	ws(&b, "<script src=\"/docs/search.js\" defer></script>\n</body>\n</html>\n")
	return strings.to_string(b)
}

// The classic home: its text is hand-written, its top, footer, version and news are stamped between markers.
build_classic_home :: proc(releases: []Release) {
	data, err := os.read_entire_file(CLASSIC_HOME, context.allocator)
	if err != nil { return }
	page := string(data)
	top := strings.builder_make(context.temp_allocator)
	write_classic_top(&top, "home")
	foot := strings.builder_make(context.temp_allocator)
	write_classic_foot(&foot, SITE_ROOT)
	news := strings.builder_make(context.temp_allocator)
	write_news(&news, releases)
	page = stamp(page, "<!-- classic:top -->", "<!-- /classic:top -->", site_relative(strings.concatenate({"\n", strings.to_string(top)}), "index.html"))
	page = stamp(page, "<!-- classic:foot -->", "<!-- /classic:foot -->", site_relative(strings.concatenate({"\n", strings.to_string(foot)}), "index.html"))
	page = stamp(page, "<!-- news:begin -->", "<!-- news:end -->", site_relative(strings.to_string(news), "index.html"))
	if len(releases) > 0 { page = stamp(page, "<!-- latest -->", "<!-- /latest -->", releases[0].version) }
	emit(CLASSIC_HOME, page)
}

write_news :: proc(b: ^strings.Builder, releases: []Release) {
	ws := strings.write_string
	ws(b, "\n")
	for r in releases[:min(len(releases), NEWS_COUNT)] {
		id, _ := strings.replace_all(r.version, ".", "-", context.temp_allocator)
		ws(b, "      <div class=\"item\">\n        ")
		if r.date != "" {
			ws(b, "<time class=\"date\" datetime=\"")
			ws(b, r.date)
			ws(b, "\">")
			ws(b, r.date)
			ws(b, "</time>: ")
		}
		ws(b, "<a href=\"/changelog/#v")
		ws(b, id)
		ws(b, "\">Wren ")
		ws(b, r.version)
		ws(b, "</a> released.<br>\n        ")
		write_inline(b, r.lead)
		ws(b, "\n      </div>\n")
	}
	ws(b, "      <p><a class=\"all\" href=\"/changelog/\">- all news -</a></p>\n    ")
}

// `title` and `description` are HTML already.
write_classic_head :: proc(b: ^strings.Builder, title, description: string) {
	ws := strings.write_string
	ws(b, CLASSIC_NOTE)
	ws(b, "\n<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n")
	ws(b, "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<meta name=\"color-scheme\" content=\"light dark\">\n<title>")
	ws(b, title)
	ws(b, "</title>\n<meta name=\"description\" content=\"")
	ws(b, description)
	ws(b, "\">\n<link rel=\"icon\" type=\"image/png\" sizes=\"32x32\" href=\"/../img/logo-32.png\">\n")
	ws(b, "<link rel=\"stylesheet\" href=\"/classic.css\">\n</head>\n<body>\n")
}

// The skip link, the page's box, the masthead and the nav line, `current` marked.
write_classic_top :: proc(b: ^strings.Builder, current: string) {
	ws := strings.write_string
	ws(b, "<a class=\"skip\" href=\"#main\">Skip to content</a>\n<div class=\"page\">\n<header class=\"masthead\">\n")
	ws(b, "<img src=\"/../img/logo-64.png\" alt=\"\" width=\"48\" height=\"48\">\n<a class=\"name\" href=\"/\">Wren</a>\n<span class=\"tagline\">")
	ws(b, TAGLINE)
	ws(b, "</span>\n</header>\n<nav class=\"site\" aria-label=\"Site\">\n")
	for it, i in classic_nav {
		if i > 0 { ws(b, "<span class=\"sep\" aria-hidden=\"true\">-</span>") }
		ws(b, "<a href=\"")
		ws(b, it[0])
		ws(b, "\"")
		if it[1] == current { ws(b, " aria-current=\"page\"") }
		ws(b, ">")
		ws(b, it[1])
		ws(b, "</a>\n")
	}
	ws(b, "</nav>\n")
}

// The footer, with `modern` the same page in the modern site, and the end of the page's box.
write_classic_foot :: proc(b: ^strings.Builder, modern: string) {
	ws := strings.write_string
	ws(b, "<footer class=\"foot\">\nWren is made by <a href=\"https://froment.software\">Froment Software</a>. ")
	ws(b, "Wren User Licence: one payment of 29&nbsp;&euro;, personal and perpetual, two years of updates from 1.0.\n")
	for it in ([?][2]string{{"/archive/", "archive"}, {"/privacy/", "privacy"}, {"/terms/", "terms"}, {"/refunds/", "refunds"}, {"/imprint/", "imprint"}, {modern, "Modern version"}}) {
		ws(b, "- <a href=\"")
		ws(b, it[0])
		ws(b, "\">")
		ws(b, it[1])
		ws(b, "</a>\n")
	}
	ws(b, "</footer>\n</div>\n")
}

// The text between the first `open` and the `close` after it.
between :: proc(s, open, close: string) -> string {
	a := strings.index(s, open)
	if a < 0 { return "" }
	a += len(open)
	b := strings.index(s[a:], close)
	return b < 0 ? "" : s[a:a + b]
}

// The <section> of a page that has the id `id`.
section_by_id :: proc(src, id: string) -> string {
	at := strings.index(src, strings.concatenate({"id=\"", id, "\""}, context.temp_allocator))
	if at < 0 { return "" }
	start := strings.last_index(src[:at], "<section")
	end := strings.index(src[at:], "</section>")
	if start < 0 || end < 0 { return "" }
	return src[start:at + end + len("</section>")]
}

// Every <script> element of a part of a page.
scripts_of :: proc(part: string) -> string {
	b := strings.builder_make(context.allocator)
	rest := part
	for {
		a := strings.index(rest, "<script")
		if a < 0 { break }
		e := strings.index(rest[a:], "</script>")
		if e < 0 { break }
		strings.write_string(&b, rest[a:a + e + len("</script>")])
		strings.write_string(&b, "\n")
		rest = rest[a + e:]
	}
	return strings.to_string(b)
}

// The relative href and src of a part of the page in the folder `dir` made root-absolute: "../img/x.webp" from
// "gallery" -> "/img/x.webp", "./" -> "/".
rooted :: proc(html, dir: string) -> string {
	b := strings.builder_make(context.allocator)
	i := 0
	scan: for i < len(html) {
		for attr in ([?]string{" href=\"", " src=\""}) {
			if !strings.has_prefix(html[i:], attr) { continue }
			v0 := i + len(attr)
			v1 := strings.index_byte(html[v0:], '"')
			if v1 < 0 { break scan }
			strings.write_string(&b, html[i:v0])
			strings.write_string(&b, root_of(html[v0:v0 + v1], dir))
			i = v0 + v1
			continue scan
		}
		strings.write_byte(&b, html[i])
		i += 1
	}
	strings.write_string(&b, html[i:])
	return strings.to_string(b)
}

root_of :: proc(href, dir: string) -> string {
	if href == "" || is_external(href) || strings.has_prefix(href, "#") || strings.has_prefix(href, "/") || strings.has_prefix(href, "data:") || strings.has_prefix(href, "javascript:") || strings.has_prefix(href, "wren-") { return href }
	target, frag := href, ""
	if h := strings.index_byte(href, '#'); h >= 0 { target, frag = href[:h], href[h:] }
	path := posix_normalize(posix_join(dir, target))
	folder := target == "." || target == ".." || strings.has_suffix(target, "/") || strings.has_suffix(target, "/..")
	if folder && path != "" { path = strings.concatenate({path, "/"}, context.allocator) }
	return strings.concatenate({"/", path, frag}, context.allocator)
}

// The site's root-absolute paths of a part of a classic page in the classic tree: a page ("/pricing/") is its classic
// counterpart, a file ("/img/x.webp") stays the site's (SITE_ROOT).
classic_paths :: proc(html: string) -> string {
	b := strings.builder_make(context.allocator)
	i := 0
	scan: for i < len(html) {
		for attr in ([?]string{"href=\"/", "src=\"/"}) {
			if !strings.has_prefix(html[i:], attr) { continue }
			rest := html[i + len(attr):]
			if strings.has_prefix(rest, "/") || strings.has_prefix(rest, "../") { continue }
			path := rest[:max(strings.index_byte(rest, '"'), 0)]
			if cut := strings.index_any(path, "#?"); cut >= 0 { path = path[:cut] }
			strings.write_string(&b, attr)
			if attr[0] == 's' || (path != "" && !strings.has_suffix(path, "/")) { strings.write_string(&b, SITE_ROOT[1:]) }
			i += len(attr)
			continue scan
		}
		strings.write_byte(&b, html[i])
		i += 1
	}
	return strings.to_string(b)
}
