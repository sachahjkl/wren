// Package jsgen: the JavaScript bindings of the browser, generated from the Web IDL of the specifications
// (src/tools/bindgen/webidl, js IDL vendored in native/js/webref) and from the browser's own API description
// (api/*.widl, src/tools/bindgen/idl):
//
//   native/js/gen/bindings.c   one table entry per interface (in pre-order of inheritance: "is an X" is a range check),
//                              per member (Web IDL property attributes, [LegacyUnforgeable], [Replaceable], statics,
//                              constants...), and the glue of the members implemented by a browser function;
//   native/js/gen/bindings.h   WJ_IFACE_<Name> for the hand-written code;
//   src/page/js_interfaces_generated.odin   the interface of each node's wrapper, chosen by the browser;
//   docs/js/coverage.md        what is implemented, and how, and what is not.
//
// How a member is implemented, first match wins:
//   1. hand-written, in native/js/runtime: a C function named wjr_<Interface>_<member> (operations),
//      wjr_<Interface>_get_<member> / _set_<member> (attributes), wjr_<Interface>_static_<member>,
//      wjr_<Interface>_constructor, or the same with the mixin's name for members of an interface mixin; such a function
//      has the engine's native signature and does its own conversions (wj.h helpers);
//   2. generic: event handler attributes (EventHandler types), [Replaceable] and [PutForwards] setters, constants,
//      iterators of indexed collections;
//   3. a browser function of api/*.widl with the member's name (Interface_member, Interface_get_member /
//      Interface_set_member, or Mixin_member), taking the object's handle first unless the object is a singleton
//      (document, window) and taking/returning types the generator can convert by the Web IDL rules: the glue is
//      generated;
//   4. otherwise the member exists and throws NotSupportedError ("not supported by this browser").
// An interface with nothing implemented is not exposed (feature detection stays truthful) unless the pref
// javascript.bindings.expose_unimplemented says otherwise; elements' interfaces always are.
package jsgen

import "core:fmt"
import "core:slice"
import "core:strings"
import "wb:tools/bindgen/idl"
import "wb:tools/bindgen/webidl"

GENERATED_BY :: "Code generated by src/tools/bindgen from native/js/webref/*.idl and api/*.widl. DO NOT EDIT."

Output :: struct {
	c:        string,
	h:        string,
	odin:     string,
	coverage: string,
	problems: []string,
}

Impl_Kind :: enum u8 { None, Raw, Generic, Import }

Member_Impl :: struct {
	kind:   Impl_Kind,
	fn:     string,     // C function for the table (method / getter)
	set_fn: string,     // setter
	set_kind: Impl_Kind,
	note:   string,     // coverage: which raw function / import
}

@(private)
Gen :: struct {
	api:      ^idl.Api,
	m:        ^webidl.Model,
	raw:      map[string]bool,
	imports:  map[string]^idl.Decl,      // import name -> function
	c:        strings.Builder,           // glue functions
	tables:   strings.Builder,           // member tables
	externs:  strings.Builder,
	problems: [dynamic]string,
	included: [dynamic]^webidl.Interface,
	index_of: map[string]int,            // interface name -> table index
	supported: map[string]bool,
	same_object_count: int,
	cov:      map[string][dynamic]string, // interface -> coverage lines
	counts:   map[string][2]int,          // implemented, total
}

@(private)
w :: proc(b: ^strings.Builder, format: string, args: ..any) { if len(args) == 0 { strings.write_string(b, format) } else { fmt.sbprintf(b, format, ..args) } }
@(private)
wl :: proc(b: ^strings.Builder, format: string, args: ..any) { w(b, format, ..args); strings.write_byte(b, '\n') }

@(private)
exposed_any :: proc(e: webidl.Exposures) -> bool { return e != {} }

generate :: proc(api: ^idl.Api, m: ^webidl.Model, raw_impls: []string, odin_package: string) -> Output {
	g := Gen{api = api, m = m}
	for r in raw_impls { g.raw[r] = true }
	for d in api.functions { for imp in d.imports { g.imports[imp] = d } }

	// the interfaces of the table: those exposed in a window or a worker (pre-order kept)
	for it in m.ordered {
		if it.kind == .Callback_Interface && !has_constants(it) { continue }
		if !exposed_any(it.exposed) { continue }
		g.index_of[it.name] = len(g.included)
		append(&g.included, it)
	}
	// pre-order is kept only if every parent is included too: an excluded parent breaks the range checks
	for it in g.included {
		if it.parent_ref != nil {
			if _, ok := g.index_of[it.parent_ref.name]; !ok {
				append(&g.problems, fmt.aprintf("%s is exposed but its parent %s is not", it.name, it.parent_ref.name))
			}
		}
	}

	impls := make([][]Member_Impl, len(g.included))
	for it, i in g.included {
		impls[i] = make([]Member_Impl, len(it.members))
		for mb, j in it.members { impls[i][j] = classify(&g, it, mb) }
	}
	// supported: something implemented, an element / node interface, always present, or an ancestor of one of those
	for it, i in g.included {
		any_impl := false
		for mi in impls[i] { if mi.kind == .Raw || mi.kind == .Import { any_impl = true; break } }
		if g.raw[fmt.tprintf("wjr_%s_constructor", it.name)] { any_impl = true }
		if any_impl || is_node_interface(it.name) || slice.contains(ALWAYS[:], it.name) { mark_supported(&g, it) }
	}

	emit_c(&g, impls)
	dh := strings.builder_make()
	dc := strings.builder_make()
	emit_dicts(&g, &dh, &dc)
	out: Output
	out.c = strings.concatenate({strings.to_string(g.c), "\n", strings.to_string(dc)})
	out.h = emit_h(&g, strings.to_string(dh))
	out.odin = emit_odin(&g, odin_package)
	out.coverage = emit_coverage(&g, impls)
	out.problems = g.problems[:]
	return out
}

@(private)
mark_supported :: proc(g: ^Gen, it: ^webidl.Interface) {
	for cur := it; cur != nil; cur = cur.parent_ref { g.supported[cur.name] = true }
}

@(private)
is_node_interface :: proc(name: string) -> bool {
	if slice.contains(NODE_INTERFACES[:], name) { return true }
	for e in HTML_ELEMENTS { if e[1] == name { return true } }
	for e in SVG_ELEMENTS { if e[1] == name { return true } }
	return false
}

@(private)
has_constants :: proc(it: ^webidl.Interface) -> bool {
	for mb in it.members { if mb.kind == .Const { return true } }
	return false
}

@(private)
is_event_handler :: proc(g: ^Gen, t: ^webidl.Type) -> bool {
	if t == nil || t.kind != .Named { return false }
	switch t.name {
	case "EventHandler", "OnErrorEventHandler", "OnBeforeUnloadEventHandler": return true
	}
	return false
}

@(private)
cap1 :: proc(s: string) -> string {
	if s == "" { return s }
	return strings.concatenate({strings.to_upper(s[:1], context.temp_allocator), s[1:]}, context.temp_allocator)
}

// The C identifier of a member function.
@(private)
fn_name :: proc(prefix, iface, kind, member: string) -> string {
	if kind == "" { return fmt.aprintf("%s_%s_%s", prefix, iface, member) }
	return fmt.aprintf("%s_%s_%s_%s", prefix, iface, kind, member)
}

// Raw function for a member: on the interface, then on the mixin it came from.
@(private)
find_raw :: proc(g: ^Gen, it: ^webidl.Interface, mb: ^webidl.Member, kind: string) -> string {
	n := fn_name("wjr", it.name, kind, mb.name)
	if g.raw[n] { return n }
	delete(n)
	if mb.from_mixin != "" {
		n = fn_name("wjr", mb.from_mixin, kind, mb.name)
		if g.raw[n] { return n }
		delete(n)
	}
	return ""
}

@(private)
classify :: proc(g: ^Gen, it: ^webidl.Interface, mb: ^webidl.Member) -> Member_Impl {
	mi: Member_Impl
	switch mb.kind {
	case .Const:
		mi.kind = .Generic
		mi.note = "constant"
	case .Attribute:
		kind_get := mb.static_ ? "static_get" : "get"
		kind_set := mb.static_ ? "static_set" : "set"
		if r := find_raw(g, it, mb, kind_get); r != "" {
			mi.kind, mi.fn, mi.note = .Raw, r, r
		} else if is_event_handler(g, mb.type) {
			mi.kind = .Generic
			mi.note = "event handler"
			mi.fn = emit_event_handler(g, it, mb, true)
		} else if g2, s2, reflected := emit_reflect(g, it, mb); reflected {
			mi.kind, mi.fn, mi.note = .Generic, g2, "reflects a content attribute"
			if s2 != "" { mi.set_kind, mi.set_fn = .Generic, s2 }
		} else if it.name == "CSSStyleDeclaration" && is_css_property(mb.name) {
			mi.kind = .Generic
			mi.note = "CSS property"
			mi.fn, mi.set_fn = emit_css_property(g, it, mb)
			mi.set_kind = .Generic
		} else if f, note, ok := map_import(g, it, mb, false); ok {
			mi.kind, mi.fn, mi.note = .Import, f, note
		}
		if mi.set_kind == .None && (!mb.readonly || webidl.attr_has(mb.attrs, "Replaceable") || webidl.attr_has(mb.attrs, "PutForwards") || webidl.attr_has(mb.attrs, "LegacyLenientSetter")) {
			if r := find_raw(g, it, mb, kind_set); r != "" {
				mi.set_kind, mi.set_fn = .Raw, r
			} else if is_event_handler(g, mb.type) {
				mi.set_kind, mi.set_fn = .Generic, emit_event_handler(g, it, mb, false)
			} else if webidl.attr_has(mb.attrs, "Replaceable") {
				mi.set_kind, mi.set_fn = .Generic, "wj_replaceable_setter"
			} else if webidl.attr_has(mb.attrs, "LegacyLenientSetter") {
				mi.set_kind, mi.set_fn = .Generic, "wj_lenient_setter"
			} else if a, ok := webidl.attr_get(mb.attrs, "PutForwards"); ok {
				mi.set_kind, mi.set_fn = .Generic, emit_put_forwards(g, it, mb, a.ident)
			} else if f, _, ok2 := map_import(g, it, mb, true); ok2 {
				mi.set_kind, mi.set_fn = .Import, f
			}
		}
		if mi.kind != .None && !mb.readonly && mi.set_kind == .None { mi.note = fmt.aprintf("%s (setter not supported)", mi.note) }
	case .Operation:
		if mb.name == "" { return mi }   // anonymous special: legacy platform object hooks
		kind := mb.static_ ? "static" : ""
		if r := find_raw(g, it, mb, kind); r != "" {
			mi.kind, mi.fn, mi.note = .Raw, r, r
		} else if count_overloads(it, mb) == 1 {
			if f, note, ok := map_import(g, it, mb, false); ok { mi.kind, mi.fn, mi.note = .Import, f, note }
		}
	case .Stringifier:
		if r := fmt.tprintf("wjr_%s_toString", it.name); g.raw[r] { mi.kind, mi.fn, mi.note = .Raw, strings.clone(r), r }
	case .Constructor:
		if r := fmt.tprintf("wjr_%s_constructor", it.name); g.raw[r] { mi.kind, mi.fn, mi.note = .Raw, strings.clone(r), r }
	case .Iterable:
		if mb.key_type == nil && has_indexed_getter(it) {
			mi.kind, mi.note = .Generic, "array iterator (indexed getter)"
		} else if r := fmt.tprintf("wjr_%s_entries", it.name); g.raw[r] {
			mi.kind, mi.note = .Raw, "wjr_*_entries/keys/values/forEach"
		}
	case .Async_Iterable, .Maplike, .Setlike:
		if r := fmt.tprintf("wjr_%s_entries", it.name); g.raw[r] { mi.kind, mi.note = .Raw, "wjr_*_entries/keys/values/forEach" }
	}
	return mi
}

@(private)
count_overloads :: proc(it: ^webidl.Interface, mb: ^webidl.Member) -> int {
	n := 0
	for o in it.members { if o.kind == .Operation && o.name == mb.name && o.static_ == mb.static_ { n += 1 } }
	return n
}

@(private)
has_indexed_getter :: proc(it: ^webidl.Interface) -> bool {
	for cur := it; cur != nil; cur = cur.parent_ref {
		for mb in cur.members {
			if mb.kind == .Operation && mb.special == .Getter && len(mb.args) == 1 && mb.args[0].type.kind == .Named && mb.args[0].type.name == "unsigned long" { return true }
		}
	}
	return false
}

@(private)
has_named_getter :: proc(it: ^webidl.Interface) -> bool {
	for cur := it; cur != nil; cur = cur.parent_ref {
		for mb in cur.members {
			if mb.kind == .Operation && mb.special == .Getter && len(mb.args) == 1 && mb.args[0].type.kind == .Named && mb.args[0].type.name == "DOMString" { return true }
		}
	}
	return false
}

////////////////////////////////
// Generic members

@(private)
emit_event_handler :: proc(g: ^Gen, it: ^webidl.Interface, mb: ^webidl.Member, getter: bool) -> string {
	event := strings.has_prefix(mb.name, "on") ? mb.name[2:] : mb.name
	special := 0
	if mb.type.name == "OnErrorEventHandler" { special = 1 }
	if mb.type.name == "OnBeforeUnloadEventHandler" { special = 2 }
	if getter {
		name := fmt.aprintf("wjg_%s_get_%s", it.name, mb.name)
		wl(&g.c, "static JSValue %s(JSContext *ctx, JSValueConst this_val) {{ return wj_event_handler_get(ctx, this_val, %d, %q); }}", name, g.index_of[it.name], event)
		return name
	}
	name := fmt.aprintf("wjg_%s_set_%s", it.name, mb.name)
	wl(&g.c, "static JSValue %s(JSContext *ctx, JSValueConst this_val, JSValueConst v) {{ return wj_event_handler_set(ctx, this_val, %d, %q, v, %d); }}", name, g.index_of[it.name], event, special)
	return name
}

// [Reflect] / [ReflectSetter] (HTML "reflecting content attributes in IDL attributes"): the IDL attribute reads and
// writes the element's content attribute, with HTML's conversions per type (strings, URLs resolved against the
// document, booleans as presence, integers with their limits and defaults, doubles). Returns the getter (the raw or
// imported one for [ReflectSetter]) and the setter. Types not reflected generically (DOMTokenList, Element?) are left
// to their own implementation.
@(private)
emit_reflect :: proc(g: ^Gen, it: ^webidl.Interface, mb: ^webidl.Member) -> (getter, setter: string, ok: bool) {
	a, has := webidl.attr_get(mb.attrs, "Reflect")
	setter_only := false
	if !has {
		if !webidl.attr_has(mb.attrs, "ReflectSetter") { return }
		setter_only = true
	}
	content := a.ident != "" ? strings.trim(a.ident, "\"") : strings.to_lower(mb.name, context.temp_allocator)
	if setter_only {
		if ra, ok2 := webidl.attr_get(mb.attrs, "ReflectSetter"); ok2 && ra.ident != "" { content = strings.trim(ra.ident, "\"") }
	}
	r := webidl.resolve(g.m, mb.type)
	if r.kind != .Named { return }
	kind := ""
	switch r.name {
	case "DOMString": kind = r.nullable ? "nullable_string" : "string"
	case "USVString": kind = webidl.attr_has(mb.attrs, "ReflectURL") ? "url" : "string"
	case "boolean": kind = "bool"
	case "long": kind = "long"
	case "unsigned long": kind = "ulong"
	case "double": kind = "double"
	case: return
	}
	def := "0"
	if d, okd := webidl.attr_get(mb.attrs, "ReflectDefault"); okd && d.ident != "" { def = d.ident }
	mode := 0
	if webidl.attr_has(mb.attrs, "ReflectNonNegative") { mode = 1 }
	if webidl.attr_has(mb.attrs, "ReflectPositive") { mode = 2 }
	if webidl.attr_has(mb.attrs, "ReflectPositiveWithFallback") { mode = 3 }
	lo, hi := "0", "0"
	if rr, okr := webidl.attr_get(mb.attrs, "ReflectRange"); okr && len(rr.list) == 2 { lo, hi = rr.list[0], rr.list[1]; mode = 4 }
	idx := g.index_of[it.name]
	id := c_ident(mb.name)
	if !setter_only {
		getter = fmt.aprintf("wjg_%s_get_%s", it.name, id)
		wl(&g.c, "static JSValue %s(JSContext *ctx, JSValueConst this_val) {{ return wj_reflect_get(ctx, this_val, %d, %q, WJ_REFLECT_%s, %s, %d, %s, %s); }}", getter, idx, content, strings.to_upper(kind, context.temp_allocator), def, mode, lo, hi)
	} else {
		getter = find_raw(g, it, mb, "get")
		if getter == "" {
			if f, _, okm := map_import(g, it, mb, false); okm { getter = f } else { return }
		}
	}
	if !mb.readonly {
		setter = fmt.aprintf("wjg_%s_set_%s", it.name, id)
		wl(&g.c, "static JSValue %s(JSContext *ctx, JSValueConst this_val, JSValueConst v) {{ return wj_reflect_set(ctx, this_val, %d, %q, WJ_REFLECT_%s, v, %d, %s, %s); }}", setter, idx, content, strings.to_upper(kind, context.temp_allocator), mode, lo, hi)
	}
	return getter, setter, true
}

// CSSStyleDeclaration's attributes for every CSS property (camelCase, webkit-prefixed and dashed spellings).
@(private)
is_css_property :: proc(name: string) -> bool {
	switch name {
	case "cssText", "length", "parentRule": return false
	}
	return true
}

// The CSS name of a CSSOM property attribute: marginTop -> margin-top, webkitTransform -> -webkit-transform,
// cssFloat -> float; dashed names are already CSS names.
@(private)
css_name :: proc(attr: string) -> string {
	if attr == "cssFloat" { return "float" }
	if strings.contains(attr, "-") { return attr }
	b := strings.builder_make(context.temp_allocator)
	if strings.has_prefix(attr, "webkit") { strings.write_byte(&b, '-') }
	for c in transmute([]u8)attr {
		if c >= 'A' && c <= 'Z' { strings.write_byte(&b, '-'); strings.write_byte(&b, c + 32) } else { strings.write_byte(&b, c) }
	}
	return strings.to_string(b)
}

@(private)
emit_css_property :: proc(g: ^Gen, it: ^webidl.Interface, mb: ^webidl.Member) -> (getter, setter: string) {
	id := c_ident(mb.name)
	getter = fmt.aprintf("wjg_%s_get_%s", it.name, id)
	setter = fmt.aprintf("wjg_%s_set_%s", it.name, id)
	css := css_name(mb.name)
	wl(&g.c, "static JSValue %s(JSContext *ctx, JSValueConst this_val) {{ return wj_css_property_get(ctx, this_val, %q); }}", getter, css)
	wl(&g.c, "static JSValue %s(JSContext *ctx, JSValueConst this_val, JSValueConst v) {{ return wj_css_property_set(ctx, this_val, %q, v); }}", setter, css)
	return
}

// A C identifier for an IDL name: dashes replaced, C keywords suffixed (inline -> inline_).
@(private)
c_ident :: proc(s: string) -> string {
	out, _ := strings.replace_all(s, "-", "_", context.temp_allocator)
	switch out {
	case "auto", "break", "case", "char", "const", "continue", "default", "do", "double", "else", "enum", "extern",
	     "float", "for", "goto", "if", "inline", "int", "long", "register", "restrict", "return", "short", "signed",
	     "sizeof", "static", "struct", "switch", "typedef", "union", "unsigned", "void", "volatile", "while", "bool",
	     "true", "false":
		return strings.concatenate({out, "_"}, context.temp_allocator)
	}
	return out
}

@(private)
emit_put_forwards :: proc(g: ^Gen, it: ^webidl.Interface, mb: ^webidl.Member, target: string) -> string {
	name := fmt.aprintf("wjg_%s_set_%s", it.name, mb.name)
	wl(&g.c, "static JSValue %s(JSContext *ctx, JSValueConst this_val, JSValueConst v) {{ return wj_put_forwards(ctx, this_val, %q, %q, v); }}", name, mb.name, target)
	return name
}

////////////////////////////////
// Members implemented by browser functions

@(private)
Conv :: enum u8 { None, Bool, I32, U32, I64, U64, F64, F32, String, Usv, Node, Host, Void }

// How an IDL type converts for a browser function, and the interface of an object type.
@(private)
conv_of :: proc(g: ^Gen, t: ^webidl.Type) -> (c: Conv, iface: string) {
	r := webidl.resolve(g.m, t)
	if r == nil { return .Void, "" }
	if r.kind == .Union {
		// (TrustedHTML or DOMString) and the like: Trusted Types are not implemented, the value is a string
		flat := make([dynamic]^webidl.Type, context.temp_allocator)
		flatten :: proc(g: ^Gen, t: ^webidl.Type, out: ^[dynamic]^webidl.Type) {
			rt := webidl.resolve(g.m, t)
			if rt.kind == .Union { for a in rt.args { flatten(g, a, out) } } else { append(out, rt) }
		}
		flatten(g, r, &flat)
		all := true
		for a in flat {
			ra := webidl.resolve(g.m, a)
			if ra.kind != .Named { all = false; break }
			if ra.name == "DOMString" || ra.name == "USVString" || strings.has_prefix(ra.name, "Trusted") { continue }
			all = false
		}
		if all { return .String, "" }
		// (HTMLScriptElement or SVGScriptElement) and the like: a node either way
		nodes := true
		for a in flat {
			ra := webidl.resolve(g.m, a)
			if ra.kind != .Named || !webidl.inherits(g.m, ra.name, "Node") { nodes = false; break }
		}
		if nodes { return .Node, "Node" }
	}
	if r.kind != .Named { return .None, "" }
	// an IDL enum is its string: the browser function takes or returns the value itself
	if _, is_enum := g.m.enums[r.name]; is_enum { return .String, "" }
	switch r.name {
	case "undefined": return .Void, ""
	case "boolean": return .Bool, ""
	case "byte", "short", "long": return .I32, ""
	case "octet", "unsigned short", "unsigned long": return .U32, ""
	case "long long": return .I64, ""
	case "unsigned long long": return .U64, ""
	case "double", "unrestricted double", "DOMHighResTimeStamp": return .F64, ""
	case "float", "unrestricted float": return .F32, ""
	case "DOMString", "ByteString", "CSSOMString": return .String, ""
	case "USVString": return .Usv, ""
	}
	if it, ok := g.m.interfaces[r.name]; ok && it.kind == .Interface {
		if webidl.inherits(g.m, r.name, "Node") { return .Node, r.name }
		return .Host, r.name
	}
	return .None, ""
}

@(private)
is_numeric :: proc(t: idl.Type) -> bool {
	#partial switch t.kind {
	case .I32, .U32, .I64, .U64, .F32, .F64, .Enum: return true
	}
	return false
}

@(private)
widl_scalar_ok :: proc(c: Conv, t: idl.Type) -> bool {
	#partial switch c {
	case .Bool: return t.kind == .Bool
	case .I32, .U32, .I64, .U64, .F64, .F32: return is_numeric(t)   // C conversions between the numeric types
	case .String: return t.kind == .String || t.kind == .Usv_String
	case .Usv: return t.kind == .Usv_String || t.kind == .String
	case .Node, .Host: return t.kind == .Handle || t.kind == .U64 || t.kind == .Promise
	}
	return false
}

// Finds a browser function for `mb` and writes its glue; false when there is none, or it does not fit.
@(private)
map_import :: proc(g: ^Gen, it: ^webidl.Interface, mb: ^webidl.Member, setter: bool) -> (fname: string, note: string, ok: bool) {
	owners := make([dynamic]string, context.temp_allocator)
	append(&owners, it.name)
	if mb.from_mixin != "" { append(&owners, mb.from_mixin) }
	names := make([dynamic]string, context.temp_allocator)
	for o in owners {
		switch {
		case setter:
			append(&names, fmt.tprintf("%s_set_%s", o, mb.name), fmt.tprintf("%s_set%s", o, cap1(mb.name)), fmt.tprintf("%s_%s_set", o, mb.name))
		case mb.kind == .Attribute:
			append(&names, fmt.tprintf("%s_%s", o, mb.name), fmt.tprintf("%s_get_%s", o, mb.name), fmt.tprintf("%s_get%s", o, cap1(mb.name)), fmt.tprintf("%s_%s_get", o, mb.name))
		case:
			append(&names, fmt.tprintf("%s_%s", o, mb.name))
		}
	}
	for n in names {
		d, found := g.imports[n]
		if !found { continue }
		f, why := emit_import_glue(g, it, mb, d, n, setter)
		if f != "" { return f, fmt.aprintf("%s.%s", d.module.name, n), true }
		append(&g.problems, fmt.aprintf("%s.%s%s: %s.%s exists but %s", it.name, mb.name, setter ? " (setter)" : "", d.module.name, n, why))
	}
	return "", "", false
}

@(private)
emit_import_glue :: proc(g: ^Gen, it: ^webidl.Interface, mb: ^webidl.Member, d: ^idl.Decl, import_name: string, setter: bool) -> (string, string) {
	// the IDL side: arguments (a setter's value), result
	Arg :: struct { conv: Conv, iface: string, t: ^webidl.Type, a: ^webidl.Argument }
	args := make([dynamic]Arg, context.temp_allocator)
	result := Conv.Void
	result_iface := ""
	result_nullable := false
	switch {
	case setter:
		c, i := conv_of(g, mb.type)
		append(&args, Arg{c, i, mb.type, nil})
	case mb.kind == .Attribute:
		result, result_iface = conv_of(g, mb.type)
		result_nullable = webidl.resolve(g.m, mb.type).nullable
	case:
		for a in mb.args {
			if a.variadic { return "", "it is variadic" }
			c, i := conv_of(g, a.type)
			append(&args, Arg{c, i, a.type, a})
		}
		result, result_iface = conv_of(g, mb.type)
		if mb.type != nil { result_nullable = webidl.resolve(g.m, mb.type).nullable }
	}
	for a in args { if a.conv == .None || a.conv == .Void { return "", fmt.tprintf("an argument of type %s has no conversion", webidl.type_text(a.t)) } }
	if result == .None { return "", fmt.tprintf("the result type %s has no conversion", webidl.type_text(mb.type)) }

	// the browser function's side: an optional self handle, then one parameter per argument
	params := d.params
	has_self := false
	if len(params) == len(args) + 1 && !mb.static_ {
		pt := params[0].type
		if pt.kind == .Handle || pt.kind == .U64 { has_self = true } else { return "", "its first parameter is not a handle" }
	} else if len(params) != len(args) {
		return "", fmt.tprintf("it takes %d parameters for %d arguments", len(params), len(args))
	}
	for a, i in args {
		p := params[i + (has_self ? 1 : 0)]
		if p.type.seq { return "", fmt.tprintf("parameter %s is a sequence", p.name) }
		if !widl_scalar_ok(a.conv, p.type) { return "", fmt.tprintf("parameter %s does not match %s", p.name, webidl.type_text(a.t)) }
	}
	r := d.result
	// Node.appendChild(node) and the like return their argument: the browser function returns nothing
	return_arg := -1
	if (result == .Node || result == .Host) && r.kind == .Void {
		for a, i in args { if a.iface == result_iface { return_arg = i; break } }
		if return_arg < 0 { return "", "its result is missing" }
	}
	if result == .Void || return_arg >= 0 {
		// a result the IDL does not have is dropped
	} else if (result == .String || result == .Usv) {
		if r.kind != .String && r.kind != .Usv_String { return "", "its result is not a string" }
	} else if !widl_scalar_ok(result, r) {
		return "", "its result type does not match"
	}

	idx := g.index_of[it.name]
	qual := fmt.tprintf("%s.%s", it.name, mb.name)
	fname: string
	b := &g.c
	switch {
	case setter:
		fname = fmt.aprintf("wjg_%s_set_%s", it.name, mb.name)
		wl(b, "/* %s = v -> %s.%s */", qual, d.module.name, import_name)
		wl(b, "static JSValue %s(JSContext *ctx, JSValueConst this_val, JSValueConst v)", fname)
		wl(b, "{")
		wl(b, "    JSValueConst argv[1] = {v};")
		wl(b, "    int argc = 1;")
	case mb.kind == .Attribute:
		fname = fmt.aprintf("wjg_%s_get_%s", it.name, mb.name)
		wl(b, "/* %s -> %s.%s */", qual, d.module.name, import_name)
		wl(b, "static JSValue %s(JSContext *ctx, JSValueConst this_val)", fname)
		wl(b, "{")
	case:
		fname = fmt.aprintf("wjg_%s_%s%s", it.name, mb.static_ ? "static_" : "", mb.name)
		wl(b, "/* %s() -> %s.%s */", qual, d.module.name, import_name)
		wl(b, "static JSValue %s(JSContext *ctx, JSValueConst this_val, int argc, JSValueConst *argv)", fname)
		wl(b, "{")
	}
	if !mb.static_ {
		wl(b, "    wj_obj *self = wj_this(ctx, this_val, %d);", idx)
		wl(b, "    if (!self) { return JS_EXCEPTION; }")
	} else {
		wl(b, "    WJ_UNUSED(this_val);")
	}
	required := 0
	for a in args { if a.a != nil && !a.a.optional { required += 1 } }
	if !setter && mb.kind == .Operation && required > 0 {
		wl(b, "    if (argc < %d) {{ return wj_throw_arity(ctx, %q, %d, argc); }}", required, qual, required)
	}
	cleanup := strings.builder_make(context.temp_allocator)
	call := make([dynamic]string, context.temp_allocator)
	if has_self { append(&call, "self->handle") }
	for a, i in args {
		v := fmt.tprintf("a%d", i)
		src := setter ? "argv[0]" : fmt.tprintf("wj_arg(argc, argv, %d)", i)
		optional := a.a != nil && a.a.optional
		def := a.a != nil ? a.a.default : webidl.Default{}
		rt := webidl.resolve(g.m, a.t)
		enforce := webidl.attr_has(rt.attrs, "EnforceRange") || (a.a != nil && webidl.attr_has(a.a.attrs, "EnforceRange"))
		clamp := webidl.attr_has(rt.attrs, "Clamp") || (a.a != nil && webidl.attr_has(a.a.attrs, "Clamp"))
		range_mode := enforce ? "WJ_ENFORCE_RANGE" : clamp ? "WJ_CLAMP" : "0"
		p := params[i + (has_self ? 1 : 0)]
		#partial switch a.conv {
		case .Bool:
			defv := def.kind == .True ? "true" : "false"
			if optional && def.kind != .None { wl(b, "    bool %s = %s;", v, defv) } else { wl(b, "    bool %s = false;", v) }
			wl(b, "    if (%s || !JS_IsUndefined(%s)) {{ %s = JS_ToBool(ctx, %s); }}", optional ? "false" : "true", src, v, src)
			append(&call, fmt.tprintf("%s ? 1 : 0", v))
		case .I32, .U32:
			ctype := a.conv == .I32 ? "int32_t" : "uint32_t"
			defv := def.kind == .Number ? def.text : "0"
			wl(b, "    %s %s = %s;", ctype, v, defv)
			cond := optional ? fmt.tprintf("!JS_IsUndefined(%s) && ", src) : ""
			fnc := a.conv == .I32 ? "wj_to_int32" : "wj_to_uint32"
			bits := idl_int_bits(rt.name)
			wl(b, "    if (%s!%s(ctx, %s, &%s, %d, %s)) {{ return JS_EXCEPTION; }}", cond, fnc, src, v, bits, range_mode)
			append(&call, v)
		case .I64, .U64:
			ctype := a.conv == .I64 ? "int64_t" : "uint64_t"
			defv := def.kind == .Number ? def.text : "0"
			wl(b, "    %s %s = %s;", ctype, v, defv)
			cond := optional ? fmt.tprintf("!JS_IsUndefined(%s) && ", src) : ""
			fnc := a.conv == .I64 ? "wj_to_int64" : "wj_to_uint64"
			wl(b, "    if (%s!%s(ctx, %s, &%s, %s)) {{ return JS_EXCEPTION; }}", cond, fnc, src, v, range_mode)
			append(&call, v)
		case .F64, .F32:
			defv := def.kind == .Number ? def.text : "0"
			if defv == "NaN" { defv = "NAN" } else if defv == "Infinity" { defv = "INFINITY" } else if defv == "-Infinity" { defv = "-INFINITY" }
			wl(b, "    double %s = %s;", v, defv)
			cond := optional ? fmt.tprintf("!JS_IsUndefined(%s) && ", src) : ""
			restricted := !strings.has_prefix(rt.name, "unrestricted")
			wl(b, "    if (%s!wj_to_double(ctx, %s, &%s, %v)) {{ return JS_EXCEPTION; }}", cond, src, v, restricted)
			append(&call, a.conv == .F32 && p.type.kind == .F32 ? fmt.tprintf("(float)%s", v) : v)
		case .String, .Usv:
			flags := make([dynamic]string, context.temp_allocator)
			if rt.nullable { append(&flags, "WJ_STR_NULLABLE") }
			if webidl.attr_has(rt.attrs, "LegacyNullToEmptyString") || (a.a != nil && webidl.attr_has(a.a.attrs, "LegacyNullToEmptyString")) { append(&flags, "WJ_STR_NULL_EMPTY") }
			if optional && def.kind == .None { append(&flags, "WJ_STR_OPTIONAL") }
			fl := len(flags) > 0 ? strings.join(flags[:], " | ", context.temp_allocator) : "0"
			defs := def.kind == .String ? def.text : ""
			wl(b, "    wj_str %s;", v)
			wl(b, "    if (!wj_to_str(ctx, %s, &%s, %s, %q)) {{ return JS_EXCEPTION; }}", src, v, fl, defs)
			if p.optional {
				append(&call, fmt.tprintf("(const uint8_t *)%s.ptr", v), fmt.tprintf("%s.ptr ? (uint32_t)%s.len : WR_ABSENT", v, v))
			} else {
				append(&call, fmt.tprintf("(const uint8_t *)(%s.ptr ? %s.ptr : \"\")", v, v), fmt.tprintf("(uint32_t)%s.len", v))
			}
			fmt.sbprintf(&cleanup, "    wj_str_free(ctx, &%s);\n", v)
		case .Node, .Host:
			wl(b, "    uint64_t %s = 0;", v)
			wl(b, "    if (!wj_to_handle(ctx, %s, %d, %v, &%s, %q)) {{ return JS_EXCEPTION; }}", src, g.index_of[a.iface] or_else -1, rt.nullable || optional, v, fmt.tprintf("%s: argument %d is not of type '%s'", qual, i + 1, a.iface))
			append(&call, v)
		}
	}
	callee := fmt.tprintf("wr_%s", import_name)
	callstr := strings.join(call[:], ", ", context.temp_allocator)
	cl := strings.to_string(cleanup)
	ret_ok := "JS_UNDEFINED"
	if return_arg >= 0 { ret_ok = fmt.tprintf("JS_DupValue(ctx, wj_arg(argc, argv, %d))", return_arg) }
	switch {
	case return_arg >= 0 && d.raises:
		wl(b, "    int32_t st = %s(%s);", callee, callstr)
		w(b, "%s", cl)
		wl(b, "    if (st < 0) {{ return wj_throw_status(ctx, st, %q); }}", qual)
		wl(b, "    return %s;", ret_ok)
	case return_arg >= 0 || (result == .Void && r.kind != .Void && !d.raises && !d.abi.out_string && !d.abi.ret_ptr):
		wl(b, "    (void)%s(%s);", callee, callstr)
		w(b, "%s", cl)
		wl(b, "    return %s;", ret_ok)
	case result == .String || result == .Usv:
		wl(b, "    int32_t n;")
		sep := len(call) > 0 ? ", " : ""
		wl(b, "    WJ_FETCH_STRING(n, %s(%s%swj_scratch.data, wj_scratch.cap));", callee, callstr, sep)
		w(b, "%s", cl)
		if d.raises && result_nullable {
			wl(b, "    if (n == wr_Error_Not_Found) { return JS_NULL; }")
		}
		wl(b, "    if (n < 0) {{ return wj_throw_status(ctx, n, %q); }}", qual)
		wl(b, "    return JS_NewStringLen(ctx, (const char *)wj_scratch.data, (size_t)n);")
	case d.raises && d.abi.ret_ptr:
		ct := c_ret_type(result)
		wl(b, "    %s r = 0;", ct)
		sep := len(call) > 0 ? ", " : ""
		wl(b, "    int32_t st = %s(%s%s(void *)&r);", callee, callstr, sep)
		w(b, "%s", cl)
		if result_nullable { wl(b, "    if (st == wr_Error_Not_Found) { return JS_NULL; }") }
		wl(b, "    if (st < 0) {{ return wj_throw_status(ctx, st, %q); }}", qual)
		wl(b, "    return %s;", c_result(g, result, result_iface, "r"))
	case d.raises:
		wl(b, "    int32_t st = %s(%s);", callee, callstr)
		w(b, "%s", cl)
		wl(b, "    if (st < 0) {{ return wj_throw_status(ctx, st, %q); }}", qual)
		wl(b, "    return JS_UNDEFINED;")
	case result == .Void:
		wl(b, "    %s(%s);", callee, callstr)
		w(b, "%s", cl)
		wl(b, "    return JS_UNDEFINED;")
	case:
		wl(b, "    %s r = %s(%s);", c_ret_type(result), callee, callstr)
		w(b, "%s", cl)
		wl(b, "    return %s;", c_result(g, result, result_iface, "r"))
	}
	wl(b, "}")
	wl(b, "")
	return fname, ""
}

@(private)
idl_int_bits :: proc(name: string) -> int {
	switch name {
	case "byte", "octet": return 8
	case "short", "unsigned short": return 16
	}
	return 32
}

@(private)
c_ret_type :: proc(c: Conv) -> string {
	#partial switch c {
	case .Bool: return "int32_t"
	case .I32: return "int32_t"
	case .U32: return "uint32_t"
	case .I64: return "int64_t"
	case .U64, .Node, .Host: return "uint64_t"
	case .F64: return "double"
	case .F32: return "float"
	case .Void: return "uint64_t"   // a result the IDL drops (written through a pointer: room for any scalar)
	}
	return "int32_t"
}

@(private)
c_result :: proc(g: ^Gen, c: Conv, iface: string, v: string) -> string {
	#partial switch c {
	case .Bool: return fmt.tprintf("JS_NewBool(ctx, %s != 0)", v)
	case .I32: return fmt.tprintf("JS_NewInt32(ctx, %s)", v)
	case .U32: return fmt.tprintf("JS_NewUint32(ctx, %s)", v)
	case .I64: return fmt.tprintf("JS_NewInt64(ctx, %s)", v)
	case .U64: return fmt.tprintf("JS_NewFloat64(ctx, (double)%s)", v)
	case .F64, .F32: return fmt.tprintf("JS_NewFloat64(ctx, (double)%s)", v)
	case .Node: return fmt.tprintf("wj_wrap_node(ctx, %s)", v)
	case .Host: return fmt.tprintf("wj_wrap_host(ctx, %s, %d)", v, g.index_of[iface] or_else 0)
	}
	return "JS_UNDEFINED"
}

////////////////////////////////
// Tables

@(private)
member_flags :: proc(g: ^Gen, it: ^webidl.Interface, mb: ^webidl.Member, mi: Member_Impl) -> string {
	f := make([dynamic]string, context.temp_allocator)
	if webidl.attr_has(mb.attrs, "LegacyUnforgeable") || webidl.attr_has(it.attrs, "LegacyUnforgeable") { append(&f, "WJ_F_UNFORGEABLE") }
	if webidl.attr_has(mb.attrs, "Replaceable") { append(&f, "WJ_F_REPLACEABLE") }
	if webidl.attr_has(mb.attrs, "SameObject") && mi.kind != .Generic { append(&f, "WJ_F_SAME_OBJECT") }
	if webidl.attr_has(mb.attrs, "LegacyLenientThis") { append(&f, "WJ_F_LENIENT_THIS") }
	if webidl.attr_has(mb.attrs, "SecureContext") || webidl.attr_has(it.attrs, "SecureContext") { append(&f, "WJ_F_SECURE") }
	e := webidl.member_exposure(it, mb)
	if e == {.Window} && it.exposed != {.Window} { append(&f, "WJ_F_WINDOW_ONLY") }
	if e == {.Worker} && it.exposed != {.Worker} { append(&f, "WJ_F_WORKER_ONLY") }
	if mi.kind != .None && !mb.readonly && mb.kind == .Attribute && mi.set_kind == .None { append(&f, "WJ_F_SETTER_UNSUPPORTED") }
	if len(f) == 0 { return "0" }
	return strings.join(f[:], " | ", context.temp_allocator)
}

@(private)
op_length :: proc(it: ^webidl.Interface, mb: ^webidl.Member) -> int {
	best := -1
	for o in it.members {
		if o.kind != mb.kind || o.name != mb.name || o.static_ != mb.static_ { continue }
		n := 0
		for a in o.args { if a.optional || a.variadic { break }; n += 1 }
		if best < 0 || n < best { best = n }
	}
	return max(best, 0)
}

@(private)
emit_c :: proc(g: ^Gen, impls: [][]Member_Impl) {
	head := strings.builder_make()
	wl(&head, "/* %s */", GENERATED_BY)
	wl(&head, "/* The interface table of the realm and the glue of the members the browser implements (src/tools/bindgen/jsgen). */")
	wl(&head, "#include <math.h>")
	wl(&head, "#include <string.h>")
	wl(&head, "#include \"wj.h\"")
	wl(&head, "#include \"bindings.h\"")
	wl(&head, "")
	// hand-written functions: declared here, defined in native/js/runtime
	raws := make([dynamic]string, context.temp_allocator)
	for r in g.raw { append(&raws, r) }
	slice.sort(raws[:])
	for r in raws {
		switch {
		case strings.has_suffix(r, "_index_get"):
			wl(&head, "JSValue %s(JSContext *ctx, JSValueConst obj, uint32_t index, bool *found);", r)
		case strings.has_suffix(r, "_length_hook"):
			wl(&head, "uint32_t %s(JSContext *ctx, JSValueConst obj);", r)
		case strings.has_suffix(r, "_named_get"):
			wl(&head, "JSValue %s(JSContext *ctx, JSValueConst obj, const char *name, size_t len, bool *found);", r)
		case strings.has_suffix(r, "_named_set"):
			wl(&head, "int %s(JSContext *ctx, JSValueConst obj, const char *name, size_t len, JSValueConst value);", r)
		case strings.has_suffix(r, "_named_delete"):
			wl(&head, "int %s(JSContext *ctx, JSValueConst obj, const char *name, size_t len);", r)
		case strings.has_suffix(r, "_named_keys"):
			wl(&head, "int %s(JSContext *ctx, JSValueConst obj, JSValue array);", r)
		case strings.contains(r, "_get_") || strings.contains(r, "_static_get_"):
			wl(&head, "JSValue %s(JSContext *ctx, JSValueConst this_val);", r)
		case strings.contains(r, "_set_") || strings.contains(r, "_static_set_"):
			wl(&head, "JSValue %s(JSContext *ctx, JSValueConst this_val, JSValueConst v);", r)
		case:
			wl(&head, "JSValue %s(JSContext *ctx, JSValueConst this_val, int argc, JSValueConst *argv);", r)
		}
	}
	wl(&head, "")
	glue := strings.clone(strings.to_string(g.c))
	g.c = head
	wl(&g.c, "%s", glue)

	// member tables
	for it, i in g.included {
		names_done := make(map[string]bool, 16, context.temp_allocator)
		wl(&g.c, "static const wj_member wj_m_%s[] = {{", it.name)
		count := 0
		for mb, j in it.members {
			mi := impls[i][j]
			key := fmt.tprintf("%v|%v|%s", mb.kind, mb.static_, mb.name)
			if mb.kind == .Operation && mb.name == "" { continue }
			if mb.kind == .Constructor || mb.kind == .Iterable || mb.kind == .Async_Iterable || mb.kind == .Maplike || mb.kind == .Setlike { continue }
			if names_done[key] { continue }
			names_done[key] = true
			flags := member_flags(g, it, mb, mi)
			switch mb.kind {
			case .Const:
				v := webidl.number_value(mb.value)
				if mb.value == "true" { v = 1 } else if mb.value == "false" { v = 0 }
				wl(&g.c, "    {{ %q, WJ_M_CONSTANT, 0, 0, NULL, NULL, NULL, %v }},", mb.name, v)
			case .Attribute:
				kind := mb.static_ ? "WJ_M_STATIC_ATTRIBUTE" : "WJ_M_ATTRIBUTE"
				get := mi.fn != "" ? mi.fn : "NULL"
				set := mi.set_fn != "" ? mi.set_fn : "NULL"
				if mi.kind == .None && !mb.readonly { flags = strings.concatenate({flags, " | WJ_F_SETTER_UNSUPPORTED"}, context.temp_allocator) }
				so := webidl.attr_has(mb.attrs, "SameObject") ? g.same_object_count : 0
				if webidl.attr_has(mb.attrs, "SameObject") { g.same_object_count += 1 }
				wl(&g.c, "    {{ %q, %s, %s, %d, NULL, %s, %s, 0 }},", mb.name, kind, flags, so, get, set)
				if mb.stringifier {
					wl(&g.c, "    {{ \"toString\", WJ_M_METHOD, 0, 0, wj_stringifier, %s, NULL, 0 }},", get)
				}
			case .Operation:
				kind := mb.static_ ? "WJ_M_STATIC_METHOD" : "WJ_M_METHOD"
				fnv := mi.fn != "" ? mi.fn : "NULL"
				wl(&g.c, "    {{ %q, %s, %s, %d, %s, NULL, NULL, 0 }},", mb.name, kind, flags, op_length(it, mb), fnv)
			case .Stringifier:
				fnv := mi.fn != "" ? mi.fn : "NULL"
				wl(&g.c, "    {{ \"toString\", WJ_M_METHOD, 0, 0, %s, NULL, NULL, 0 }},", fnv)
			case .Constructor, .Iterable, .Async_Iterable, .Maplike, .Setlike:
			}
			count += 1
		}
		// iterators: pair iterables / maplike / setlike implemented by hand; value iterators of indexed collections are
		// the Array ones (the platform installs them: WJ_I_ARRAY_ITERATOR)
		for mb in it.members {
			if mb.kind != .Iterable && mb.kind != .Maplike && mb.kind != .Setlike && mb.kind != .Async_Iterable { continue }
			if mb.kind == .Iterable && mb.key_type == nil && has_indexed_getter(it) { continue }
			for name in ([]string{"entries", "keys", "values", "forEach"}) {
				r := fmt.tprintf("wjr_%s_%s", it.name, name)
				if g.raw[r] { wl(&g.c, "    {{ %q, WJ_M_METHOD, 0, %d, %s, NULL, NULL, 0 }},", name, name == "forEach" ? 1 : 0, r); count += 1 }
			}
			for name in ([]string{"get", "has", "set", "add", "delete", "clear", "size"}) {
				if mb.kind != .Maplike && mb.kind != .Setlike { break }
				r := fmt.tprintf("wjr_%s_%s", it.name, name)
				if name == "size" { r = fmt.tprintf("wjr_%s_get_size", it.name) }
				if !g.raw[r] { continue }
				if name == "size" { wl(&g.c, "    {{ \"size\", WJ_M_ATTRIBUTE, 0, 0, NULL, %s, NULL, 0 }},", r) } else { wl(&g.c, "    {{ %q, WJ_M_METHOD, 0, %d, %s, NULL, NULL, 0 }},", name, name == "set" ? 2 : name == "clear" ? 0 : 1, r) }
				count += 1
			}
		}
		if count == 0 { wl(&g.c, "    { NULL, 0, 0, 0, NULL, NULL, NULL, 0 },") }
		wl(&g.c, "};")
		g.counts[it.name] = {count, count}
	}
	wl(&g.c, "")

	// the interface table
	wl(&g.c, "const int wj_interface_count = %d;", len(g.included))
	wl(&g.c, "const int wj_same_object_count = %d;", g.same_object_count)
	wl(&g.c, "")
	wl(&g.c, "const wj_interface wj_interfaces[] = {")
	for it in g.included {
		parent := -1
		if it.parent_ref != nil { parent = g.index_of[it.parent_ref.name] or_else -1 }
		ex := make([dynamic]string, context.temp_allocator)
		if .Window in it.exposed { append(&ex, "WJ_EXPOSE_WINDOW") }
		if .Worker in it.exposed { append(&ex, "WJ_EXPOSE_WORKER") }
		flags := make([dynamic]string, context.temp_allocator)
		if webidl.attr_has(it.attrs, "Global") { append(&flags, "WJ_I_GLOBAL") }
		if webidl.attr_has(it.attrs, "LegacyNoInterfaceObject") { append(&flags, "WJ_I_NO_INTERFACE_OBJECT") }
		if it.kind == .Namespace { append(&flags, "WJ_I_NAMESPACE") }
		if it.kind == .Callback_Interface { append(&flags, "WJ_I_CALLBACK") }
		if !g.supported[it.name] { append(&flags, "WJ_I_UNSUPPORTED") }
		if webidl.attr_has(it.attrs, "LegacyOverrideBuiltIns") { append(&flags, "WJ_I_OVERRIDE_BUILTINS") }
		if webidl.attr_has(it.attrs, "SecureContext") { append(&flags, "WJ_I_SECURE") }
		unforgeable := webidl.attr_has(it.attrs, "LegacyUnforgeable")
		for mb in it.members { if webidl.attr_has(mb.attrs, "LegacyUnforgeable") { unforgeable = true } }
		if unforgeable { append(&flags, "WJ_I_HAS_UNFORGEABLE") }
		indexed := has_indexed_getter(it)
		for mb in it.members { if mb.kind == .Iterable && mb.key_type == nil && indexed { append(&flags, "WJ_I_ARRAY_ITERATOR"); break } }
		class_kind := "WJ_CLASS_PLAIN"
		if indexed { class_kind = "WJ_CLASS_INDEXED" } else if has_named_getter(it) { class_kind = "WJ_CLASS_NAMED" }
		ctor := "NULL"
		ctor_len := 0
		has_ctor := false
		for mb in it.members {
			if mb.kind != .Constructor { continue }
			has_ctor = true
			n := 0
			for a in mb.args { if a.optional || a.variadic { break }; n += 1 }
			if ctor_len == 0 || n < ctor_len { ctor_len = n }
		}
		if r := fmt.tprintf("wjr_%s_constructor", it.name); g.raw[r] { ctor = strings.clone(r) }
		if has_ctor && ctor == "NULL" { append(&flags, "WJ_I_CTOR_UNSUPPORTED") }
		hook :: proc(g: ^Gen, it: ^webidl.Interface, suffix: string) -> string {
			r := fmt.tprintf("wjr_%s_%s", it.name, suffix)
			return g.raw[r] ? strings.clone(r) : "NULL"
		}
		alias := "NULL"
		if a, ok := webidl.attr_get(it.attrs, "LegacyWindowAlias"); ok {
			if a.ident != "" { alias = fmt.tprintf("%q", a.ident) } else if len(a.list) > 0 { alias = fmt.tprintf("%q", a.list[0]) }
		}
		fname, ffn := "NULL", "NULL"
		flen := 0
		if a, ok := webidl.attr_get(it.attrs, "LegacyFactoryFunction"); ok {
			fname = fmt.tprintf("%q", a.ident)
			r := fmt.tprintf("wjr_%s_factory", it.name)
			if g.raw[r] { ffn = strings.clone(r) }
			for x in a.args { if x.optional { break }; flen += 1 }
		}
		fl := len(flags) > 0 ? strings.join(flags[:], " | ", context.temp_allocator) : "0"
		exs := len(ex) > 0 ? strings.join(ex[:], " | ", context.temp_allocator) : "0"
		n := g.counts[it.name][0]
		wl(&g.c, "    {{ .name = %q, .parent = %d, .exposed = %s, .flags = %s, .class_kind = %s, .ctor_length = %d, .ctor = %s,", it.name, parent, exs, fl, class_kind, ctor_len, ctor)
		wl(&g.c, "      .members = wj_m_%s, .n_members = %d, .subtree_end = %d,", it.name, n, table_subtree_end(g, it))
		wl(&g.c, "      .index_get = %s, .length_get = %s, .named_get = %s, .named_set = %s, .named_delete = %s, .named_keys = %s,",
			hook(g, it, "index_get"), hook(g, it, "length_hook"), hook(g, it, "named_get"), hook(g, it, "named_set"), hook(g, it, "named_delete"), hook(g, it, "named_keys"))
		wl(&g.c, "      .legacy_alias = %s, .factory_name = %s, .factory = %s, .factory_length = %d }},", alias, fname, ffn, flen)
	}
	wl(&g.c, "};")
}

// End (exclusive) of an interface's subtree among the table's entries: they are contiguous (pre-order, and every
// included interface's parent is included).
@(private)
table_subtree_end :: proc(g: ^Gen, it: ^webidl.Interface) -> int {
	end := g.index_of[it.name] + 1
	for c in it.children {
		if _, ok := g.index_of[c.name]; ok { end = max(end, table_subtree_end(g, c)) }
	}
	return end
}
