package idl

import "core:fmt"
import "core:strings"

Out :: struct {
	b: strings.Builder,
}

out_make :: proc() -> Out { return Out{b = strings.builder_make()} }

w :: proc(o: ^Out, format: string, args: ..any) { fmt.sbprintf(&o.b, format, ..args) }
wl :: proc(o: ^Out, format: string, args: ..any) { fmt.sbprintf(&o.b, format, ..args); strings.write_byte(&o.b, '\n') }
ws :: proc(o: ^Out, s: string) { strings.write_string(&o.b, s) }
out_text :: proc(o: ^Out) -> string { return strings.to_string(o.b) }

// `///`-style doc comment, one line per doc line.
write_doc :: proc(o: ^Out, doc: string, indent: string, prefix := "// ") {
	if doc == "" { return }
	for line in strings.split_lines(doc, context.temp_allocator) {
		ws(o, indent)
		ws(o, strings.trim_right_space(strings.concatenate({prefix, line}, context.temp_allocator)))
		ws(o, "\n")
	}
}

// Odin string literal of `s` (only printable ASCII is expected in descriptions).
quote :: proc(s: string) -> string {
	b := strings.builder_make(context.temp_allocator)
	strings.write_byte(&b, '"')
	for c in transmute([]u8)s {
		switch c {
		case '"':  strings.write_string(&b, "\\\"")
		case '\\': strings.write_string(&b, "\\\\")
		case '\n': strings.write_string(&b, "\\n")
		case:      strings.write_byte(&b, c)
		}
	}
	strings.write_byte(&b, '"')
	return strings.to_string(b)
}

// Qualified name used in messages: "url.URL_parse".
qname :: proc(d: ^Decl) -> string { return strings.concatenate({d.module.name, ".", d.imports[0] if len(d.imports) > 0 else d.name}, context.temp_allocator) }

GENERATED_BY :: "Code generated by src/tools/bindgen from api/*.widl. DO NOT EDIT."
