package gen

import "core:fmt"
import "core:os"
import "core:slice"
import "core:strconv"
import "core:strings"
import "wb:tools/tooling"

// The tables of the rules of UTS #46 that Lexbor's IDNA leaves out (src/shim/wb_idna.c): a label must not begin with a
// combining mark (General_Category M), and the joiners' contexts of CheckJoiners (RFC 5892 appendix A.1 and A.2: a
// virama, Canonical_Combining_Class 9, before; the joining types L, D, R and T around), from the pinned Character
// Database of the Unicode tables (UCD_FILES).
IDNA_TABLES :: "src/shim/wb_idna_tables.h"
IDNA_UCD :: []string{"UnicodeData.txt", "extracted/DerivedGeneralCategory.txt", "extracted/DerivedJoiningType.txt"}
// UnicodeData.txt's field of the canonical combining class; a virama's class.
UCD_FIELD_COMBINING_CLASS :: 3
VIRAMA_COMBINING_CLASS :: "9"
// Values per line of the generated arrays.
IDNA_VALUES_PER_LINE :: 8

@(private = "file")
Cp_Range :: struct { first, last: u32, class: u8 }

gen_idna :: proc(args: []string) -> int {
	for name in IDNA_UCD {
		for u in UCD_FILES {
			if u.cached != name { continue }
			if !tooling.download_pinned(fmt.tprintf("%s/%s", UNICODE_BASE, u.url), fmt.tprintf("%s/%s", UNICODE_CACHE, u.cached), u.sha) { return 1 }
		}
	}
	marks := make([dynamic]Cp_Range, context.temp_allocator)
	viramas := make([dynamic]Cp_Range, context.temp_allocator)
	joining := make([dynamic]Cp_Range, context.temp_allocator)
	for line in ucd_lines("extracted/DerivedGeneralCategory.txt") {
		r, value, ok := ucd_range(line)
		if ok && (value == "Mn" || value == "Mc" || value == "Me") { append(&marks, Cp_Range{r.first, r.last, 'M'}) }
	}
	for line in ucd_lines("UnicodeData.txt") {
		fields := strings.split(line, ";", context.temp_allocator)
		if len(fields) <= UCD_FIELD_COMBINING_CLASS || fields[UCD_FIELD_COMBINING_CLASS] != VIRAMA_COMBINING_CLASS { continue }
		cp, ok := strconv.parse_uint(fields[0], 16)
		if ok { append(&viramas, Cp_Range{u32(cp), u32(cp), 'V'}) }
	}
	for line in ucd_lines("extracted/DerivedJoiningType.txt") {
		r, value, ok := ucd_range(line)
		if ok && (value == "L" || value == "D" || value == "R" || value == "T") { append(&joining, Cp_Range{r.first, r.last, value[0]}) }
	}
	if len(marks) == 0 || len(viramas) == 0 || len(joining) == 0 { fmt.eprintln("gen idna: a table came out empty"); return 1 }
	version, _ := os.read_entire_file(fmt.tprintf("%s/VERSION", UNICODE_CACHE), context.temp_allocator)
	b := strings.builder_make(context.temp_allocator)
	fmt.sbprintfln(&b, "/* Generated by `wrentool gen idna` (src/tools/wrentool/gen/idna.odin) from the Unicode Character Database %s:", len(version) > 0 ? string(version) : UNICODE_VERSION)
	strings.write_string(&b, " * do not edit. The code points of the rules of UTS #46 Lexbor leaves out (wb_idna.c), as sorted ranges (first, last):\n")
	strings.write_string(&b, " * the combining marks (General_Category M), the viramas (Canonical_Combining_Class 9), the joining types L, D, R, T. */\n")
	write_ranges(&b, "wb_idna_mark", merged(marks[:]), false)
	write_ranges(&b, "wb_idna_virama", merged(viramas[:]), false)
	write_ranges(&b, "wb_idna_joining", merged(joining[:]), true)
	if err := os.write_entire_file(IDNA_TABLES, transmute([]u8)strings.to_string(b)); err != nil { fmt.eprintfln("gen idna: %s cannot be written", IDNA_TABLES); return 1 }
	fmt.printfln("wrote %s", IDNA_TABLES)
	return 0
}

// The data lines of a cached file of the Character Database (comments and blank lines left out).
@(private = "file")
ucd_lines :: proc(name: string) -> []string {
	data, _ := os.read_entire_file(fmt.tprintf("%s/%s", UNICODE_CACHE, name), context.temp_allocator)
	lines := make([dynamic]string, context.temp_allocator)
	for line in strings.split_lines(string(data), context.temp_allocator) {
		l := line
		if hash := strings.index_byte(l, '#'); hash >= 0 { l = l[:hash] }
		l = strings.trim_space(l)
		if l != "" { append(&lines, l) }
	}
	return lines[:]
}

// `0300..036F ; Mn` or `0620 ; D`: the range and the value.
@(private = "file")
ucd_range :: proc(line: string) -> (r: Cp_Range, value: string, ok: bool) {
	semi := strings.index_byte(line, ';')
	if semi < 0 { return }
	cps := strings.trim_space(line[:semi])
	value = strings.trim_space(line[semi + 1:])
	first, last := cps, cps
	if dots := strings.index(cps, ".."); dots >= 0 { first, last = cps[:dots], cps[dots + 2:] }
	f, fok := strconv.parse_uint(first, 16)
	l, lok := strconv.parse_uint(last, 16)
	return Cp_Range{u32(f), u32(l), 0}, value, fok && lok
}

// Sorted, with adjacent ranges of one class joined.
@(private = "file")
merged :: proc(rs: []Cp_Range) -> []Cp_Range {
	slice.sort_by(rs, proc(a, b: Cp_Range) -> bool { return a.first < b.first })
	out := make([dynamic]Cp_Range, context.temp_allocator)
	for r in rs {
		if n := len(out); n > 0 && out[n - 1].class == r.class && out[n - 1].last + 1 == r.first { out[n - 1].last = r.last; continue }
		append(&out, r)
	}
	return out[:]
}

// `name`_first[], `name`_last[] (and `name`_class[] when `classes`), with `name`_COUNT (upper case).
@(private = "file")
write_ranges :: proc(b: ^strings.Builder, name: string, rs: []Cp_Range, classes: bool) {
	fmt.sbprintfln(b, "#define %s_COUNT %d", strings.to_upper(name, context.temp_allocator), len(rs))
	parts := classes ? []string{"first", "last", "class"} : []string{"first", "last"}
	for part in parts {
		fmt.sbprintf(b, "static const %s %s_%s[] = {{", part == "class" ? "uint8_t" : "uint32_t", name, part)
		for r, i in rs {
			strings.write_string(b, i % IDNA_VALUES_PER_LINE == 0 ? "\n    " : " ")
			switch part {
			case "first": fmt.sbprintf(b, "0x%04X,", r.first)
			case "last": fmt.sbprintf(b, "0x%04X,", r.last)
			case "class": fmt.sbprintf(b, "'%c',", rune(r.class))
			}
		}
		strings.write_string(b, "\n};\n")
	}
}
