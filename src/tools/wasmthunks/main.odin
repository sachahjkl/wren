// Writes src/wasm/thunks_generated.odin: one thunk per native shape of the host-function signatures found in the
// sources (string literals such as "(i*~)i" in any .odin file under src/). The file is only rewritten when its content
// changes, so build.bat can run this before every build at no cost.
//   wasmthunks [src_dir] [out_file]        (defaults: src, src/wasm/thunks_generated.odin)
//   wasmthunks -check [src_dir] [out_file] exit 1 if the file is not up to date
// A signature built at run time (not a literal) is not seen here: wasm.register refuses it with a message naming the
// missing shape, and the page package test that registers every import fails.
package wasmthunks

import "core:fmt"
import "core:os"
import "core:path/filepath"
import "core:slice"
import "core:strings"

// Signatures the wasm package itself relies on, whatever the sources contain.
BASE_SHAPES :: [?]string{"_v", "_i", "i_v", "i_i"}

shape_of_signature :: proc(sig: string) -> (shape: string, ok: bool) {
	if len(sig) < 2 || sig[0] != '(' { return }
	close := strings.index_byte(sig, ')')
	if close < 0 { return }
	b := strings.builder_make(context.temp_allocator)
	inner := sig[1:close]
	for i := 0; i < len(inner); i += 1 {
		switch inner[i] {
		case 'i', 'I', 'f', 'F': strings.write_byte(&b, inner[i])
		case '$':                strings.write_byte(&b, 'p')
		case '*':
			strings.write_byte(&b, 'p')
			if i + 1 < len(inner) && inner[i + 1] == '~' { strings.write_byte(&b, 'i'); i += 1 }
		case: return
		}
	}
	strings.write_byte(&b, '_')
	switch r := sig[close + 1:]; r {
	case "":                  strings.write_byte(&b, 'v')
	case "i", "I", "f", "F":  strings.write_string(&b, r)
	case: return
	}
	return strings.to_string(b), true
}

// Every string literal of `text` that looks like a signature.
scan :: proc(text: string, shapes: ^map[string]bool) {
	for i := 0; i < len(text); i += 1 {
		if text[i] != '"' || i + 1 >= len(text) || text[i + 1] != '(' { continue }
		j := i + 1
		for j < len(text) && text[j] != '"' && text[j] != '\n' { j += 1 }
		if j >= len(text) || text[j] != '"' { continue }
		lit := text[i + 1:j]
		if sh, ok := shape_of_signature(lit); ok { shapes[sh] = true }
		i = j
	}
}

walk :: proc(dir: string, shapes: ^map[string]bool) {
	infos, err := os.read_all_directory_by_path(dir, context.temp_allocator)
	if err != nil { return }
	for fi in infos {
		if fi.type == .Directory { walk(fi.fullpath, shapes); continue }
		if !strings.has_suffix(fi.name, ".odin") || fi.name == "thunks_generated.odin" { continue }
		data, rerr := os.read_entire_file(fi.fullpath, context.temp_allocator)
		if rerr != nil { continue }
		scan(string(data), shapes)
	}
}

native_type :: proc(c: byte) -> string {
	switch c {
	case 'i': return "i32"
	case 'I': return "i64"
	case 'f': return "f32"
	case 'F': return "f64"
	case 'p': return "rawptr"
	}
	return "?"
}

arg_expr :: proc(c: byte, k: int) -> string {
	switch c {
	case 'i': return fmt.tprintf("i32(u32(a[%d]))", k)
	case 'I': return fmt.tprintf("i64(a[%d])", k)
	case 'f': return fmt.tprintf("transmute(f32)u32(a[%d])", k)
	case 'F': return fmt.tprintf("transmute(f64)a[%d]", k)
	case 'p': return fmt.tprintf("rawptr(uintptr(a[%d]))", k)
	}
	return "?"
}

generate :: proc(shapes: []string) -> string {
	b := strings.builder_make(context.temp_allocator)
	strings.write_string(&b, "// Generated by src/tools/wasmthunks from the signatures of the sources. Do not edit: build.bat regenerates it.\n")
	strings.write_string(&b, "package wasm\n\n")
	for sh in shapes {
		us := strings.index_byte(sh, '_')
		params, result := sh[:us], sh[us + 1]
		fmt.sbprintf(&b, "@(private)\nthunk_%s :: proc \"contextless\" (fn: rawptr, env: Exec_Env, a: [^]u64) -> u64 {{\n", sh)
		strings.write_string(&b, "\tf := (proc \"c\" (Exec_Env")
		for i in 0 ..< len(params) { fmt.sbprintf(&b, ", %s", native_type(params[i])) }
		strings.write_string(&b, ")")
		if result != 'v' { fmt.sbprintf(&b, " -> %s", native_type(result)) }
		strings.write_string(&b, ")(fn)\n")
		call := strings.builder_make(context.temp_allocator)
		strings.write_string(&call, "f(env")
		for i in 0 ..< len(params) { fmt.sbprintf(&call, ", %s", arg_expr(params[i], i)) }
		strings.write_string(&call, ")")
		c := strings.to_string(call)
		switch result {
		case 'v': fmt.sbprintf(&b, "\t%s\n\treturn 0\n", c)
		case 'i': fmt.sbprintf(&b, "\treturn u64(u32(%s))\n", c)
		case 'I': fmt.sbprintf(&b, "\treturn u64(%s)\n", c)
		case 'f': fmt.sbprintf(&b, "\treturn u64(transmute(u32)%s)\n", c)
		case 'F': fmt.sbprintf(&b, "\treturn transmute(u64)%s\n", c)
		}
		strings.write_string(&b, "}\n\n")
	}
	strings.write_string(&b, "THUNKS := [?]Thunk_Entry{\n")
	for sh in shapes { fmt.sbprintf(&b, "\t{{%q, thunk_%s}},\n", sh, sh) }
	strings.write_string(&b, "}\n")
	return strings.to_string(b)
}

main :: proc() {
	args := os.args[1:]
	check := false
	if len(args) > 0 && args[0] == "-check" { check = true; args = args[1:] }
	src := len(args) > 0 ? args[0] : "src"
	out: string
	if len(args) > 1 {
		out = args[1]
	} else {
		joined, jerr := filepath.join({src, "wasm", "thunks_generated.odin"}, context.temp_allocator)
		if jerr != nil { fmt.eprintln("wasmthunks: bad path"); os.exit(1) }
		out = joined
	}

	shapes := make(map[string]bool, 256, context.temp_allocator)
	for s in BASE_SHAPES { shapes[s] = true }
	walk(src, &shapes)
	list := make([dynamic]string, 0, len(shapes), context.temp_allocator)
	for k in shapes { append(&list, k) }
	slice.sort(list[:])
	text := generate(list[:])

	old, _ := os.read_entire_file(out, context.temp_allocator)
	if string(old) == text {
		fmt.printfln("wasmthunks: %s up to date (%d shapes)", out, len(list))
		return
	}
	if check {
		fmt.eprintfln("wasmthunks: %s is out of date: run src/tools/wasmthunks", out)
		os.exit(1)
	}
	if err := os.write_entire_file(out, transmute([]byte)text); err != nil {
		fmt.eprintfln("wasmthunks: cannot write %s: %v", out, err)
		os.exit(1)
	}
	fmt.printfln("wasmthunks: wrote %s (%d shapes)", out, len(list))
}
