package page

// Preferences of the platform web APIs (timers, crypto, Web Storage, history, performance, URL). Registered by
// register_prefs; copied into Settings.web by settings_from_prefs.

import "wb:config"

Web_Settings :: struct {
	timer_nesting_threshold: int,
	timer_nested_min_ms:     f64,
	throttle_background:     bool,
	background_align_ms:     f64,
	idle_poll_ms:            f64,
	idle_max_deadline_ms:    f64,
	frame_budget_ms:         f64,   // 0: frame_period_ms
	frame_period_ms:         f64,   // set by the shell: the period of its frames (not a preference; 0: unknown)
	max_frame_callbacks:     int,
	max_idle_callbacks:      int,
	max_random_bytes:        int,
	digest_offload_bytes:    int,
	storage_local:           bool,
	storage_session:         bool,
	storage_quota:           int,
	session_quota:           int,
	storage_write_delay_ms:  f64,
	perf_max_entries:        int,
	history_max_entries:     int,
	history_max_state_bytes: int,
	history_max_nodes:       int,
	url_max_length:          int,
	max_signal_sources:      int,
}

WEB_PREFS := [?]config.Def{
	{name = "timers.nesting_threshold", kind = .Int, default = {i = 5}, bounded = true, min = 0, max = 1000,
		description = "Timer nesting level (a timer set from a timer callback, repeatedly) past which short delays are raised to timers.nested_min_delay_ms. HTML says 5."},
	{name = "timers.nested_min_delay_ms", kind = .Float, default = {f = 4}, bounded = true, min = 0, max = 1000, unit = "ms",
		description = "Smallest delay of a deeply nested timer (HTML clamps to 4 ms), so a script that keeps re-arming a zero-delay timer cannot spin the event loop."},
	{name = "timers.throttle_background", kind = .Bool, default = {b = true},
		description = "Timers of hidden tabs (not the current tab, or a minimized window) wake up at most once per timers.background_alignment_ms."},
	{name = "timers.background_alignment_ms", kind = .Float, default = {f = 1000}, bounded = true, min = 1, max = 600_000, unit = "ms",
		description = "Wake-up grid of the timers of hidden tabs: a due timer waits for the next multiple of this period."},
	{name = "timers.idle_poll_ms", kind = .Float, default = {f = 1}, bounded = true, min = 0, max = 10_000, unit = "ms",
		description = "How often the page looks for an idle period while requestIdleCallback callbacks wait and the event loop is busy."},
	{name = "timers.idle_max_deadline_ms", kind = .Float, default = {f = 50}, bounded = true, min = 1, max = 10_000, unit = "ms",
		description = "Longest idle period given to requestIdleCallback callbacks (the specification's 50 ms)."},
	{name = "timers.frame_budget_ms", kind = .Float, default = {f = 0}, bounded = true, min = 0, max = 1000, unit = "ms",
		description = "Expected time between two rendered frames: an idle period never runs into the next animation frame of a page that requested one. 0 = the frame period of the browser (browser.frame.target_hz: 5.6 ms on a 180 Hz monitor)."},
	{name = "timers.max_animation_callbacks", kind = .Int, default = {i = 100_000}, bounded = true, min = 1, max = 100_000_000,
		description = "Most requestAnimationFrame callbacks one page may have waiting. Past it, requests fail."},
	{name = "timers.max_idle_callbacks", kind = .Int, default = {i = 100_000}, bounded = true, min = 1, max = 100_000_000,
		description = "Most requestIdleCallback callbacks one page may have waiting. Past it, requests fail."},
	{name = "crypto.max_random_bytes", kind = .Int, default = {i = 65536}, bounded = true, min = 1, max = 1 << 30, bytes = true, unit = "bytes",
		description = "Largest crypto.getRandomValues request; bigger ones fail with QuotaExceededError (the Web Crypto limit is 65536)."},
	{name = "crypto.digest_offload_bytes", kind = .Int, default = {i = 64 << 10}, bounded = true, min = 0, max = 1 << 40, bytes = true, unit = "bytes",
		description = "crypto.subtle.digest inputs at least this large are hashed on a worker thread instead of the UI thread."},
	{name = "storage.local.enabled", kind = .Bool, default = {b = true},
		description = "localStorage is available to pages. When off, scripts get a SecurityError."},
	{name = "storage.session.enabled", kind = .Bool, default = {b = true},
		description = "sessionStorage is available to pages. When off, scripts get a SecurityError."},
	{name = "storage.local.quota", kind = .Int, default = {i = 5 << 20}, bounded = true, min = 0, max = 1 << 32, bytes = true, unit = "code units",
		description = "localStorage size per origin, counted in UTF-16 code units of keys and values. A write past it fails with QuotaExceededError."},
	{name = "storage.session.quota", kind = .Int, default = {i = 5 << 20}, bounded = true, min = 0, max = 1 << 32, bytes = true, unit = "code units",
		description = "sessionStorage size per origin and tab, counted in UTF-16 code units."},
	{name = "storage.local.write_delay_ms", kind = .Float, default = {f = 1000}, bounded = true, min = 0, max = 600_000, unit = "ms",
		description = "localStorage changes are written to the profile this long after the first unsaved change (in the background, atomically)."},
	{name = "performance.max_user_timing_entries", kind = .Int, default = {i = 10_000}, bounded = true, min = 1, max = 100_000_000,
		description = "Most performance.mark / measure entries kept per page; the oldest are dropped past it."},
	{name = "history.max_entries", kind = .Int, default = {i = 50}, bounded = true, min = 1, max = 100_000,
		description = "Entries of a tab's session history that pages see (history.length, back and forward): the path through the tab's history tree to the current entry and on along the branches visited last. Past it the oldest are hidden from pages (the tree keeps them, up to history.tree.max_nodes)."},
	{name = "history.tree.max_nodes", kind = .Int, default = {i = 1000}, bounded = true, min = 1, max = 1_000_000,
		description = "Entries kept in a tab's history tree, every branch included. Past it the entries visited least recently go, those off the current path first."},
	{name = "history.max_state_bytes", kind = .Int, default = {i = 16 << 20}, bounded = true, min = 0, max = 1 << 30, bytes = true, unit = "bytes",
		description = "Largest history.pushState / replaceState state; a bigger one fails with DataCloneError."},
	{name = "url.max_length", kind = .Int, default = {i = 2 << 20}, bounded = true, min = 1024, max = 1 << 30, bytes = true, unit = "bytes",
		description = "Longest URL a script may build with URL, URLSearchParams, location or history; longer input fails with TypeError."},
	{name = "dom.abort_signal.max_sources", kind = .Int, default = {i = 10_000}, bounded = true, min = 1, max = 10_000_000,
		description = "Most signals one AbortSignal.any() may follow; more is a RangeError."},
}

web_settings_from_prefs :: proc(p: ^config.Prefs) -> Web_Settings {
	return Web_Settings{
		timer_nesting_threshold = int(config.int_of(p, "timers.nesting_threshold")),
		timer_nested_min_ms     = config.float_of(p, "timers.nested_min_delay_ms"),
		throttle_background     = config.bool_of(p, "timers.throttle_background"),
		background_align_ms     = config.float_of(p, "timers.background_alignment_ms"),
		idle_poll_ms            = config.float_of(p, "timers.idle_poll_ms"),
		idle_max_deadline_ms    = config.float_of(p, "timers.idle_max_deadline_ms"),
		frame_budget_ms         = config.float_of(p, "timers.frame_budget_ms"),
		max_frame_callbacks     = int(config.int_of(p, "timers.max_animation_callbacks")),
		max_idle_callbacks      = int(config.int_of(p, "timers.max_idle_callbacks")),
		max_random_bytes        = int(config.int_of(p, "crypto.max_random_bytes")),
		digest_offload_bytes    = int(config.int_of(p, "crypto.digest_offload_bytes")),
		storage_local           = config.bool_of(p, "storage.local.enabled"),
		storage_session         = config.bool_of(p, "storage.session.enabled"),
		storage_quota           = int(config.int_of(p, "storage.local.quota")),
		session_quota           = int(config.int_of(p, "storage.session.quota")),
		storage_write_delay_ms  = config.float_of(p, "storage.local.write_delay_ms"),
		perf_max_entries        = int(config.int_of(p, "performance.max_user_timing_entries")),
		history_max_entries     = int(config.int_of(p, "history.max_entries")),
		history_max_state_bytes = int(config.int_of(p, "history.max_state_bytes")),
		history_max_nodes       = int(config.int_of(p, "history.tree.max_nodes")),
		url_max_length          = int(config.int_of(p, "url.max_length")),
		max_signal_sources      = int(config.int_of(p, "dom.abort_signal.max_sources")),
	}
}
