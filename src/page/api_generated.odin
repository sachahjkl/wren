@(private = "file")
_Out :: struct { buf: []u8, desc: string, id: u32 }

// Shared argument digest for oversized string/bytes retries.
@(private = "file")
_digest :: #force_no_inline proc "contextless" (f: ^wasm.Frame, a: [^]wasm.Raw, desc: string) -> u64 {
	d := wasm.DIGEST_SEED
	slot := 0
	for ch in transmute([]u8)desc {
		switch ch {
		case 'i': d = wasm.digest_value(d, u64(u32(a[slot].i32))); slot += 1
		case 'l': d = wasm.digest_value(d, u64(a[slot].i64)); slot += 1
		case 'f': d = wasm.digest_value(d, u64(transmute(u32)a[slot].f32)); slot += 1
		case 'd': d = wasm.digest_value(d, transmute(u64)a[slot].f64); slot += 1
		case 'p': d = wasm.digest_value(d, wasm.addr(f, a[slot])); slot += 1
		case 's', 'o', '1', '2', '4', '8':
			d = wasm.digest_value(d, wasm.addr(f, a[slot]))
			d = wasm.digest_value(d, wasm.addr(f, a[slot + 1]))
			slot += 2
		}
	}
	slot = 0
	for ch in transmute([]u8)desc {
		switch ch {
		case 's':
			n := wasm.addr(f, a[slot + 1])
			if s, ok := wasm.span(f, wasm.addr(f, a[slot]), n); ok { d = wasm.digest_bytes(d, s[:n]) }
			slot += 2
		case 'o':
			n := u64(0) if wasm.is_absent(f, a[slot + 1]) else wasm.addr(f, a[slot + 1])
			if s, ok := wasm.span(f, wasm.addr(f, a[slot]), n); ok { d = wasm.digest_bytes(d, s[:n]) }
			slot += 2
		case '1', '2', '4', '8':
			el := u64(ch - '0')
			n := wasm.addr(f, a[slot + 1])
			if s, ok := wasm.span(f, wasm.addr(f, a[slot]), n, el); ok { d = wasm.digest_bytes(d, s[:n * el]) }
			slot += 2
		case:
			slot += 1
		}
	}
	return d
}

@(private = "file")
_out_buf :: #force_no_inline proc(t: ^_Tramp, o: ^_Out, slot: int, id: u32, desc: string) -> bool {
	buf, ok := _span(t, slot, "result buffer")
	if !ok { return false }
	if t.f.inst.oversized.fn != 0 {
		if t.f.inst.oversized.fn != id {
			wasm.oversized_drop(t.f.inst)
		} else if wasm.oversized_serve(&t.f, t.a, buf, id, _digest(&t.f, t.a, desc)) {
			if t.c.routed { api_unroute(&t.c) }
			return false
		}
	}
	o.buf = buf
	o.id = id
	o.desc = desc
	return true
}

@(private = "file")
_end_void :: #force_no_inline proc(t: ^_Tramp) -> wasm.Trap {
	api_end(&t.c)
	tr := wasm.take_trap(t.f.inst)
	if t.c.routed { api_unroute(&t.c) }
	return tr
}

@(private = "file")
_end_status :: #force_no_inline proc(t: ^_Tramp, err: Api_Error) -> wasm.Trap {
	api_end(&t.c)
	if tr := wasm.take_trap(t.f.inst); tr != nil {
		if t.c.routed { api_unroute(&t.c) }
		return tr
	}
	if err != .None { return _fail(t, err, t.c.message) }
	if t.c.routed { api_unroute(&t.c) }
	t.a[0] = {}
	return nil
}

@(private = "file")
_end_i32 :: #force_no_inline proc(t: ^_Tramp, v: i32) -> wasm.Trap {
	api_end(&t.c)
	tr := wasm.take_trap(t.f.inst)
	if tr == nil {
		t.a[0] = {}
		t.a[0].i32 = v
	}
	if t.c.routed { api_unroute(&t.c) }
	return tr
}

