@(private = "file")
_h_Element :: #force_no_inline proc(t: ^_Tramp, slot: int, arg: string, opt := false, kind := "Element") -> (Api_Element, bool) {
	raw := u64(t.a[slot].i64)
	api_route(&t.c, raw)
