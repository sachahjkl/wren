@(private = "file")
_Mode :: enum u8 { Trap, Status, Out, Out_Raise }

@(private = "file")
_Tramp :: struct {
	c:    Call,
	f:    wasm.Frame,
	a:    [^]wasm.Raw,
	q:    string,
	trap: wasm.Trap, // what a refused argument ends the call with: nil when the error is in the instance's record
	mode: _Mode,
}

@(private = "file")
_enter :: #force_no_inline proc "contextless" (t: ^_Tramp, env: rawptr, caller: wasm.Caller, a: [^]wasm.Raw, q: string, mode: _Mode) -> runtime.Context {
	ctx := wasm.default_context()
	t.f = wasm.frame(env, caller)
	t.c = api_begin(t.f.inst)
	t.a = a
	t.q = q
	t.trap = nil
	t.mode = mode
	if mode < .Out && t.f.inst.oversized.fn != 0 { context = ctx; wasm.oversized_drop(t.f.inst) }
	return ctx
}

@(private = "file")
_trap_bounds :: #force_no_inline proc(t: ^_Tramp, arg: string) -> bool {
	t.trap = wasm.trap_bounds(&t.f, t.q, arg)
	if t.c.routed { api_unroute(&t.c) }
	return false
}

@(private = "file")
_span :: #force_no_inline proc(t: ^_Tramp, slot: int, arg: string) -> ([]u8, bool) {
	n := wasm.addr(&t.f, t.a[slot + 1])
	s, ok := wasm.span(&t.f, wasm.addr(&t.f, t.a[slot]), n)
	if !ok { return nil, _trap_bounds(t, arg) }
	return s[:n], true
}

@(private = "file")
_span_el :: #force_no_inline proc(t: ^_Tramp, slot: int, elem: u64, arg: string) -> ([^]u8, u64, bool) {
	n := wasm.addr(&t.f, t.a[slot + 1])
	s, ok := wasm.span(&t.f, wasm.addr(&t.f, t.a[slot]), n, elem)
	if !ok { return nil, 0, _trap_bounds(t, arg) }
	return s, n, true
}

@(private = "file")
_span_opt :: #force_no_inline proc(t: ^_Tramp, slot: int, arg: string) -> (Maybe([]u8), bool) {
	absent := wasm.is_absent(&t.f, t.a[slot + 1])
	n := u64(0) if absent else wasm.addr(&t.f, t.a[slot + 1])
	s, ok := wasm.span(&t.f, wasm.addr(&t.f, t.a[slot]), n)
	if !ok { return nil, _trap_bounds(t, arg) }
	if absent { return nil, true }
	return s[:n], true
}

@(private = "file")
_ret_ptr :: #force_no_inline proc(t: ^_Tramp, slot: int, size: u64) -> ([^]u8, bool) {
	s, ok := wasm.span(&t.f, wasm.addr(&t.f, t.a[slot]), size)
	if !ok { return nil, _trap_bounds(t, "result pointer") }
	return s, true
}

@(private = "file")
_fail :: #force_no_inline proc(t: ^_Tramp, code: Api_Error, message: string) -> wasm.Trap {
	tr: wasm.Trap
	switch t.mode {
	case .Trap, .Out:
		if t.f.inst.lenient {
			api_raise(&t.c, code, message)
			t.a[0] = {}
		} else {
			tr = wasm.trap_new(message)
		}
	case .Status:
		api_raise(&t.c, code, message)
		t.a[0] = {}
		t.a[0].i32 = i32(code)
	case .Out_Raise:
		api_raise(&t.c, code, message)
		wasm.put_size(&t.f, t.a, i64(code))
	}
	if t.c.routed { api_unroute(&t.c) }
	return tr
}

@(private = "file")
_refuse :: #force_no_inline proc(t: ^_Tramp, code: Api_Error, message: string) -> bool {
	t.trap = _fail(t, code, message)
	return false
}

@(private = "file")
_utf8 :: #force_no_inline proc(t: ^_Tramp, s: string, arg: string) -> bool {
	if wasm.valid_utf8(s) { return true }
	return _refuse(t, .Type, fmt.tprintf("%s: argument %s is not valid UTF-8", t.q, arg))
}

@(private = "file")
_str :: #force_no_inline proc(t: ^_Tramp, slot: int, arg: string) -> (string, bool) {
	b, ok := _span(t, slot, arg)
	if !ok { return "", false }
	s := string(b)
	if !_utf8(t, s, arg) { return "", false }
	return s, true
}

@(private = "file")
_opt_str :: #force_no_inline proc(t: ^_Tramp, b: Maybe([]u8), arg: string) -> (Maybe(string), bool) {
	raw, ok := b.?
	if !ok { return nil, true }
	v := string(raw)
	if !wasm.valid_utf8(v) { return nil, _refuse(t, .Type, fmt.tprintf("%s: argument %s is not valid UTF-8", t.q, arg)) }
	return v, true
}

@(private = "file")
_str_opt :: #force_no_inline proc(t: ^_Tramp, slot: int, arg: string) -> (Maybe(string), bool) {
	b, ok := _span_opt(t, slot, arg)
	if !ok { return nil, false }
	return _opt_str(t, b, arg)
}

@(private = "file")
_fail_enum :: #force_no_inline proc(t: ^_Tramp, arg, kind: string) -> wasm.Trap {
	return _fail(t, .Invalid_Argument, fmt.tprintf("%s: argument %s is not a %s", t.q, arg, kind))
}

@(private = "file")
_fail_flags :: #force_no_inline proc(t: ^_Tramp, arg, kind: string) -> wasm.Trap {
	return _fail(t, .Invalid_Argument, fmt.tprintf("%s: argument %s has flags %s does not define", t.q, arg, kind))
}

@(private = "file")
_fail_field_enum :: #force_no_inline proc(t: ^_Tramp, arg, field, kind: string) -> wasm.Trap {
	return _fail(t, .Invalid_Argument, fmt.tprintf("%s: field %s.%s is not a %s", t.q, arg, field, kind))
}

@(private = "file")
_fail_handle :: #force_no_inline proc(t: ^_Tramp, arg, kind: string) -> bool {
	return _refuse(t, .Invalid_Handle, fmt.tprintf("%s: argument %s is not a live %s", t.q, arg, kind))
}

@(private = "file")
_h_AbortController :: #force_no_inline proc(t: ^_Tramp, slot: int, arg: string, opt := false, kind := "AbortController") -> (Api_AbortController, bool) {
	raw := u64(t.a[slot].i64)
	api_route(&t.c, raw)
	r := Api_AbortController{handle = raw}
	if !opt || raw != 0 {
		r.data = lookup_AbortController(&t.c, raw)
		if r.data == nil { return {}, _fail_handle(t, arg, kind) }
	}
	return r, true
}

