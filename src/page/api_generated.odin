	}
	return r, true
}

@(private = "file")
_h_WebAssemblyModule :: #force_no_inline proc(t: ^_Tramp, slot: int, arg: string, opt := false, kind := "WebAssemblyModule") -> (Api_WebAssemblyModule, bool) {
	raw := u64(t.a[slot].i64)
	api_route(&t.c, raw)
