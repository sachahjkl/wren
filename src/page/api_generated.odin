	a[0] = {}
	return nil
}

// Calls a guest's MicrotaskCallback (a function of its table) as a task of the realm; false when it trapped.
invoke_MicrotaskCallback :: proc(ctx: ^Page, inst: ^wasm.Instance, fn: u32, user: i32) -> bool {
	argv := [1]u32{u32(user)}
	return call_guest(ctx, inst, fn, argv[:1])
}

// A reaction: read the result with Promise_value / Promise_text.
// Calls a guest's PromiseReaction (a function of its table) as a task of the realm; false when it trapped.
invoke_PromiseReaction :: proc(ctx: ^Page, inst: ^wasm.Instance, fn: u32, user: i32, promise: u64, state: Api_PromiseState) -> bool {
	argv := [4]u32{u32(user), u32(u64(promise)), u32(u64(promise) >> 32), u32(state)}
	return call_guest(ctx, inst, fn, argv[:4])
}

// A listener: `user` is the value given to addEventListener.
// Calls a guest's EventListener (a function of its table) as a task of the realm; false when it trapped.
invoke_EventListener :: proc(ctx: ^Page, inst: ^wasm.Instance, fn: u32, user: i32, event: u64) -> bool {
	argv := [3]u32{u32(user), u32(u64(event)), u32(u64(event) >> 32)}
	return call_guest(ctx, inst, fn, argv[:3])
}

// Called when the response arrives (Response), when the body is complete (Done) or on failure (Failed).
// Calls a guest's FetchCallback (a function of its table) as a task of the realm; false when it trapped.
invoke_FetchCallback :: proc(ctx: ^Page, inst: ^wasm.Instance, fn: u32, user: i32, request: u64, state: Api_FetchState) -> bool {
	argv := [4]u32{u32(user), u32(u64(request)), u32(u64(request) >> 32), u32(state)}
	return call_guest(ctx, inst, fn, argv[:4])
}

// A function of the realm the browser calls when a kind of timeline entry it was asked for (Performance_timelineInterest)
// has new entries: `kinds` has one bit for each (1 << PerformanceEntryType).
// Calls a guest's TimelineCallback (a function of its table) as a task of the realm; false when it trapped.
invoke_TimelineCallback :: proc(ctx: ^Page, inst: ^wasm.Instance, fn: u32, user: i32, kinds: i32) -> bool {
	argv := [2]u32{u32(user), u32(kinds)}
	return call_guest(ctx, inst, fn, argv[:2])
}

// Calls a guest's TimerHandler (a function of its table) as a task of the realm; false when it trapped.
invoke_TimerHandler :: proc(ctx: ^Page, inst: ^wasm.Instance, fn: u32, user: i32) -> bool {
	argv := [1]u32{u32(user)}
	return call_guest(ctx, inst, fn, argv[:1])
}

// A timer callback with a 64-bit user value.
// Calls a guest's TimerHandler64 (a function of its table) as a task of the realm; false when it trapped.
invoke_TimerHandler64 :: proc(ctx: ^Page, inst: ^wasm.Instance, fn: u32, user: i64) -> bool {
	argv := [2]u32{u32(u64(user)), u32(u64(user) >> 32)}
	return call_guest(ctx, inst, fn, argv[:2])
}

// An animation frame callback: `time` is the frame's time on the page's performance timeline.
// Calls a guest's FrameRequestCallback (a function of its table) as a task of the realm; false when it trapped.
invoke_FrameRequestCallback :: proc(ctx: ^Page, inst: ^wasm.Instance, fn: u32, user: i32, time: f64) -> bool {
	argv := [3]u32{u32(user), u32(transmute(u64)time), u32(transmute(u64)time >> 32)}
	return call_guest(ctx, inst, fn, argv[:3])
}

// An idle callback: run before `deadline` (performance timeline), or late because its timeout expired.
// Calls a guest's IdleRequestCallback (a function of its table) as a task of the realm; false when it trapped.
invoke_IdleRequestCallback :: proc(ctx: ^Page, inst: ^wasm.Instance, fn: u32, user: i32, deadline: f64, did_timeout: bool) -> bool {
	argv := [4]u32{u32(user), u32(transmute(u64)deadline), u32(transmute(u64)deadline >> 32), u32(1 if did_timeout else 0)}
	return call_guest(ctx, inst, fn, argv[:4])
}

// Called once the module is instantiated in a page (after the document is parsed), if the module exports it.
// Calls the guest's export wb_main as a task of the realm.
export_wb_main :: proc(ctx: ^Page, inst: ^wasm.Instance) -> wasm.Call_Result {
	res := call_export(ctx, inst, "wb_main", nil)
	return res
}

