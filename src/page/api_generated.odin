// Calls a guest's MicrotaskCallback (a function of its table) as a task of the realm; false when it trapped.
invoke_MicrotaskCallback :: proc(ctx: ^Page, inst: ^wasm.Instance, fn: u32, user: i32) -> bool {
	argv := [1]u32{u32(user)}
	return call_guest(ctx, inst, fn, argv[:1])
}

// A reaction: read the result with Promise_value / Promise_text.
// Calls a guest's PromiseReaction (a function of its table) as a task of the realm; false when it trapped.
invoke_PromiseReaction :: proc(ctx: ^Page, inst: ^wasm.Instance, fn: u32, user: i32, promise: u64, state: Api_PromiseState) -> bool {
	argv := [4]u32{u32(user), u32(u64(promise)), u32(u64(promise) >> 32), u32(state)}
	return call_guest(ctx, inst, fn, argv[:4])
}

// A listener: `user` is the value given to addEventListener.
// Calls a guest's EventListener (a function of its table) as a task of the realm; false when it trapped.
invoke_EventListener :: proc(ctx: ^Page, inst: ^wasm.Instance, fn: u32, user: i32, event: u64) -> bool {
	argv := [3]u32{u32(user), u32(u64(event)), u32(u64(event) >> 32)}
	return call_guest(ctx, inst, fn, argv[:3])
}

// requestVideoFrameCallback's callback: `now` is the current time on the page's performance timeline (the callback
// reads the rest of the metadata back with HTMLVideoElement_videoFrameMetadata, keyed by the id this call made).
// Calls a guest's VideoFrameRequestCallback (a function of its table) as a task of the realm; false when it trapped.
invoke_VideoFrameRequestCallback :: proc(ctx: ^Page, inst: ^wasm.Instance, fn: u32, user: i32, now: f64) -> bool {
	argv := [3]u32{u32(user), u32(transmute(u64)now), u32(transmute(u64)now >> 32)}
	return call_guest(ctx, inst, fn, argv[:3])
}

// Called when the response arrives (Response), as the body arrives (Body: at most every 50 ms, the first part at once;
// Fetch_bodyLength and Fetch_readBody read what is there), when the body is complete (Done) or on failure (Failed).
// Calls a guest's FetchCallback (a function of its table) as a task of the realm; false when it trapped.
invoke_FetchCallback :: proc(ctx: ^Page, inst: ^wasm.Instance, fn: u32, user: i32, request: u64, state: Api_FetchState) -> bool {
	argv := [4]u32{u32(user), u32(u64(request)), u32(u64(request) >> 32), u32(state)}
	return call_guest(ctx, inst, fn, argv[:4])
}

// A function of the realm the browser calls when a kind of timeline entry it was asked for (Performance_timelineInterest)
// has new entries: `kinds` has one bit for each (1 << PerformanceEntryType).
// Calls a guest's TimelineCallback (a function of its table) as a task of the realm; false when it trapped.
invoke_TimelineCallback :: proc(ctx: ^Page, inst: ^wasm.Instance, fn: u32, user: i32, kinds: i32) -> bool {
	argv := [2]u32{u32(user), u32(kinds)}
	return call_guest(ctx, inst, fn, argv[:2])
}

// Calls a guest's TimerHandler (a function of its table) as a task of the realm; false when it trapped.
invoke_TimerHandler :: proc(ctx: ^Page, inst: ^wasm.Instance, fn: u32, user: i32) -> bool {
	argv := [1]u32{u32(user)}
	return call_guest(ctx, inst, fn, argv[:1])
}

// A timer callback with a 64-bit user value.
// Calls a guest's TimerHandler64 (a function of its table) as a task of the realm; false when it trapped.
invoke_TimerHandler64 :: proc(ctx: ^Page, inst: ^wasm.Instance, fn: u32, user: i64) -> bool {
	argv := [2]u32{u32(u64(user)), u32(u64(user) >> 32)}
	return call_guest(ctx, inst, fn, argv[:2])
}

// An animation frame callback: `time` is the frame's time on the page's performance timeline.
// Calls a guest's FrameRequestCallback (a function of its table) as a task of the realm; false when it trapped.
invoke_FrameRequestCallback :: proc(ctx: ^Page, inst: ^wasm.Instance, fn: u32, user: i32, time: f64) -> bool {
	argv := [3]u32{u32(user), u32(transmute(u64)time), u32(transmute(u64)time >> 32)}
	return call_guest(ctx, inst, fn, argv[:3])
}

// An idle callback: run before `deadline` (performance timeline), or late because its timeout expired.
// Calls a guest's IdleRequestCallback (a function of its table) as a task of the realm; false when it trapped.
invoke_IdleRequestCallback :: proc(ctx: ^Page, inst: ^wasm.Instance, fn: u32, user: i32, deadline: f64, did_timeout: bool) -> bool {
	argv := [4]u32{u32(user), u32(transmute(u64)deadline), u32(transmute(u64)deadline >> 32), u32(1 if did_timeout else 0)}
	return call_guest(ctx, inst, fn, argv[:4])
}

// What the render thread has to say: kind 1 the state changed (value: 0 suspended, 1 running, 2 closed), 2 a source
// ended, 3 a block of a ScriptProcessorNode is ready, 4 an offline rendering stopped at a suspend().
// Calls a guest's WebAudioNotify (a function of its table) as a task of the realm; false when it trapped.
invoke_WebAudioNotify :: proc(ctx: ^Page, inst: ^wasm.Instance, fn: u32, user: i32, kind: i32, node: i32, value: i32) -> bool {
	argv := [4]u32{u32(user), u32(kind), u32(node), u32(value)}
	return call_guest(ctx, inst, fn, argv[:4])
}

// Calls a guest's AudioDecoderOutput (a function of its table) as a task of the realm; false when it trapped.
invoke_AudioDecoderOutput :: proc(ctx: ^Page, inst: ^wasm.Instance, fn: u32, user: i32, data: u64) -> bool {
	argv := [3]u32{u32(user), u32(u64(data)), u32(u64(data) >> 32)}
	return call_guest(ctx, inst, fn, argv[:3])
}

// Calls a guest's AudioDecoderError (a function of its table) as a task of the realm; false when it trapped.
invoke_AudioDecoderError :: proc(ctx: ^Page, inst: ^wasm.Instance, fn: u32, user: i32, code: i32) -> bool {
	argv := [2]u32{u32(user), u32(code)}
	return call_guest(ctx, inst, fn, argv[:2])
}

// Calls a guest's VideoEncoderOutput (a function of its table) as a task of the realm; false when it trapped.
invoke_VideoEncoderOutput :: proc(ctx: ^Page, inst: ^wasm.Instance, fn: u32, user: i32, chunk: u64) -> bool {
	argv := [3]u32{u32(user), u32(u64(chunk)), u32(u64(chunk) >> 32)}
	return call_guest(ctx, inst, fn, argv[:3])
}

// Calls a guest's VideoEncoderError (a function of its table) as a task of the realm; false when it trapped.
invoke_VideoEncoderError :: proc(ctx: ^Page, inst: ^wasm.Instance, fn: u32, user: i32, code: i32) -> bool {
	argv := [2]u32{u32(user), u32(code)}
	return call_guest(ctx, inst, fn, argv[:2])
}

// Calls a guest's AudioEncoderOutput (a function of its table) as a task of the realm; false when it trapped.
invoke_AudioEncoderOutput :: proc(ctx: ^Page, inst: ^wasm.Instance, fn: u32, user: i32, chunk: u64) -> bool {
	argv := [3]u32{u32(user), u32(u64(chunk)), u32(u64(chunk) >> 32)}
	return call_guest(ctx, inst, fn, argv[:3])
}

// Calls a guest's AudioEncoderError (a function of its table) as a task of the realm; false when it trapped.
invoke_AudioEncoderError :: proc(ctx: ^Page, inst: ^wasm.Instance, fn: u32, user: i32, code: i32) -> bool {
	argv := [2]u32{u32(user), u32(code)}
	return call_guest(ctx, inst, fn, argv[:2])
}

// output(frame) and error(code) callbacks. The frame handle is a VideoFrame the guest must close.
// Calls a guest's VideoDecoderOutput (a function of its table) as a task of the realm; false when it trapped.
invoke_VideoDecoderOutput :: proc(ctx: ^Page, inst: ^wasm.Instance, fn: u32, user: i32, frame: u64) -> bool {
	argv := [3]u32{u32(user), u32(u64(frame)), u32(u64(frame) >> 32)}
	return call_guest(ctx, inst, fn, argv[:3])
}

// Calls a guest's VideoDecoderError (a function of its table) as a task of the realm; false when it trapped.
invoke_VideoDecoderError :: proc(ctx: ^Page, inst: ^wasm.Instance, fn: u32, user: i32, code: i32) -> bool {
	argv := [2]u32{u32(user), u32(code)}
	return call_guest(ctx, inst, fn, argv[:2])
}

// What a context has to say: kind 1 it was lost.
// Calls a guest's WebGLNotify (a function of its table) as a task of the realm; false when it trapped.
invoke_WebGLNotify :: proc(ctx: ^Page, inst: ^wasm.Instance, fn: u32, user: i32, kind: i32) -> bool {
	argv := [2]u32{u32(user), u32(kind)}
	return call_guest(ctx, inst, fn, argv[:2])
}

// Called once the module is instantiated in a page (after the document is parsed), if the module exports it.
// Calls the guest's export wb_main as a task of the realm.
export_wb_main :: proc(ctx: ^Page, inst: ^wasm.Instance) -> wasm.Call_Result {
	res := call_export(ctx, inst, "wb_main", nil)
	return res
}

