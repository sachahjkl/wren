@(private = "file")
_end_out_str :: #force_no_inline proc(t: ^_Tramp, o: ^_Out, bytes: []u8, err: Api_Error) -> wasm.Trap {
	api_end(&t.c)
	if tr := wasm.take_trap(t.f.inst); tr != nil {
		if t.c.routed { api_unroute(&t.c) }
		return tr
	}
	if err != .None { return _fail(t, err, t.c.message) }
	copy(o.buf, bytes)
	if t.c.routed && len(bytes) > len(o.buf) { t.c.caller.route_next = t.c.tag }
	if len(bytes) > len(o.buf) { wasm.oversized_keep(t.f.inst, o.id, _digest(&t.f, t.a, o.desc), bytes) }
	wasm.put_size(&t.f, t.a, i64(len(bytes)))
	if t.c.routed { api_unroute(&t.c) }
	return nil
}

@(private = "file")
_end_out_str_ok :: #force_no_inline proc(t: ^_Tramp, o: ^_Out, bytes: []u8) -> wasm.Trap {
	api_end(&t.c)
	if tr := wasm.take_trap(t.f.inst); tr != nil {
		if t.c.routed { api_unroute(&t.c) }
		return tr
	}
	copy(o.buf, bytes)
	if t.c.routed && len(bytes) > len(o.buf) { t.c.caller.route_next = t.c.tag }
	if len(bytes) > len(o.buf) { wasm.oversized_keep(t.f.inst, o.id, _digest(&t.f, t.a, o.desc), bytes) }
	wasm.put_size(&t.f, t.a, i64(len(bytes)))
	if t.c.routed { api_unroute(&t.c) }
	return nil
}

@(private = "file")
_end_ret_u8 :: #force_no_inline proc(t: ^_Tramp, rs: [^]u8, v: u8, err: Api_Error) -> wasm.Trap {
	api_end(&t.c)
	if tr := wasm.take_trap(t.f.inst); tr != nil {
		if t.c.routed { api_unroute(&t.c) }
		return tr
	}
	if err != .None { return _fail(t, err, t.c.message) }
	intrinsics.unaligned_store((^u8)(rs), v)
	if t.c.routed { api_unroute(&t.c) }
	t.a[0] = {}
	return nil
}

