@(private = "file")
numbers :: proc() -> string {
	b := strings.builder_make(context.temp_allocator)
	for i in 0 ..< 300 {
		if i > 0 { strings.write_byte(&b, ' ') }
		fmt.sbprintf(&b, "%d", (i * 7919) % 10007)
	}
	return strings.to_string(b)
}

@(private = "file")
inflate_all :: proc(format: Format, data: []u8, step: int) -> (out: [dynamic]u8, err: Error) {
	z: Inflater
	inflater_init(&z, format)
	defer inflater_destroy(&z)
	out = make([dynamic]u8)
	for i := 0; i < len(data); i += step {
		if err = inflate_push(&z, data[i:min(i + step, len(data))], &out); err != .None { return }
	}
	err = inflate_finish(&z)
	return
}

@(test)
inflates_dynamic_codes_in_any_chunks :: proc(t: ^testing.T) {
	want := numbers()
	for step in ([]int{len(DOTNET_GZIP), 1, 7, 100}) {
		out, err := inflate_all(.Gzip, DOTNET_GZIP[:], step)
		testing.expectf(t, err == .None && string(out[:]) == want, "chunks of %d: %v, %d bytes", step, err, len(out))
		delete(out)
	}
	cut, err := inflate_all(.Gzip, DOTNET_GZIP[:len(DOTNET_GZIP) - 3], 50)
	testing.expect(t, err == .Truncated, "cut before its end")
	delete(cut)
	bad := DOTNET_GZIP
	bad[len(bad) - 6] ~= 0xFF   // the CRC
	broken, err2 := inflate_all(.Gzip, bad[:], 50)
	testing.expect(t, err2 == .Bad_Data, "a wrong CRC")
	delete(broken)
	extra := make([dynamic]u8)
	defer delete(extra)
	append(&extra, ..DOTNET_GZIP[:])
	append(&extra, 0)
	junk, err3 := inflate_all(.Gzip, extra[:], 64)
	testing.expect(t, err3 == .Junk_After_End, "data after the end")
	delete(junk)
}

@(test)
round_trips :: proc(t: ^testing.T) {
	inputs := []string{"", "a", numbers(), strings.repeat("Wren ", 20_000, context.temp_allocator), "été \x00\xff binary"}
	for format in Format {
		for input in inputs {
			d: Deflater
			deflater_init(&d, format)
			packed := make([dynamic]u8)
			// in chunks of 1000 bytes, as a stream would give them
			for i := 0; i < len(input); i += 1000 { deflate_push(&d, transmute([]u8)input[i:min(i + 1000, len(input))], &packed) }
			deflate_finish(&d, &packed)
			deflater_destroy(&d)
			out, err := inflate_all(format, packed[:], 333)
			testing.expectf(t, err == .None && string(out[:]) == input, "%v, %d bytes: %v", format, len(input), err)
			if len(input) == 100_000 { testing.expectf(t, len(packed) < 2000, "repetitive text compresses: %d bytes", len(packed)) }
			delete(out)
			delete(packed)
		}
	}
}

@(test)
bounded_output :: proc(t: ^testing.T) {
	d: Deflater
	deflater_init(&d, .Raw)
	packed := make([dynamic]u8)
	defer delete(packed)
	big := strings.repeat("x", 1 << 20, context.temp_allocator)
	deflate_push(&d, transmute([]u8)big, &packed)
	deflate_finish(&d, &packed)
	deflater_destroy(&d)
	z: Inflater
	inflater_init(&z, .Raw, limit = 64 * 1024)
	defer inflater_destroy(&z)
	out := make([dynamic]u8)
	defer delete(out)
	testing.expect(t, inflate_push(&z, packed[:], &out) == .Too_Large, "a small input that inflates past the bound")
}
