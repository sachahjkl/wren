@(export) case_297 :: proc "contextless" () -> i64 {
	buf := i32(uintptr(&OUT[0]))
	n := i64(c_Location_get(0, buf, 0))
	if n < 0 { return 1 }   // an error: nothing to measure
	if n > i64(len(OUT)) - 16 { return 2 }
	for &b in OUT { b = 0xAA }
	half := i32(n / 2)
	if i64(c_Location_get(0, buf, half)) != n { return -1 }   // the full length, whatever the capacity
	for i in int(half) ..< int(half) + 16 { if OUT[i] != 0xAA { return -2 } }   // nothing past the capacity
	if i64(c_Location_get(0, buf, i32(n))) != n { return -3 }
	for i in int(n) ..< int(n) + 16 { if OUT[i] != 0xAA { return -4 } }
	return 0
}
