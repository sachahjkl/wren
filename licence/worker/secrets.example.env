# Copy to secrets.env (production) or secrets.sandbox.env (Paddle sandbox) and fill in. Those files are git-ignored.
# Never put these values in wrangler.jsonc.

# The line of %USERPROFILE%\.wren-license\private.key that is not a # comment (tools\license.ps1 keygen)
LICENSE_PRIVATE_KEY=
# Paddle > Developer tools > Notifications > the destination > Secret key (pdl_ntfset_...)
PADDLE_WEBHOOK_SECRET=
# Paddle > Developer tools > Authentication > API keys (server side; needs "customer.read")
PADDLE_API_KEY=
# (no mail key: the licence is mailed through the Cloudflare Email Service binding, see MAIL_FROM)

# Optional. A bearer token for the admin endpoints (/admin/dead-letter, /admin/dead-letter/retry) and, when
# RESEND_REQUIRE_TOKEN=true, for /resend. Unset = those endpoints are closed. Make it long and random.
ADMIN_TOKEN=
# Optional. The shared secret the mail provider's delivery (bounce) webhook sends, in the X-Bounce-Secret header or as
# a bearer token, to POST /mail/bounce. Unset = that endpoint is closed. (Cloudflare Email Service has no such webhook
# today; this is for a provider that does, or for marking a bounce by hand.)
MAIL_BOUNCE_SECRET=
