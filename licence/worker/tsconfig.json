{
	"compilerOptions": {
		"target": "ES2023",
		"lib": ["ES2023", "DOM"],
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"allowImportingTsExtensions": true,
		"noEmit": true,
		"strict": true,
		"verbatimModuleSyntax": true,
		"erasableSyntaxOnly": true,
		"types": ["node"]
	},
	"include": ["src", "test"]
}
