// The Wren User Licence Worker. Setup: licence/worker/README.md and docs/licence.md.
//
// Secrets are NOT written here (this file is committed): LICENSE_PRIVATE_KEY, PADDLE_WEBHOOK_SECRET, PADDLE_API_KEY.
// Put them in secrets.env (git-ignored, see secrets.example.env) and deploy with it. The mail goes through Cloudflare
// Email Service (the "send_email" binding): no key, but MAIL_FROM must be on a domain onboarded in Email Sending.
//
// The top level is production (live Paddle). `--env sandbox` is a second Worker with its own KV for testing with
// Paddle's sandbox: other ids, other keys, other webhook secret.
{
	"name": "wren-licence",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-01",
	"workers_dev": true,
	"observability": { "enabled": true },

	// No id: the deploy creates the namespace (or: create it yourself and add "id").
	"kv_namespaces": [{ "binding": "LICENSES" }],

	// One LicenseOrder Durable Object per transaction serialises a purchase (atomic idempotence, the mail retry queue
	// through its alarm, the RGPD purge). SQLite-backed storage, declared in a migration below.
	"durable_objects": { "bindings": [{ "name": "ORDERS", "class_name": "LicenseOrder" }] },
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["LicenseOrder"] }],

	// Cloudflare Email Service. Sending to buyers (anyone) needs the Workers Paid plan; on the free plan only verified
	// destination addresses of the account work. `wrangler dev` only logs the mail; add "remote": true to send for real.
	"send_email": [{ "name": "EMAIL" }],

	"vars": {
		"PADDLE_API_BASE": "https://api.paddle.com",
		"PRICE_SUPPORTER": "pri_01m6kfkhzrwvx28tr378f8ztr3",
		"PRICE_PATRON": "",
		"LICENSE_PUBLIC_KEY": "6vZ2PkrA6JVQvH9T9O9wffaz_SmFcChOaHcMW61LoqI",
		"MAIL_FROM": "Wren <licences@mail.froment.software>",
		"MAIL_REPLY_TO": "contact@froment.software",
		"ALLOWED_ORIGIN": "https://wren.froment.software,https://sachahjkl.github.io",
		"WEBHOOK_TOLERANCE_SECONDS": "300",
		"RESEND_ENABLED": "false",
		"RESEND_MAX_PER_HOUR": "3",
		"RESEND_REQUIRE_TOKEN": "false",
		"MAIL_BACKOFF_MINUTES": "1,5,30,120,720,2880",
		"MAIL_MAX_ATTEMPTS": "7",
		"PII_RETENTION_DAYS": "90"
	},

	"env": {
		"sandbox": {
			"name": "wren-licence-sandbox",
			"workers_dev": true,
			"observability": { "enabled": true },
			"kv_namespaces": [{ "binding": "LICENSES" }],
			"durable_objects": { "bindings": [{ "name": "ORDERS", "class_name": "LicenseOrder" }] },
			"migrations": [{ "tag": "v1", "new_sqlite_classes": ["LicenseOrder"] }],
			"send_email": [{ "name": "EMAIL" }],
			"vars": {
				"PADDLE_API_BASE": "https://sandbox-api.paddle.com",
				"PRICE_SUPPORTER": "pri_01m6kd3nvpkemxgwamft6z2fjw",
				"PRICE_PATRON": "",
				"LICENSE_PUBLIC_KEY": "NLbdwv2jpoDIMu5pVxyjYBUMEu2Lvfd8StzxR0PGqs8",
				"MAIL_FROM": "Wren <licences@mail.froment.software>",
				"MAIL_REPLY_TO": "contact@froment.software",
				"ALLOWED_ORIGIN": "https://wren.froment.software,https://sachahjkl.github.io,http://localhost:8765",
				"WEBHOOK_TOLERANCE_SECONDS": "300",
				"RESEND_ENABLED": "false",
				"RESEND_MAX_PER_HOUR": "3",
				"RESEND_REQUIRE_TOKEN": "false",
				"MAIL_BACKOFF_MINUTES": "1,5,30,120,720,2880",
				"MAIL_MAX_ATTEMPTS": "7",
				"PII_RETENTION_DAYS": "90"
			}
		}
	}
}
