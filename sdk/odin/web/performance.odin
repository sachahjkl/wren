	Mark = 1,
	Measure = 2,
	Navigation = 3,
	Resource = 4,
	Paint = 5,
	Event = 6,
	First_Input = 7,
	Long_Task = 8,
	Largest_Contentful_Paint = 9,
	Layout_Shift = 10,
	Element = 11,
	Visibility_State = 12,
	Long_Animation_Frame = 13,
	Script = 14,
}

