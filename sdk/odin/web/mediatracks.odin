TextTrack_mode_alloc :: proc(track: TextTrack, allocator: runtime.Allocator) -> (string, Error) {
	cap := 64
	for _ in 0 ..< 4 {
		buf := make([]u8, cap, allocator)
		n := _TextTrack_mode(track, raw_data(buf), u32(len(buf)))
		if n < 0 { delete(buf, allocator); return {}, Error(n) }
		if int(n) <= cap { return string(buf[:n]), .None }
		delete(buf, allocator)
		cap = int(n)
	}
	return {}, .Truncated
}

TextTrack_set_mode :: proc "contextless" (track: TextTrack, value: string) {
	_TextTrack_set_mode(track, raw_data(value), u32(len(value)))
}

// track.cues / activeCues: a TextTrackCueList (0: the track is disabled).
