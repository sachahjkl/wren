Node_nodeType :: proc "contextless" (node: $T_node) -> i32 where intrinsics.type_is_integer(intrinsics.type_core_type(T_node)) && size_of(T_node) == 8 {
	return _Node_nodeType(u64(node))
}

// node.textContent = text
Node_setTextContent :: proc "contextless" (node: $T_node, text: string) -> Error where intrinsics.type_is_integer(intrinsics.type_core_type(T_node)) && size_of(T_node) == 8 {
	return _Node_setTextContent(u64(node), raw_data(text), u32(len(text)))
}

// node.textContent
Node_getTextContent :: proc "contextless" (node: $T_node, buf: []u8) -> (string, Error) where intrinsics.type_is_integer(intrinsics.type_core_type(T_node)) && size_of(T_node) == 8 {
	n := _Node_getTextContent(u64(node), raw_data(buf), u32(len(buf)))
	if n < 0 { return {}, Error(n) }
	if int(n) > len(buf) { return string(buf), .Truncated }
	return string(buf[:n]), .None
}

// The full length of Node_getTextContent's result.
Node_getTextContent_len :: proc "contextless" (node: $T_node) -> (int, Error) where intrinsics.type_is_integer(intrinsics.type_core_type(T_node)) && size_of(T_node) == 8 {
	n := _Node_getTextContent(u64(node), nil, 0)
	if n < 0 { return 0, Error(n) }
	return int(n), .None
}

// Node_getTextContent's result in a buffer allocated to fit.
Node_getTextContent_alloc :: proc(node: $T_node, allocator: runtime.Allocator) -> (string, Error) where intrinsics.type_is_integer(intrinsics.type_core_type(T_node)) && size_of(T_node) == 8 {
	cap := 64
	for _ in 0 ..< 4 {
		buf := make([]u8, cap, allocator)
		n := _Node_getTextContent(u64(node), raw_data(buf), u32(len(buf)))
		if n < 0 { delete(buf, allocator); return {}, Error(n) }
		if int(n) <= cap { return string(buf[:n]), .None }
		delete(buf, allocator)
		cap = int(n)
	}
	return {}, .Truncated
}

