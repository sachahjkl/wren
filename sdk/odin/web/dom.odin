		buf := make([]u8, cap, allocator)
		n := _Document_resolveURL(raw_data(url), u32(len(url)), raw_data(buf), u32(len(buf)))
		if n < 0 { delete(buf, allocator); return {}, Error(n) }
		if int(n) <= cap { return string(buf[:n]), .None }
		delete(buf, allocator)
		cap = int(n)
	}
	return {}, .Truncated
}

