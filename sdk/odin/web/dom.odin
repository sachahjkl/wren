// document.documentElement (null in a worker).
Document_documentElement :: proc "contextless" () -> Element {
	return _Document_documentElement()
}

// document.head (null in a worker).
Document_head :: proc "contextless" () -> Element {
	return _Document_head()
}

// document.body (null in a worker).
Document_body :: proc "contextless" () -> Element {
	return _Document_body()
}

// document.createElement(tag). Invalid_Argument for an empty tag, Invalid_Handle in a worker (no document).
Document_createElement :: proc "contextless" (tag: string) -> (result: Element, err: Error) {
	err = _Document_createElement(raw_data(tag), u32(len(tag)), &result)
	return
}

// document.createTextNode(text). Invalid_Handle in a worker.
Document_createTextNode :: proc "contextless" (text: string) -> (result: Node, err: Error) {
	err = _Document_createTextNode(raw_data(text), u32(len(text)), &result)
	return
}

// document.getElementById(id): null when there is none.
Document_getElementById :: proc "contextless" (id: string) -> Element {
	return _Document_getElementById(raw_data(id), u32(len(id)))
}

// parent.appendChild(child).
Node_appendChild :: proc "contextless" (parent: $T_parent, child: $T_child) -> Error where intrinsics.type_is_integer(intrinsics.type_core_type(T_parent)) && size_of(T_parent) == 8 && intrinsics.type_is_integer(intrinsics.type_core_type(T_child)) && size_of(T_child) == 8 {
	return _Node_appendChild(u64(parent), u64(child))
}

// parent.insertBefore(child, ref): ref null appends. Not_Found when ref is not a child of parent.
Node_insertBefore :: proc "contextless" (parent: $T_parent, child: $T_child, ref: $T_ref) -> Error where intrinsics.type_is_integer(intrinsics.type_core_type(T_parent)) && size_of(T_parent) == 8 && intrinsics.type_is_integer(intrinsics.type_core_type(T_child)) && size_of(T_child) == 8 && intrinsics.type_is_integer(intrinsics.type_core_type(T_ref)) && size_of(T_ref) == 8 {
	return _Node_insertBefore(u64(parent), u64(child), u64(ref))
}

// parent.removeChild(child). Not_Found when child is not a child of parent.
Node_removeChild :: proc "contextless" (parent: $T_parent, child: $T_child) -> Error where intrinsics.type_is_integer(intrinsics.type_core_type(T_parent)) && size_of(T_parent) == 8 && intrinsics.type_is_integer(intrinsics.type_core_type(T_child)) && size_of(T_child) == 8 {
	return _Node_removeChild(u64(parent), u64(child))
}

// Frees a detached node (and its subtree) the module no longer needs. Attached when it is still in the tree.
Node_release :: proc "contextless" (node: $T_node) -> Error where intrinsics.type_is_integer(intrinsics.type_core_type(T_node)) && size_of(T_node) == 8 {
	return _Node_release(u64(node))
}

