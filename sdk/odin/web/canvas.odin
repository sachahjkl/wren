// /////////////////////////////
CanvasPath_closePath :: proc "contextless" (p: CanvasPathTarget) {
	_CanvasPath_closePath(p)
}

CanvasPath_moveTo :: proc "contextless" (p: CanvasPathTarget, x: f64, y: f64) {
	_CanvasPath_moveTo(p, x, y)
}

CanvasPath_lineTo :: proc "contextless" (p: CanvasPathTarget, x: f64, y: f64) {
	_CanvasPath_lineTo(p, x, y)
}

CanvasPath_quadraticCurveTo :: proc "contextless" (p: CanvasPathTarget, cpx: f64, cpy: f64, x: f64, y: f64) {
	_CanvasPath_quadraticCurveTo(p, cpx, cpy, x, y)
}

CanvasPath_bezierCurveTo :: proc "contextless" (p: CanvasPathTarget, cp1x: f64, cp1y: f64, cp2x: f64, cp2y: f64, x: f64, y: f64) {
	_CanvasPath_bezierCurveTo(p, cp1x, cp1y, cp2x, cp2y, x, y)
}

// A negative radius raises Index_Size.
CanvasPath_arcTo :: proc "contextless" (p: CanvasPathTarget, x1: f64, y1: f64, x2: f64, y2: f64, radius: f64) -> Error {
	return _CanvasPath_arcTo(p, x1, y1, x2, y2, radius)
}

CanvasPath_rect :: proc "contextless" (p: CanvasPathTarget, x: f64, y: f64, w: f64, h: f64) {
	_CanvasPath_rect(p, x, y, w, h)
}

// roundRect: `radii` are the 8 numbers of the four corners (upper-left, upper-right, lower-right, lower-left), x
// then y radius each. A negative radius raises Range.
CanvasPath_roundRect :: proc "contextless" (p: CanvasPathTarget, x: f64, y: f64, w: f64, h: f64, radii: []f64) -> Error {
	return _CanvasPath_roundRect(p, x, y, w, h, raw_data(radii), u32(len(radii)))
}

CanvasPath_arc :: proc "contextless" (p: CanvasPathTarget, x: f64, y: f64, radius: f64, start_angle: f64, end_angle: f64, counterclockwise: bool = false) -> Error {
	return _CanvasPath_arc(p, x, y, radius, start_angle, end_angle, i32(1 if counterclockwise else 0))
}

CanvasPath_ellipse :: proc "contextless" (p: CanvasPathTarget, x: f64, y: f64, radius_x: f64, radius_y: f64, rotation: f64, start_angle: f64, end_angle: f64, counterclockwise: bool = false) -> Error {
	return _CanvasPath_ellipse(p, x, y, radius_x, radius_y, rotation, start_angle, end_angle, i32(1 if counterclockwise else 0))
}

// new Path2D(): empty; `from` a Path2D handle to copy (0 for none); `svg` path data (M, L, H, V, C, S, Q, T, A, Z and
// their relative forms) appended when not empty (an invalid string leaves what parsed before the error).
Path2D_create :: proc "contextless" (from: u64, svg: string) -> Path2D {
	return _Path2D_create(from, raw_data(svg), u32(len(svg)))
}

// addPath(path, matrix).
Path2D_addPath :: proc "contextless" (target: Path2D, path: Path2D, m11: f64, m12: f64, m21: f64, m22: f64, m41: f64, m42: f64) {
	_Path2D_addPath(target, path, m11, m12, m21, m22, m41, m42)
}

// /////////////////////////////
// new OffscreenCanvas(width, height): Quota over the limits.
OffscreenCanvas_create :: proc "contextless" (width: u64, height: u64) -> (result: OffscreenCanvas, err: Error) {
	err = _OffscreenCanvas_create(width, height, &result)
	return
}

OffscreenCanvas_width :: proc "contextless" (canvas: OffscreenCanvas) -> u64 {
	return _OffscreenCanvas_width(canvas)
}

OffscreenCanvas_height :: proc "contextless" (canvas: OffscreenCanvas) -> u64 {
	return _OffscreenCanvas_height(canvas)
}

// Sets the size: the canvas is cleared and its context reset. Quota over the limits.
OffscreenCanvas_set_width :: proc "contextless" (canvas: OffscreenCanvas, value: u64) -> Error {
	return _OffscreenCanvas_set_width(canvas, value)
}

OffscreenCanvas_set_height :: proc "contextless" (canvas: OffscreenCanvas, value: u64) -> Error {
	return _OffscreenCanvas_set_height(canvas, value)
}

OffscreenCanvas_context2d :: proc "contextless" (canvas: OffscreenCanvas, alpha: bool, will_read_frequently: bool) -> (result: CanvasRenderingContext2D, err: Error) {
	err = _OffscreenCanvas_context2d(canvas, i32(1 if alpha else 0), i32(1 if will_read_frequently else 0), &result)
	return
}

// transferToImageBitmap(): the pixels move to a new ImageBitmap and the canvas is cleared.
OffscreenCanvas_transferToImageBitmap :: proc "contextless" (canvas: OffscreenCanvas) -> (result: ImageBitmap, err: Error) {
	err = _OffscreenCanvas_transferToImageBitmap(canvas, &result)
	return
}

ImageBitmap_width :: proc "contextless" (bitmap: ImageBitmap) -> u32 {
	return _ImageBitmap_width(bitmap)
}

ImageBitmap_height :: proc "contextless" (bitmap: ImageBitmap) -> u32 {
	return _ImageBitmap_height(bitmap)
}

// bitmap.close(): the pixels are freed; the bitmap is 0 x 0 from then on.
ImageBitmap_close :: proc "contextless" (bitmap: ImageBitmap) {
	_ImageBitmap_close(bitmap)
}

// createImageBitmap(image, sx, sy, sw, sh): `source` as for drawImage, `form` 0 (whole image) or 4 (a rectangle); the
// bitmap is a copy of the pixels now. `flip_y` and `premultiply` follow ImageBitmapOptions. Not_Found: no pixels yet
// (the image is not available); Invalid_State: broken or empty image; Index_Size: an empty rectangle.
Canvas_createBitmap :: proc "contextless" (source: u64, form: i32, sx: f64, sy: f64, sw: f64, sh: f64, flip_y: bool) -> (result: ImageBitmap, err: Error) {
	err = _Canvas_createBitmap(source, form, sx, sy, sw, sh, i32(1 if flip_y else 0), &result)
	return
}

// An ImageBitmap of straight RGBA8 pixels (an ImageData, a decoded Blob).
Canvas_bitmapFromPixels :: proc "contextless" (data: []u8, width: i32, height: i32, flip_y: bool) -> (result: ImageBitmap, err: Error) {
	err = _Canvas_bitmapFromPixels(raw_data(data), u32(len(data)), width, height, i32(1 if flip_y else 0), &result)
	return
}

