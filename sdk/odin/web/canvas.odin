CanvasCompositing_globalCompositeOperation :: proc "contextless" (ctx: CanvasRenderingContext2D, buf: []u8) -> (string, Error) {
	n := _CanvasCompositing_globalCompositeOperation(ctx, raw_data(buf), u32(len(buf)))
	if n < 0 { return {}, Error(n) }
	if int(n) > len(buf) { return string(buf), .Truncated }
	return string(buf[:n]), .None
}

// The full length of CanvasCompositing_globalCompositeOperation's result.
CanvasCompositing_globalCompositeOperation_len :: proc "contextless" (ctx: CanvasRenderingContext2D) -> (int, Error) {
	n := _CanvasCompositing_globalCompositeOperation(ctx, nil, 0)
	if n < 0 { return 0, Error(n) }
	return int(n), .None
}

// CanvasCompositing_globalCompositeOperation's result in a buffer allocated to fit.
CanvasCompositing_globalCompositeOperation_alloc :: proc(ctx: CanvasRenderingContext2D, allocator: runtime.Allocator) -> (string, Error) {
	cap := 64
	for _ in 0 ..< 4 {
		buf := make([]u8, cap, allocator)
		n := _CanvasCompositing_globalCompositeOperation(ctx, raw_data(buf), u32(len(buf)))
		if n < 0 { delete(buf, allocator); return {}, Error(n) }
		if int(n) <= cap { return string(buf[:n]), .None }
		delete(buf, allocator)
		cap = int(n)
	}
	return {}, .Truncated
}

// source-over, source-in, source-out, source-atop, destination-over / -in / -out / -atop, lighter, copy, xor, and the
// blend modes multiply, screen, overlay, darken, lighten, color-dodge, color-burn, hard-light, soft-light, difference,
// exclusion, hue, saturation, color, luminosity. Anything else is ignored.
CanvasCompositing_set_globalCompositeOperation :: proc "contextless" (ctx: CanvasRenderingContext2D, value: string) {
	_CanvasCompositing_set_globalCompositeOperation(ctx, raw_data(value), u32(len(value)))
}

