// /////////////////////////////
// canvas.width: the `width` attribute as HTML parses it (a non-negative integer, 300 when absent or invalid).
HTMLCanvasElement_width :: proc "contextless" (canvas: HTMLCanvasElement) -> u32 {
	return _HTMLCanvasElement_width(canvas)
}

// canvas.width = n: sets the attribute and resets the canvas (cleared, context state back to the default).
HTMLCanvasElement_set_width :: proc "contextless" (canvas: HTMLCanvasElement, value: u32) {
	_HTMLCanvasElement_set_width(canvas, value)
}

// canvas.height: 150 when absent or invalid.
HTMLCanvasElement_height :: proc "contextless" (canvas: HTMLCanvasElement) -> u32 {
	return _HTMLCanvasElement_height(canvas)
}

HTMLCanvasElement_set_height :: proc "contextless" (canvas: HTMLCanvasElement, value: u32) {
	_HTMLCanvasElement_set_height(canvas, value)
}

// getContext("2d", { alpha, willReadFrequently }): the canvas's 2D context, made on the first call (the bitmap is
// allocated then) and the same object afterwards. `alpha` false: an opaque canvas (black until drawn on). Quota when
// the size is over canvas.max_dimension / canvas.max_pixels or the page's canvas memory (canvas.max_page_bytes).
HTMLCanvasElement_context2d :: proc "contextless" (canvas: HTMLCanvasElement, alpha: bool, will_read_frequently: bool) -> (result: CanvasRenderingContext2D, err: Error) {
	err = _HTMLCanvasElement_context2d(canvas, i32(1 if alpha else 0), i32(1 if will_read_frequently else 0), &result)
	return
}

// The canvas (an element, or an OffscreenCanvas handle) encoded as `type`: "image/png", or "image/jpeg" at `quality`
// (0 to 1; outside it the default, canvas.encode.jpeg_quality). Security when the canvas is tainted. An empty buffer
// for a canvas with no pixels (width or height 0).
Canvas_encode :: proc "contextless" (canvas: u64, type: string, quality: f64) -> (result: Buffer, err: Error) {
	err = _Canvas_encode(canvas, raw_data(type), u32(len(type)), quality, &result)
	return
}

