// new FormData(form, submitter): both optional. Invalid_Handle when form is not a form or submitter not one of its
// submit buttons, Invalid_State while the form is constructing its entry list.
FormData_create :: proc "contextless" (form: $T_form, submitter: $T_submitter) -> (result: FormData, err: Error) where intrinsics.type_is_integer(intrinsics.type_core_type(T_form)) && size_of(T_form) == 8 && intrinsics.type_is_integer(intrinsics.type_core_type(T_submitter)) && size_of(T_submitter) == 8 {
	err = _FormData_create(u64(form), u64(submitter), &result)
	return
}

// Invalid_Argument past forms.max_entries.
FormData_append :: proc "contextless" (data: FormData, name: string, value: string) -> Error {
	return _FormData_append(data, raw_data(name), u32(len(name)), raw_data(value), u32(len(value)))
}

// append(name, blob, filename): the bytes of a buffer as a file entry ("blob" when no file name is given).
FormData_appendBlob :: proc "contextless" (data: FormData, name: string, blob: Buffer, filename: string = "", mime: string = "") -> Error {
	return _FormData_appendBlob(data, raw_data(name), u32(len(name)), blob, raw_data(filename), u32(len(filename)), raw_data(mime), u32(len(mime)))
}

// set(name, value): replaces the first entry of that name and removes the others.
FormData_set :: proc "contextless" (data: FormData, name: string, value: string) -> Error {
	return _FormData_set(data, raw_data(name), u32(len(name)), raw_data(value), u32(len(value)))
}

FormData_delete :: proc "contextless" (data: FormData, name: string) {
	_FormData_delete(data, raw_data(name), u32(len(name)))
}

FormData_has :: proc "contextless" (data: FormData, name: string) -> bool {
	return _FormData_has(data, raw_data(name), u32(len(name))) != 0
}

// getAll(name).length
FormData_count :: proc "contextless" (data: FormData, name: string) -> i32 {
	return _FormData_count(data, raw_data(name), u32(len(name)))
}

// get(name): the value (a file entry gives its file name). Not_Found when absent.
