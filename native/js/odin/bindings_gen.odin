@(private = "file") wje_AlphaOption :: proc "contextless" (z: ^[3]cstring) -> [^]cstring { z^ = [3]cstring{ "keep", "discard", nil }; return &z[0] }
@(private = "file") wje_AriaNotifyPriority :: proc "contextless" (z: ^[3]cstring) -> [^]cstring { z^ = [3]cstring{ "normal", "high", nil }; return &z[0] }
@(private = "file") wje_AudioSampleFormat :: proc "contextless" (z: ^[9]cstring) -> [^]cstring { z^ = [9]cstring{ "u8", "s16", "s32", "f32", "u8-planar", "s16-planar", "s32-planar", "f32-planar", nil }; return &z[0] }
@(private = "file") wje_AudioSinkType :: proc "contextless" (z: ^[2]cstring) -> [^]cstring { z^ = [2]cstring{ "none", nil }; return &z[0] }
@(private = "file") wje_BiquadFilterType :: proc "contextless" (z: ^[9]cstring) -> [^]cstring { z^ = [9]cstring{ "lowpass", "highpass", "bandpass", "lowshelf", "highshelf", "peaking", "notch", "allpass", nil }; return &z[0] }
@(private = "file") wje_CSSBoxType :: proc "contextless" (z: ^[5]cstring) -> [^]cstring { z^ = [5]cstring{ "margin", "border", "padding", "content", nil }; return &z[0] }
@(private = "file") wje_ChannelCountMode :: proc "contextless" (z: ^[4]cstring) -> [^]cstring { z^ = [4]cstring{ "max", "clamped-max", "explicit", nil }; return &z[0] }
@(private = "file") wje_ChannelInterpretation :: proc "contextless" (z: ^[3]cstring) -> [^]cstring { z^ = [3]cstring{ "speakers", "discrete", nil }; return &z[0] }
@(private = "file") wje_ClientType :: proc "contextless" (z: ^[5]cstring) -> [^]cstring { z^ = [5]cstring{ "window", "worker", "sharedworker", "all", nil }; return &z[0] }
@(private = "file") wje_ColorSpaceConversion :: proc "contextless" (z: ^[3]cstring) -> [^]cstring { z^ = [3]cstring{ "none", "default", nil }; return &z[0] }
@(private = "file") wje_CompositeOperation :: proc "contextless" (z: ^[4]cstring) -> [^]cstring { z^ = [4]cstring{ "replace", "add", "accumulate", nil }; return &z[0] }
@(private = "file") wje_CookieSameSite :: proc "contextless" (z: ^[4]cstring) -> [^]cstring { z^ = [4]cstring{ "strict", "lax", "none", nil }; return &z[0] }
@(private = "file") wje_CredentialMediationRequirement :: proc "contextless" (z: ^[5]cstring) -> [^]cstring { z^ = [5]cstring{ "silent", "optional", "conditional", "required", nil }; return &z[0] }
