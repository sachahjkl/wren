wjg_SVGElement_get_nonce :: proc "c" (ctx: ^wj.Context, this_val: wj.JSValue) -> wj.JSValue {
	self := wj.wj_this(ctx, this_val, 333)
	if self == nil { return wj.EXCEPTION }
	n := i32(wj.wr_HTMLOrSVGOrMathMLElement_nonce(self.handle, wj.wj_scratch.data, wj.wj_scratch.cap))
	if n > 0 && u32(n) > wj.wj_scratch.cap {
		if wj.wj_scratch_grow(u32(n)) { n = i32(wj.wr_HTMLOrSVGOrMathMLElement_nonce(self.handle, wj.wj_scratch.data, wj.wj_scratch.cap)) } else { n = -13 }
	}
	if n < 0 { return wj.wj_throw_status(ctx, n, "SVGElement.nonce") }
	return wj.JS_NewStringLen(ctx, wj.wj_scratch.data, uint(n))
}

// SVGElement.nonce = v -> dom.HTMLOrSVGOrMathMLElement_set_nonce
wjg_SVGElement_set_nonce :: proc "c" (ctx: ^wj.Context, this_val: wj.JSValue, v: wj.JSValue) -> wj.JSValue {
	self := wj.wj_this(ctx, this_val, 333)
	if self == nil { return wj.EXCEPTION }
	a0: wj.Str
	if !wj.wj_to_str(ctx, v, &a0, 0, "") { return wj.EXCEPTION }
	st := wj.wr_HTMLOrSVGOrMathMLElement_set_nonce(self.handle, (a0.ptr if a0.ptr != nil else wj.empty_ptr()), u32(a0.len))
	wj.wj_str_free(ctx, &a0)
	if st < 0 { return wj.wj_throw_status(ctx, i32(st), "SVGElement.nonce") }
	return wj.UNDEFINED
}

