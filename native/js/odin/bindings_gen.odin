	wjd_AudioNodeOptions_free(ctx, &d.base)
}

wjd_DynamicsCompressorOptions_from :: proc "c" (ctx: ^wj.Context, v: wj.JSValue, out: ^wjd_DynamicsCompressorOptions) -> bool {
	out^ = {}
	if !wjd_AudioNodeOptions_from(ctx, v, &out.base) { wjd_DynamicsCompressorOptions_free(ctx, out); return false }
	is_object := wj.is_object(v)
	if !is_object && !wj.is_undefined(v) && !wj.is_null(v) { wj.JS_ThrowTypeError(ctx, "The provided value is not of type 'DynamicsCompressorOptions'."); { wjd_DynamicsCompressorOptions_free(ctx, out); return false } }
	{
		x := wj.JS_GetPropertyStr(ctx, v, "attack") if is_object else wj.UNDEFINED
		if wj.is_exception(x) { wjd_DynamicsCompressorOptions_free(ctx, out); return false }
		if wj.is_undefined(x) {
			out.attack = 0.003
		} else {
			ok := wj.wj_to_double(ctx, x, &out.attack, true)
			if !ok { wj.JS_FreeValue(ctx, x); wjd_DynamicsCompressorOptions_free(ctx, out); return false }
		}
		wj.JS_FreeValue(ctx, x)
	}
	{
		x := wj.JS_GetPropertyStr(ctx, v, "knee") if is_object else wj.UNDEFINED
		if wj.is_exception(x) { wjd_DynamicsCompressorOptions_free(ctx, out); return false }
		if wj.is_undefined(x) {
			out.knee = 30
		} else {
			ok := wj.wj_to_double(ctx, x, &out.knee, true)
			if !ok { wj.JS_FreeValue(ctx, x); wjd_DynamicsCompressorOptions_free(ctx, out); return false }
		}
		wj.JS_FreeValue(ctx, x)
	}
	{
		x := wj.JS_GetPropertyStr(ctx, v, "ratio") if is_object else wj.UNDEFINED
		if wj.is_exception(x) { wjd_DynamicsCompressorOptions_free(ctx, out); return false }
		if wj.is_undefined(x) {
			out.ratio = 12
		} else {
			ok := wj.wj_to_double(ctx, x, &out.ratio, true)
			if !ok { wj.JS_FreeValue(ctx, x); wjd_DynamicsCompressorOptions_free(ctx, out); return false }
		}
		wj.JS_FreeValue(ctx, x)
	}
	{
		x := wj.JS_GetPropertyStr(ctx, v, "release") if is_object else wj.UNDEFINED
		if wj.is_exception(x) { wjd_DynamicsCompressorOptions_free(ctx, out); return false }
		if wj.is_undefined(x) {
			out.release = 0.25
		} else {
			ok := wj.wj_to_double(ctx, x, &out.release, true)
			if !ok { wj.JS_FreeValue(ctx, x); wjd_DynamicsCompressorOptions_free(ctx, out); return false }
		}
		wj.JS_FreeValue(ctx, x)
	}
	{
		x := wj.JS_GetPropertyStr(ctx, v, "threshold") if is_object else wj.UNDEFINED
		if wj.is_exception(x) { wjd_DynamicsCompressorOptions_free(ctx, out); return false }
		if wj.is_undefined(x) {
			out.threshold = -24
		} else {
			ok := wj.wj_to_double(ctx, x, &out.threshold, true)
			if !ok { wj.JS_FreeValue(ctx, x); wjd_DynamicsCompressorOptions_free(ctx, out); return false }
		}
		wj.JS_FreeValue(ctx, x)
	}
	return true
}

