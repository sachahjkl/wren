@(private = "file")
wjg_event_get :: proc "c" (ctx: ^wj.Context, this_val: wj.JSValue, magic: i32) -> wj.JSValue {
	d := &wjg_events[magic]
	return wj_event_handler_get(ctx, this_val, i32(d.iface), d.event)
}

@(private = "file")
wjg_event_set :: proc "c" (ctx: ^wj.Context, this_val: wj.JSValue, v: wj.JSValue, magic: i32) -> wj.JSValue {
	d := &wjg_events[magic]
	return wj_event_handler_set(ctx, this_val, i32(d.iface), d.event, v, i32(d.spec))
}

