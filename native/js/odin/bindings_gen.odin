@(private = "file", rodata) wje_CredentialMediationRequirement := [5]cstring{ 0 = "silent", 1 = "optional", 2 = "conditional", 3 = "required" }
@(private = "file", rodata) wje_FullscreenKeyboardLock := [3]cstring{ 0 = "browser", 1 = "none" }
@(private = "file", rodata) wje_FullscreenNavigationUI := [4]cstring{ 0 = "auto", 1 = "show", 2 = "hide" }
@(private = "file", rodata) wje_ImageDataPixelFormat := [3]cstring{ 0 = "rgba-unorm8", 1 = "rgba-float16" }
@(private = "file", rodata) wje_PredefinedColorSpace := [5]cstring{ 0 = "srgb", 1 = "srgb-linear", 2 = "display-p3", 3 = "display-p3-linear" }
@(private = "file", rodata) wje_ResizeObserverBoxOptions := [4]cstring{ 0 = "border-box", 1 = "content-box", 2 = "device-pixel-content-box" }
@(private = "file", rodata) wje_ShadowRootMode := [3]cstring{ 0 = "open", 1 = "closed" }
@(private = "file", rodata) wje_SlotAssignmentMode := [3]cstring{ 0 = "manual", 1 = "named" }

