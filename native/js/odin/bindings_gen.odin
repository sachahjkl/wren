// DedicatedWorkerGlobalScope.name -> workers.DedicatedWorkerGlobalScope_name
wjg_DedicatedWorkerGlobalScope_get_name :: proc "c" (ctx: ^wj.Context, this_val: wj.JSValue) -> wj.JSValue {
	self := wj.wj_this(ctx, this_val, 393)
	if self == nil { return wj.EXCEPTION }
	_ = self
	n := i32(wj.wr_DedicatedWorkerGlobalScope_name(wj.wj_scratch.data, wj.wj_scratch.cap))
	if n > 0 && u32(n) > wj.wj_scratch.cap {
		if wj.wj_scratch_grow(u32(n)) { n = i32(wj.wr_DedicatedWorkerGlobalScope_name(wj.wj_scratch.data, wj.wj_scratch.cap)) } else { n = -13 }
	}
	if n < 0 { return wj.wj_throw_status(ctx, n, "DedicatedWorkerGlobalScope.name") }
	return wj.JS_NewStringLen(ctx, wj.wj_scratch.data, uint(n))
}

// DedicatedWorkerGlobalScope.close() -> workers.DedicatedWorkerGlobalScope_close
wjg_DedicatedWorkerGlobalScope_close :: proc "c" (ctx: ^wj.Context, this_val: wj.JSValue, argc: i32, argv: [^]wj.JSValue) -> wj.JSValue {
	self := wj.wj_this(ctx, this_val, 393)
	if self == nil { return wj.EXCEPTION }
	_ = self
	st := wj.wr_DedicatedWorkerGlobalScope_close()
	if st < 0 { return wj.wj_throw_status(ctx, i32(st), "DedicatedWorkerGlobalScope.close") }
	return wj.UNDEFINED
}

