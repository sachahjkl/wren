@(private = "file")
wjg_imp_set_str :: proc "c" (ctx: ^wj.Context, this_val: wj.JSValue, v: wj.JSValue, magic: i32) -> wj.JSValue {
	d := &wjg_set_strs[magic]
	self := wj.wj_this(ctx, this_val, i32(d.iface))
	if self == nil { return wj.EXCEPTION }
	a0: wj.Str
	if !wj.wj_to_str(ctx, v, &a0, i32(d.str_flags), "") { return wj.EXCEPTION }
	ptr := a0.ptr
	ln := u32(a0.len)
	if d.flags & 2 != 0 {
		if ptr == nil { ln = wj.WR_ABSENT }
	} else if ptr == nil {
		ptr = wj.empty_ptr()
	}
	fn := wjg_set_str_fns[magic]
	if d.flags & 1 != 0 {
		st := (proc "c" (u64, [^]u8, u32) -> i32)(fn)(self.handle, ptr, ln)
		wj.wj_str_free(ctx, &a0)
		if st < 0 { return wj.wj_throw_status(ctx, st, d.qual) }
	} else {
		(proc "c" (u64, [^]u8, u32))(fn)(self.handle, ptr, ln)
		wj.wj_str_free(ctx, &a0)
	}
	return wj.UNDEFINED
}

@(private = "file")
wjg_call_ret_val :: proc "contextless" (ctx: ^wj.Context, h: u64, fn: rawptr, abi_ret, conv: u8, ret_iface: u16) -> wj.JSValue {
	iv: i64; uv: u64; fv: f64
	switch abi_ret {
	case 0: v := (proc "c" (u64) -> i32)(fn)(h); iv = i64(v); uv = u64(u32(v)); fv = f64(v)
	case 1: v := (proc "c" (u64) -> u32)(fn)(h); iv = i64(i32(v)); uv = u64(v); fv = f64(v)
	case 2: v := (proc "c" (u64) -> i64)(fn)(h); iv = v; uv = u64(v); fv = f64(v)
	case 3: v := (proc "c" (u64) -> u64)(fn)(h); iv = i64(v); uv = v; fv = f64(v)
	case 4: fv = f64((proc "c" (u64) -> f32)(fn)(h))
	case 5: fv = (proc "c" (u64) -> f64)(fn)(h)
	}
	switch conv {
	case 0: return wj.JS_NewBool(ctx, uv != 0)
	case 1: return wj.new_int32(i32(iv))
	case 2: return wj.new_uint32(ctx, u32(uv))
	case 3: return wj.new_int64(ctx, iv)
	case 4: return wj.new_float64(ctx, fv)
	case 5: return wj.wj_wrap_node(ctx, uv)
	case 6: return wj.wj_wrap_host(ctx, uv, i32(ret_iface))
	case 7: return wj.wj_wrap_owned(ctx, uv, i32(ret_iface), wj.UNDEFINED)
	}
	return wj.UNDEFINED
}

