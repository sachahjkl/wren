@(private = "file") wjg_set_val_fns: [45]rawptr
@(private = "file")
wjg_imp_set_val :: proc "c" (ctx: ^wj.Context, this_val: wj.JSValue, v: wj.JSValue, magic: i32) -> wj.JSValue {
	d := &wjg_set_vals[magic]
	self := wj.wj_this(ctx, this_val, i32(d.iface))
	if self == nil { return wj.EXCEPTION }
	iv: i64; fv: f64
	switch d.conv {
	case 0: iv = wj.JS_ToBool(ctx, v) != 0 ? 1 : 0
	case 1: x: i32; if !wj.wj_to_int32(ctx, v, &x, i32(d.bits), i32(d.range_mode)) { return wj.EXCEPTION }; iv = i64(x)
	case 2: x: u32; if !wj.wj_to_uint32(ctx, v, &x, i32(d.bits), i32(d.range_mode)) { return wj.EXCEPTION }; iv = i64(x)
	case 3: x: i64; if !wj.wj_to_int64(ctx, v, &x, i32(d.range_mode)) { return wj.EXCEPTION }; iv = x
	case 4: x: u64; if !wj.wj_to_uint64(ctx, v, &x, i32(d.range_mode)) { return wj.EXCEPTION }; iv = i64(x)
	case 5: x: f64; if !wj.wj_to_double(ctx, v, &x, d.flags & 2 != 0) { return wj.EXCEPTION }; fv = x
	}
	fn := wjg_set_val_fns[magic]
	if d.flags & 1 != 0 {
		st: i32
		switch d.abi_arg {
		case 0: st = (proc "c" (u64, i32) -> i32)(fn)(self.handle, i32(iv))
		case 1: st = (proc "c" (u64, i64) -> i32)(fn)(self.handle, iv)
		case 2: st = (proc "c" (u64, f32) -> i32)(fn)(self.handle, f32(fv))
		case 3: st = (proc "c" (u64, f64) -> i32)(fn)(self.handle, fv)
		}
		if st < 0 { return wj.wj_throw_status(ctx, st, d.qual) }
	} else {
		switch d.abi_arg {
		case 0: (proc "c" (u64, i32))(fn)(self.handle, i32(iv))
		case 1: (proc "c" (u64, i64))(fn)(self.handle, iv)
		case 2: (proc "c" (u64, f32))(fn)(self.handle, f32(fv))
		case 3: (proc "c" (u64, f64))(fn)(self.handle, fv)
		}
	}
	return wj.UNDEFINED
}

