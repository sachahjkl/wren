	@(link_name = "CanvasPathDrawingStyles_set_miterLimit") wr_CanvasPathDrawingStyles_set_miterLimit :: proc(ctx: u64, value: f64) ---
	@(link_name = "CanvasPathDrawingStyles_lineDashOffset") wr_CanvasPathDrawingStyles_lineDashOffset :: proc(ctx: u64) -> f64 ---
	@(link_name = "CanvasPathDrawingStyles_set_lineDashOffset") wr_CanvasPathDrawingStyles_set_lineDashOffset :: proc(ctx: u64, value: f64) ---
	// setLineDash(segments): ignored when an entry is negative or not finite; an odd count is repeated.
	@(link_name = "CanvasPathDrawingStyles_setLineDash") wr_CanvasPathDrawingStyles_setLineDash :: proc(ctx: u64, segments: [^]f64, segments_len: u32) ---
	@(link_name = "CanvasPathDrawingStyles_lineDashCount") wr_CanvasPathDrawingStyles_lineDashCount :: proc(ctx: u64) -> i32 ---
	@(link_name = "CanvasPathDrawingStyles_lineDashAt") wr_CanvasPathDrawingStyles_lineDashAt :: proc(ctx: u64, index: i32) -> f64 ---
	@(link_name = "CanvasTextDrawingStyles_lang") wr_CanvasTextDrawingStyles_lang :: proc(ctx: u64, _buf: [^]u8, _cap: u32) -> i32 ---
	@(link_name = "CanvasTextDrawingStyles_set_lang") wr_CanvasTextDrawingStyles_set_lang :: proc(ctx: u64, value: [^]u8, value_len: u32) ---
	// The CSS font shorthand; one that does not parse is ignored. Relative units (em, %) are relative to the canvas
	// element's font size.
	@(link_name = "CanvasTextDrawingStyles_font") wr_CanvasTextDrawingStyles_font :: proc(ctx: u64, _buf: [^]u8, _cap: u32) -> i32 ---
	@(link_name = "CanvasTextDrawingStyles_set_font") wr_CanvasTextDrawingStyles_set_font :: proc(ctx: u64, value: [^]u8, value_len: u32) ---
	@(link_name = "CanvasTextDrawingStyles_textAlign") wr_CanvasTextDrawingStyles_textAlign :: proc(ctx: u64, _buf: [^]u8, _cap: u32) -> i32 ---
	@(link_name = "CanvasTextDrawingStyles_set_textAlign") wr_CanvasTextDrawingStyles_set_textAlign :: proc(ctx: u64, value: [^]u8, value_len: u32) ---
	@(link_name = "CanvasTextDrawingStyles_textBaseline") wr_CanvasTextDrawingStyles_textBaseline :: proc(ctx: u64, _buf: [^]u8, _cap: u32) -> i32 ---
	@(link_name = "CanvasTextDrawingStyles_set_textBaseline") wr_CanvasTextDrawingStyles_set_textBaseline :: proc(ctx: u64, value: [^]u8, value_len: u32) ---
	@(link_name = "CanvasTextDrawingStyles_direction") wr_CanvasTextDrawingStyles_direction :: proc(ctx: u64, _buf: [^]u8, _cap: u32) -> i32 ---
	@(link_name = "CanvasTextDrawingStyles_set_direction") wr_CanvasTextDrawingStyles_set_direction :: proc(ctx: u64, value: [^]u8, value_len: u32) ---
	@(link_name = "CanvasTextDrawingStyles_letterSpacing") wr_CanvasTextDrawingStyles_letterSpacing :: proc(ctx: u64, _buf: [^]u8, _cap: u32) -> i32 ---
	@(link_name = "CanvasTextDrawingStyles_set_letterSpacing") wr_CanvasTextDrawingStyles_set_letterSpacing :: proc(ctx: u64, value: [^]u8, value_len: u32) ---
	@(link_name = "CanvasTextDrawingStyles_wordSpacing") wr_CanvasTextDrawingStyles_wordSpacing :: proc(ctx: u64, _buf: [^]u8, _cap: u32) -> i32 ---
	@(link_name = "CanvasTextDrawingStyles_set_wordSpacing") wr_CanvasTextDrawingStyles_set_wordSpacing :: proc(ctx: u64, value: [^]u8, value_len: u32) ---
	@(link_name = "CanvasTextDrawingStyles_fontKerning") wr_CanvasTextDrawingStyles_fontKerning :: proc(ctx: u64, _buf: [^]u8, _cap: u32) -> i32 ---
	@(link_name = "CanvasTextDrawingStyles_set_fontKerning") wr_CanvasTextDrawingStyles_set_fontKerning :: proc(ctx: u64, value: [^]u8, value_len: u32) ---
	@(link_name = "CanvasTextDrawingStyles_fontStretch") wr_CanvasTextDrawingStyles_fontStretch :: proc(ctx: u64, _buf: [^]u8, _cap: u32) -> i32 ---
	@(link_name = "CanvasTextDrawingStyles_set_fontStretch") wr_CanvasTextDrawingStyles_set_fontStretch :: proc(ctx: u64, value: [^]u8, value_len: u32) ---
	@(link_name = "CanvasTextDrawingStyles_fontVariantCaps") wr_CanvasTextDrawingStyles_fontVariantCaps :: proc(ctx: u64, _buf: [^]u8, _cap: u32) -> i32 ---
	@(link_name = "CanvasTextDrawingStyles_set_fontVariantCaps") wr_CanvasTextDrawingStyles_set_fontVariantCaps :: proc(ctx: u64, value: [^]u8, value_len: u32) ---
	@(link_name = "CanvasTextDrawingStyles_textRendering") wr_CanvasTextDrawingStyles_textRendering :: proc(ctx: u64, _buf: [^]u8, _cap: u32) -> i32 ---
	@(link_name = "CanvasTextDrawingStyles_set_textRendering") wr_CanvasTextDrawingStyles_set_textRendering :: proc(ctx: u64, value: [^]u8, value_len: u32) ---
	// /////////////////////////////
	@(link_name = "CanvasPath_closePath") wr_CanvasPath_closePath :: proc(p: u64) ---
	@(link_name = "CanvasPath_moveTo") wr_CanvasPath_moveTo :: proc(p: u64, x: f64, y: f64) ---
	@(link_name = "CanvasPath_lineTo") wr_CanvasPath_lineTo :: proc(p: u64, x: f64, y: f64) ---
	@(link_name = "CanvasPath_quadraticCurveTo") wr_CanvasPath_quadraticCurveTo :: proc(p: u64, cpx: f64, cpy: f64, x: f64, y: f64) ---
	@(link_name = "CanvasPath_bezierCurveTo") wr_CanvasPath_bezierCurveTo :: proc(p: u64, cp1x: f64, cp1y: f64, cp2x: f64, cp2y: f64, x: f64, y: f64) ---
	// A negative radius raises Index_Size.
	@(link_name = "CanvasPath_arcTo") wr_CanvasPath_arcTo :: proc(p: u64, x1: f64, y1: f64, x2: f64, y2: f64, radius: f64) -> i32 ---
	@(link_name = "CanvasPath_rect") wr_CanvasPath_rect :: proc(p: u64, x: f64, y: f64, w: f64, h: f64) ---
	// roundRect: `radii` are the 8 numbers of the four corners (upper-left, upper-right, lower-right, lower-left), x
	// then y radius each. A negative radius raises Range.
	@(link_name = "CanvasPath_roundRect") wr_CanvasPath_roundRect :: proc(p: u64, x: f64, y: f64, w: f64, h: f64, radii: [^]f64, radii_len: u32) -> i32 ---
	@(link_name = "CanvasPath_arc") wr_CanvasPath_arc :: proc(p: u64, x: f64, y: f64, radius: f64, start_angle: f64, end_angle: f64, counterclockwise: i32) -> i32 ---
	@(link_name = "CanvasPath_ellipse") wr_CanvasPath_ellipse :: proc(p: u64, x: f64, y: f64, radius_x: f64, radius_y: f64, rotation: f64, start_angle: f64, end_angle: f64, counterclockwise: i32) -> i32 ---
	// new Path2D(): empty; `from` a Path2D handle to copy (0 for none); `svg` path data (M, L, H, V, C, S, Q, T, A, Z and
	// their relative forms) appended when not empty (an invalid string leaves what parsed before the error).
	@(link_name = "Path2D_create") wr_Path2D_create :: proc(from: u64, svg: [^]u8, svg_len: u32) -> u64 ---
	// addPath(path, matrix).
	@(link_name = "Path2D_addPath") wr_Path2D_addPath :: proc(target: u64, path: u64, m11: f64, m12: f64, m21: f64, m22: f64, m41: f64, m42: f64) ---
	// /////////////////////////////
	// new OffscreenCanvas(width, height): Quota over the limits.
	@(link_name = "OffscreenCanvas_create") wr_OffscreenCanvas_create :: proc(width: u64, height: u64, _ret: ^u64) -> i32 ---
	@(link_name = "OffscreenCanvas_width") wr_OffscreenCanvas_width :: proc(canvas: u64) -> u64 ---
	@(link_name = "OffscreenCanvas_height") wr_OffscreenCanvas_height :: proc(canvas: u64) -> u64 ---
	// Sets the size: the canvas is cleared and its context reset. Quota over the limits.
	@(link_name = "OffscreenCanvas_set_width") wr_OffscreenCanvas_set_width :: proc(canvas: u64, value: u64) -> i32 ---
	@(link_name = "OffscreenCanvas_set_height") wr_OffscreenCanvas_set_height :: proc(canvas: u64, value: u64) -> i32 ---
	@(link_name = "OffscreenCanvas_context2d") wr_OffscreenCanvas_context2d :: proc(canvas: u64, alpha: i32, will_read_frequently: i32, _ret: ^u64) -> i32 ---
	// transferToImageBitmap(): the pixels move to a new ImageBitmap and the canvas is cleared.
	@(link_name = "OffscreenCanvas_transferToImageBitmap") wr_OffscreenCanvas_transferToImageBitmap :: proc(canvas: u64, _ret: ^u64) -> i32 ---
	@(link_name = "ImageBitmap_width") wr_ImageBitmap_width :: proc(bitmap: u64) -> u32 ---
	@(link_name = "ImageBitmap_height") wr_ImageBitmap_height :: proc(bitmap: u64) -> u32 ---
	// bitmap.close(): the pixels are freed; the bitmap is 0 x 0 from then on.
	@(link_name = "ImageBitmap_close") wr_ImageBitmap_close :: proc(bitmap: u64) ---
	// createImageBitmap(image, sx, sy, sw, sh, options): `source` as for drawImage, `form` 0 (whole image) or 4 (a
	// rectangle). The bitmap is a copy of the pixels now, with the full ImageBitmapOptions applied natively: `orient`
	// (0 from-image, 1 flipY), `premul` (0 default, 1 premultiply, 2 none — the result stored premultiplied either way;
	// `none` only affects a source whose alpha is not premultiplied, which never happens for our premultiplied bitmaps,
	// so it is a no-op here and kept for completeness), `colorspace` (0 default, 1 none — we keep the source sRGB bytes
	// so both behave the same), `resize_w` / `resize_h` the wanted output size (0 means keep that axis) and `resize_q`
	// (0 pixelated, 1 low, 2 medium, 3 high). Not_Found: no pixels yet (the image is not available); Invalid_State:
	// broken or empty image; Index_Size: an empty rectangle or an out-of-range resize.
	@(link_name = "Canvas_createBitmap") wr_Canvas_createBitmap :: proc(source: u64, form: i32, sx: f64, sy: f64, sw: f64, sh: f64, orient: i32, premul: i32, colorspace: i32, resize_w: i32, resize_h: i32, resize_q: i32, _ret: ^u64) -> i32 ---
	// An ImageBitmap of straight RGBA8 pixels (an ImageData, a decoded Blob, a VideoFrame read back). `orient`, `premul`,
	// `colorspace`, `resize_*` and `resize_q` as Canvas_createBitmap.
	@(link_name = "Canvas_bitmapFromPixels") wr_Canvas_bitmapFromPixels :: proc(data: [^]u8, data_len: u32, width: i32, height: i32, orient: i32, premul: i32, colorspace: i32, resize_w: i32, resize_h: i32, resize_q: i32, _ret: ^u64) -> i32 ---
	// /////////////////////////////
	// getContext("bitmaprenderer", {alpha}) on a <canvas> element / an OffscreenCanvas: 0 when a 2D context already
	// holds the canvas (the kinds cannot be mixed).
	@(link_name = "HTMLCanvasElement_bitmapRenderer") wr_HTMLCanvasElement_bitmapRenderer :: proc(canvas: u64, alpha: i32, _ret: ^u64) -> i32 ---
	@(link_name = "OffscreenCanvas_bitmapRenderer") wr_OffscreenCanvas_bitmapRenderer :: proc(canvas: u64, alpha: i32, _ret: ^u64) -> i32 ---
	// context.canvas: the owning <canvas> node or OffscreenCanvas object (0 when the canvas is gone).
	@(link_name = "ImageBitmapRenderingContext_canvas") wr_ImageBitmapRenderingContext_canvas :: proc(ctx: u64) -> u64 ---
	// transferFromImageBitmap(bitmap): display the bitmap (its pixels move into the canvas and it is detached);
	// `has_bitmap` false is the null argument (clear the canvas). Type when the argument is not an ImageBitmap.
	@(link_name = "ImageBitmapRenderingContext_transferFromImageBitmap") wr_ImageBitmapRenderingContext_transferFromImageBitmap :: proc(ctx: u64, bitmap: u64, has_bitmap: i32) -> i32 ---
}

// module compression
foreign import _wr_wj_compression "compression"
@(default_calling_convention = "contextless")
foreign _wr_wj_compression {
	// A compressor (decompress false) or a decompressor of `format`.
	@(link_name = "Compression_create") wr_Compression_create :: proc(format: i32, decompress: i32, _ret: ^u64) -> i32 ---
	// Feeds `input`: the output it made (Compression_output reads it again when the buffer was too small). Type for
	// data that is not of the format, or that follows the end of the compressed data; Quota past the bound.
	@(link_name = "Compression_push") wr_Compression_push :: proc(compressor: u64, input: [^]u8, input_len: u32, _buf: [^]u8, _cap: u32) -> i32 ---
	// The end of the input: what is left of the output. Type when the compressed data ended before its end.
	@(link_name = "Compression_finish") wr_Compression_finish :: proc(compressor: u64, _buf: [^]u8, _cap: u32) -> i32 ---
	// The output of the last push or finish.
	@(link_name = "Compression_output") wr_Compression_output :: proc(compressor: u64, _buf: [^]u8, _cap: u32) -> i32 ---
}

