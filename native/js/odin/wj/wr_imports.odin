@(default_calling_convention = "contextless")
foreign _wr_wj_idb {
	// See the module comment.
	@(link_name = "Idb_call") wr_Idb_call :: proc(op: i32, args: [^]u8, args_len: u32, _buf: [^]u8, _cap: u32) -> i32 ---
