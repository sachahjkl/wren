	@(link_name = "ResizeObserver_create") wr_ResizeObserver_create :: proc(notify: i32, user: i32) -> u64 ---
	// observer.observe(target, { box }): box 0 content-box, 1 border-box, 2 device-pixel-content-box. Observing a target
	// again with the same box does nothing; with another, the observation starts over.
	@(link_name = "ResizeObserver_observe") wr_ResizeObserver_observe :: proc(observer: u64, target: u64, box: i32) -> i32 ---
	@(link_name = "ResizeObserver_unobserve") wr_ResizeObserver_unobserve :: proc(observer: u64, target: u64) ---
