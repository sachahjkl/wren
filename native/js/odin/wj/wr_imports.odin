	@(link_name = "MediaSource_activeSourceBuffers") wr_MediaSource_activeSourceBuffers :: proc(source: u64) -> u64 ---
	// source.readyState: "closed", "open" or "ended".
	@(link_name = "MediaSource_readyState") wr_MediaSource_readyState :: proc(source: u64, _buf: [^]u8, _cap: u32) -> i32 ---
	@(link_name = "MediaSource_duration") wr_MediaSource_duration :: proc(source: u64) -> f64 ---
	// source.duration = value: InvalidState unless open or updating buffers, Type for a negative value or NaN.
	@(link_name = "MediaSource_set_duration") wr_MediaSource_set_duration :: proc(source: u64, value: f64) -> i32 ---
	// source.addSourceBuffer(type): NotSupported, InvalidState (not open), Quota.
	@(link_name = "MediaSource_addSourceBuffer") wr_MediaSource_addSourceBuffer :: proc(source: u64, type: [^]u8, type_len: u32, _ret: ^u64) -> i32 ---
	@(link_name = "MediaSource_removeSourceBuffer") wr_MediaSource_removeSourceBuffer :: proc(source: u64, buffer: u64) -> i32 ---
	// source.endOfStream(error): "" (none), "network" or "decode".
	@(link_name = "MediaSource_endOfStream") wr_MediaSource_endOfStream :: proc(source: u64, error: [^]u8, error_len: u32) -> i32 ---
	@(link_name = "MediaSource_setLiveSeekableRange") wr_MediaSource_setLiveSeekableRange :: proc(source: u64, start: f64, end: f64) -> i32 ---
	@(link_name = "MediaSource_clearLiveSeekableRange") wr_MediaSource_clearLiveSeekableRange :: proc(source: u64) -> i32 ---
	@(link_name = "SourceBufferList_length") wr_SourceBufferList_length :: proc(list: u64) -> u32 ---
	// list[index]: Not_Found past the end (undefined).
	@(link_name = "SourceBufferList_item") wr_SourceBufferList_item :: proc(list: u64, index: u32, _ret: ^u64) -> i32 ---
	// buffer.mode: "segments" or "sequence".
	@(link_name = "SourceBuffer_mode") wr_SourceBuffer_mode :: proc(buffer: u64, _buf: [^]u8, _cap: u32) -> i32 ---
	@(link_name = "SourceBuffer_set_mode") wr_SourceBuffer_set_mode :: proc(buffer: u64, mode: [^]u8, mode_len: u32) -> i32 ---
	@(link_name = "SourceBuffer_updating") wr_SourceBuffer_updating :: proc(buffer: u64) -> i32 ---
	// buffer.buffered as pairs of f64 (start, end), seconds (InvalidState for a removed buffer): the engine makes the TimeRanges.
	@(link_name = "SourceBuffer_ranges") wr_SourceBuffer_ranges :: proc(buffer: u64, _buf: [^]u8, _cap: u32) -> i32 ---
	@(link_name = "SourceBuffer_timestampOffset") wr_SourceBuffer_timestampOffset :: proc(buffer: u64) -> f64 ---
	@(link_name = "SourceBuffer_set_timestampOffset") wr_SourceBuffer_set_timestampOffset :: proc(buffer: u64, value: f64) -> i32 ---
	@(link_name = "SourceBuffer_appendWindowStart") wr_SourceBuffer_appendWindowStart :: proc(buffer: u64) -> f64 ---
	@(link_name = "SourceBuffer_set_appendWindowStart") wr_SourceBuffer_set_appendWindowStart :: proc(buffer: u64, value: f64) -> i32 ---
	@(link_name = "SourceBuffer_appendWindowEnd") wr_SourceBuffer_appendWindowEnd :: proc(buffer: u64) -> f64 ---
	@(link_name = "SourceBuffer_set_appendWindowEnd") wr_SourceBuffer_set_appendWindowEnd :: proc(buffer: u64, value: f64) -> i32 ---
	// buffer.appendBuffer(data): InvalidState while updating or removed, Quota when full.
	@(link_name = "SourceBuffer_appendBuffer") wr_SourceBuffer_appendBuffer :: proc(buffer: u64, data: [^]u8, data_len: u32) -> i32 ---
	@(link_name = "SourceBuffer_abort") wr_SourceBuffer_abort :: proc(buffer: u64) -> i32 ---
	@(link_name = "SourceBuffer_changeType") wr_SourceBuffer_changeType :: proc(buffer: u64, type: [^]u8, type_len: u32) -> i32 ---
	@(link_name = "SourceBuffer_remove") wr_SourceBuffer_remove :: proc(buffer: u64, start: f64, end: f64) -> i32 ---
}

