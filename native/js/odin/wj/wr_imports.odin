	@(link_name = "Screen_get") wr_Screen_get :: proc(field: i32) -> i32 ---
}

// module locks
foreign import _wr_wj_locks "locks"
@(default_calling_convention = "contextless")
foreign _wr_wj_locks {
	// navigator.locks.request(name, {mode, ifAvailable, steal, signal}, callback). The result is packed: bit 0 is
	// "available" (clear only for ifAvailable on a busy lock, or an opaque origin), bit 1 is "granted now" (run the
	// callback with the Lock immediately), and the rest (>> 2) is the lock id used to release it. When available but
	// not granted-now, the request waits and the engine is told on grant (the callback index / user name the engine
	// record for that notification).
	@(link_name = "LockManager_request") wr_LockManager_request :: proc(name: [^]u8, name_len: u32, mode: i32, if_available: i32, steal: i32, callback: u32, user: i32, broken_callback: u32, has_signal: i32) -> i64 ---
	// The callback's returned promise settled, the callback was null, or a pending request was aborted: release the
	// lock (or drop the queued request) and grant whatever waits.
	@(link_name = "LockManager_release") wr_LockManager_release :: proc(id: u64) ---
	// navigator.locks.query(): the number of held / pending locks of the caller's origin, and the i-th entry's fields.
	@(link_name = "LockManager_queryCount") wr_LockManager_queryCount :: proc(held: i32) -> i32 ---
	@(link_name = "LockManager_queryName") wr_LockManager_queryName :: proc(held: i32, index: i32, _buf: [^]u8, _cap: u32) -> i32 ---
	@(link_name = "LockManager_queryMode") wr_LockManager_queryMode :: proc(held: i32, index: i32, _buf: [^]u8, _cap: u32) -> i32 ---
	@(link_name = "LockManager_queryClient") wr_LockManager_queryClient :: proc(held: i32, index: i32, _buf: [^]u8, _cap: u32) -> i32 ---
}

// module htmlmedia
foreign import _wr_wj_htmlmedia "htmlmedia"
@(default_calling_convention = "contextless")
foreign _wr_wj_htmlmedia {
	// element.currentSrc: the absolute URL of the resource being played ("" when none).
	@(link_name = "HTMLMediaElement_currentSrc") wr_HTMLMediaElement_currentSrc :: proc(element: u64, _buf: [^]u8, _cap: u32) -> i32 ---
	// element.networkState: 0 empty, 1 idle, 2 loading, 3 no source.
	@(link_name = "HTMLMediaElement_networkState") wr_HTMLMediaElement_networkState :: proc(element: u64) -> i32 ---
	// element.readyState: 0 nothing ... 4 enough data.
	@(link_name = "HTMLMediaElement_readyState") wr_HTMLMediaElement_readyState :: proc(element: u64) -> i32 ---
	// element.seeking
	@(link_name = "HTMLMediaElement_seeking") wr_HTMLMediaElement_seeking :: proc(element: u64) -> i32 ---
	// element.currentTime, in seconds.
	@(link_name = "HTMLMediaElement_currentTime") wr_HTMLMediaElement_currentTime :: proc(element: u64) -> f64 ---
	// element.currentTime = value: a seek (a NaN or infinite value is refused by Web IDL before).
	@(link_name = "HTMLMediaElement_set_currentTime") wr_HTMLMediaElement_set_currentTime :: proc(element: u64, value: f64) ---
	// element.duration: NaN until the metadata is known, Infinity for a stream with no end.
	@(link_name = "HTMLMediaElement_duration") wr_HTMLMediaElement_duration :: proc(element: u64) -> f64 ---
	// element.paused
