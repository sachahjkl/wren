	// Ignored outside read/write mode and for a value that is not one of the nine.
	@(link_name = "DataTransfer_set_effectAllowed") wr_DataTransfer_set_effectAllowed :: proc(dt: u64, value: [^]u8, value_len: u32) ---
	// getData(format): "" in protected mode or when absent ("text" is text/plain, "url" the first URL of text/uri-list).
	@(link_name = "DataTransfer_getData") wr_DataTransfer_getData :: proc(dt: u64, format: [^]u8, format_len: u32, _buf: [^]u8, _cap: u32) -> i32 ---
	// setData(format, data): ignored outside read/write mode.
	@(link_name = "DataTransfer_setData") wr_DataTransfer_setData :: proc(dt: u64, format: [^]u8, format_len: u32, data: [^]u8, data_len: u32) ---
	// clearData(format): every string item, or those of the format; ignored outside read/write mode.
	@(link_name = "DataTransfer_clearData") wr_DataTransfer_clearData :: proc(dt: u64, format: [^]u8, format_len: u32) ---
	// setDragImage(image, x, y): ignored outside read/write mode.
	@(link_name = "DataTransfer_setDragImage") wr_DataTransfer_setDragImage :: proc(dt: u64, image: u64, x: i32, y: i32) ---
	// The types, in order, separated by "\n" ("Files" last when there are files).
	@(link_name = "DataTransfer_typeList") wr_DataTransfer_typeList :: proc(dt: u64, _buf: [^]u8, _cap: u32) -> i32 ---
	// The number of items (DataTransferItemList.length; 0 in disabled mode).
	@(link_name = "DataTransfer_itemCount") wr_DataTransfer_itemCount :: proc(dt: u64) -> i32 ---
	// An item's kind (Invalid_Argument past the end).
	@(link_name = "DataTransfer_itemKind") wr_DataTransfer_itemKind :: proc(dt: u64, index: i32, _ret: ^i32) -> i32 ---
	// An item's type.
	@(link_name = "DataTransfer_itemType") wr_DataTransfer_itemType :: proc(dt: u64, index: i32, _buf: [^]u8, _cap: u32) -> i32 ---
	// A string item's data (Invalid_State in protected mode).
	@(link_name = "DataTransfer_itemString") wr_DataTransfer_itemString :: proc(dt: u64, index: i32, _buf: [^]u8, _cap: u32) -> i32 ---
	// A file item's file (0: not a file, or protected mode).
	@(link_name = "DataTransfer_itemFile") wr_DataTransfer_itemFile :: proc(dt: u64, index: i32, _ret: ^u64) -> i32 ---
	// items.add(data, type): Invalid_State outside read/write mode, Not_Supported when a string item of the type exists.
	@(link_name = "DataTransfer_addString") wr_DataTransfer_addString :: proc(dt: u64, data: [^]u8, data_len: u32, type: [^]u8, type_len: u32) -> i32 ---
	// items.add(file) for a file of the browser (a dropped or chosen one).
	@(link_name = "DataTransfer_addFile") wr_DataTransfer_addFile :: proc(dt: u64, file: u64) -> i32 ---
	// items.add(file) for a File made by the page: its bytes are copied (Quota past the page's memory limit).
	@(link_name = "DataTransfer_addBytes") wr_DataTransfer_addBytes :: proc(dt: u64, name: [^]u8, name_len: u32, type: [^]u8, type_len: u32, data: [^]u8, data_len: u32, last_modified: f64) -> i32 ---
	// items.remove(index): Invalid_State outside read/write mode.
	@(link_name = "DataTransfer_removeItem") wr_DataTransfer_removeItem :: proc(dt: u64, index: i32) -> i32 ---
	// items.clear(): Invalid_State outside read/write mode.
	@(link_name = "DataTransfer_clearItems") wr_DataTransfer_clearItems :: proc(dt: u64) -> i32 ---
	// The files (dataTransfer.files: none outside read/write and read-only mode).
	@(link_name = "DataTransfer_fileCount") wr_DataTransfer_fileCount :: proc(dt: u64) -> i32 ---
	// One of them.
	@(link_name = "DataTransfer_file") wr_DataTransfer_file :: proc(dt: u64, index: i32, _ret: ^u64) -> i32 ---
	// The mode: 0 protected, 1 read/write, 2 read-only.
	@(link_name = "DataTransfer_mode") wr_DataTransfer_mode :: proc(dt: u64) -> i32 ---
	// A file's name (no directory).
	@(link_name = "LocalFile_name") wr_LocalFile_name :: proc(file: u64, _buf: [^]u8, _cap: u32) -> i32 ---
	// Its MIME type ("" when unknown).
	@(link_name = "LocalFile_type") wr_LocalFile_type :: proc(file: u64, _buf: [^]u8, _cap: u32) -> i32 ---
	// Its size and time.
	@(link_name = "LocalFile_info") wr_LocalFile_info :: proc(file: u64, _ret: ^wr_LocalFileInfo) ---
	// Reads up to `into`'s capacity from `offset`: the number of bytes read (Not_Found when the file is gone or
	// changed since it was given: File API "NotReadableError").
	@(link_name = "LocalFile_read") wr_LocalFile_read :: proc(file: u64, offset: i64, into: [^]u8, into_cap: u32, _ret: ^i64) -> i32 ---
	// DataTransferItem.getAsFileSystemHandle(): the dropped file's or folder's handle (as Fs_showPicker describes one:
	// root TAB path TAB kind TAB name), "" for a string item or outside read-only and read/write mode.
	@(link_name = "DataTransfer_itemFsHandle") wr_DataTransfer_itemFsHandle :: proc(dt: u64, index: i32, _buf: [^]u8, _cap: u32) -> i32 ---
	// DragEvent.dataTransfer of an event the browser dispatches (0 for another event).
	@(link_name = "DragEvent_dataTransfer") wr_DragEvent_dataTransfer :: proc(event: u64) -> u64 ---
	// input.files.length (0 for an element that is not a file input).
	@(link_name = "InputFiles_count") wr_InputFiles_count :: proc(input: u64) -> i32 ---
	// input.files[index]
	@(link_name = "InputFiles_item") wr_InputFiles_item :: proc(input: u64, index: i32, _ret: ^u64) -> i32 ---
