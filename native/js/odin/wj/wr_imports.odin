	// fileEntry.file(): a promise of the File (NotFoundError when it went away, TypeMismatchError for a folder).
	@(link_name = "FsEntry_file") wr_FsEntry_file :: proc(entry: u64) -> u64 ---
	// dirEntry.getFile(path) / getDirectory(path): a promise of the entry (NotFoundError, TypeMismatchError when it is
	// the other kind, SecurityError for a path that leaves what was dropped).
	@(link_name = "FsEntry_lookup") wr_FsEntry_lookup :: proc(dir: u64, path: [^]u8, path_len: u32, directory: i32) -> u64 ---
	// dirEntry.createReader()
	@(link_name = "FsEntry_createReader") wr_FsEntry_createReader :: proc(dir: u64) -> u64 ---
	// reader.readEntries(): a promise of the number of entries of the next batch (0: the end), read with FsReader_entry.
	@(link_name = "FsReader_read") wr_FsReader_read :: proc(reader: u64) -> u64 ---
	// The entries of the last batch.
	@(link_name = "FsReader_entry") wr_FsReader_entry :: proc(reader: u64, index: i32) -> u64 ---
}

// module scripts
foreign import _wr_wj_scripts "scripts"
@(default_calling_convention = "contextless")
foreign _wr_wj_scripts {
	// document.write(markup) (writeln adds the newline): inserted at the parser's insertion point while the document
	// loads (scripts written run before it returns), else the document is opened again first and replaced. Invalid_State
	// for a document that does not accept it now (a custom element constructor, a parser that would have to be aborted).
	@(link_name = "Document_writeMarkup") wr_Document_writeMarkup :: proc(markup: [^]u8, markup_len: u32) -> i32 ---
	// document.open(): the document is emptied and its parser starts again (does nothing while the parser runs a
	// script; the listeners and handlers of its tree and of its Window are erased, the engine's records first through
	// its export wj_document_opening). Invalid_State when the document cannot be opened.
	@(link_name = "Document_openStream") wr_Document_openStream :: proc() -> i32 ---
	// document.close(): the parser of a document.open() finishes (DOMContentLoaded, then load).
	@(link_name = "Document_closeStream") wr_Document_closeStream :: proc() -> i32 ---
	// The "force async" flag of a script element (set when a script creates it: dynamic scripts are async unless
	// their async attribute is set to false).
	@(link_name = "HTMLScriptElement_forceAsync") wr_HTMLScriptElement_forceAsync :: proc(element: u64) -> i32 ---
	// script.async = value: the attribute is set or removed by the caller, this clears the flag.
	@(link_name = "HTMLScriptElement_setForceAsync") wr_HTMLScriptElement_setForceAsync :: proc(element: u64, value: i32) ---
	// May this inline code run (Content-Security-Policy: 'unsafe-inline', nonces, hashes)? A refusal is reported as a
	// violation. `element` is the element it comes from (0 for a javascript: URL).
	@(link_name = "Script_allowInline") wr_Script_allowInline :: proc(element: u64, kind: i32, source: [^]u8, source_len: u32) -> i32 ---
	// May eval() / new Function / setTimeout(string) compile this ('unsafe-eval')? A refusal is reported.
	@(link_name = "Script_allowEval") wr_Script_allowEval :: proc(source: [^]u8, source_len: u32) -> i32 ---
	// The result of a javascript: URL that was a string: it becomes the document (HTML "navigate to a javascript: URL").
	@(link_name = "Script_javascriptResult") wr_Script_javascriptResult :: proc(html: [^]u8, html_len: u32) ---
	// The URL naming code that has no script of its own in stack traces and as the base of import() (handlers,
	// timer strings): the document's (the worker's script in a worker).
	@(link_name = "Script_baseName") wr_Script_baseName :: proc(_buf: [^]u8, _cap: u32) -> i32 ---
	// The URL a module specifier stands for, imported from the module (or script) at `base` ("" for the root of a
	// graph, given as a URL already): import maps, then URL parsing. Type: a bare specifier nothing maps, or not a URL.
	@(link_name = "Module_resolve") wr_Module_resolve :: proc(specifier: [^]u8, specifier_len: u32, base: [^]u8, base_len: u32, _buf: [^]u8, _cap: u32) -> i32 ---
	// The source of a module of the page's module map. Not_Found when the browser does not have it.
	@(link_name = "Module_source") wr_Module_source :: proc(url: [^]u8, url_len: u32, _buf: [^]u8, _cap: u32) -> i32 ---
	// The module at `module_url` imports `specifier`: resolved and fetched if new (part of the module's graph).
	@(link_name = "Module_request") wr_Module_request :: proc(module_url: [^]u8, module_url_len: u32, specifier: [^]u8, specifier_len: u32, type: i32) -> i32 ---
	// import(specifier) from code at `base`: the browser fetches the graph, then calls the engine's
	// wj_module_import_done(id, ...) from a task of its own. Type: the specifier cannot be resolved.
	@(link_name = "Module_import") wr_Module_import :: proc(id: i32, specifier: [^]u8, specifier_len: u32, base: [^]u8, base_len: u32, type: i32) -> i32 ---
	// Unhandled promise rejections are waiting: run the engine's wj_notify_rejections in a task of its own.
	@(link_name = "Engine_queueRejectionCheck") wr_Engine_queueRejectionCheck :: proc() ---
	// new Worker(url, {name, type}) for a JavaScript worker: the Worker object (a handle of module workers). Syntax for
	// an invalid URL, Not_Allowed when the browser refuses (the console says why).
	@(link_name = "Worker_createScript") wr_Worker_createScript :: proc(url: [^]u8, url_len: u32, name: [^]u8, name_len: u32, type: i32, _ret: ^u64) -> i32 ---
	// worker.postMessage(message): the message as structured serialization bytes (native/js/runtime/clone.c).
	@(link_name = "Worker_postSerialized") wr_Worker_postSerialized :: proc(worker: u64, data: [^]u8, data_len: u32) -> i32 ---
	// postMessage(message) in a JavaScript worker.
	@(link_name = "DedicatedWorkerGlobalScope_postSerialized") wr_DedicatedWorkerGlobalScope_postSerialized :: proc(data: [^]u8, data_len: u32) -> i32 ---
	// importScripts(url), one URL: fetched synchronously (same rules as the worker's script). The result is the
	// response's URL, a NUL byte, then the script. Network when it cannot be fetched or is not JavaScript; Type in a
	// module worker (importScripts is a classic worker's).
	@(link_name = "WorkerGlobalScope_importScript") wr_WorkerGlobalScope_importScript :: proc(url: [^]u8, url_len: u32, _buf: [^]u8, _cap: u32) -> i32 ---
	// Whether the calling worker's script is a module ({type: "module"}).
	@(link_name = "WorkerGlobalScope_isModule") wr_WorkerGlobalScope_isModule :: proc() -> i32 ---
	// new SharedWorker(url, {name, type, extendedLifetime}) from a document: the SharedWorker object (it gets `error`
	// events), connected to the shared worker of (the document's storage key, the URL, the name), which starts if none
	// runs. Its port: SharedWorker_portEnd. Syntax for an invalid URL, Security for a URL of another origin,
	// Not_Allowed when the browser refuses (shared workers disabled, too many: the console says why).
	@(link_name = "SharedWorker_connect") wr_SharedWorker_connect :: proc(url: [^]u8, url_len: u32, name: [^]u8, name_len: u32, type: i32, extended_lifetime: i32, _ret: ^u64) -> i32 ---
	// new Worker(blobURL) / new SharedWorker(blobURL): the same, with the script the engine read from the Blob the
	// URL stands for (blob: URLs live in the realm that made them, the browser cannot fetch them).
	@(link_name = "Worker_createScriptBytes") wr_Worker_createScriptBytes :: proc(url: [^]u8, url_len: u32, name: [^]u8, name_len: u32, type: i32, script: [^]u8, script_len: u32, _ret: ^u64) -> i32 ---
	// While wj_worker_error_to_global runs: the worker's uncaught error that its Worker object's error event did not
	// cancel, "message TAB filename" (HTML: it is reported in the owner's global, window.onerror).
	@(link_name = "Worker_pendingError") wr_Worker_pendingError :: proc(_buf: [^]u8, _cap: u32) -> i32 ---
	@(link_name = "SharedWorker_connectBytes") wr_SharedWorker_connectBytes :: proc(url: [^]u8, url_len: u32, name: [^]u8, name_len: u32, type: i32, extended_lifetime: i32, script: [^]u8, script_len: u32, _ret: ^u64) -> i32 ---
	// The port end of the SharedWorker's port, given once (the caller binds it with Port_bind); 0 afterwards.
	@(link_name = "SharedWorker_portEnd") wr_SharedWorker_portEnd :: proc(worker: u64) -> u64 ---
	// The end of the port of the next connect event of the calling shared worker (0: none waits).
	@(link_name = "SharedWorkerGlobalScope_takeConnection") wr_SharedWorkerGlobalScope_takeConnection :: proc() -> u64 ---
}

// module storageaccess
foreign import _wr_wj_storageaccess "storageaccess"
@(default_calling_convention = "contextless")
foreign _wr_wj_storageaccess {
	// document.hasStorageAccess(): a promise of true when the document uses its unpartitioned storage and cookies (a
	// first-party document always does), false else.
	@(link_name = "Document_hasStorageAccess") wr_Document_hasStorageAccess :: proc() -> u64 ---
	// document.requestStorageAccess(): resolves once the document uses its unpartitioned storage and cookies; rejects
	// with NotAllowedError when it is refused (no user gesture, a sandbox without
	// allow-storage-access-by-user-activation, the storage-access permission policy, the person or the preference).
	@(link_name = "Document_requestStorageAccess") wr_Document_requestStorageAccess :: proc() -> u64 ---
}

// module navigator
foreign import _wr_wj_navigator "navigator"
@(default_calling_convention = "contextless")
foreign _wr_wj_navigator {
	// A string member of Navigator.
	@(link_name = "Navigator_get") wr_Navigator_get :: proc(field: i32, _buf: [^]u8, _cap: u32) -> i32 ---
	// navigator.hardwareConcurrency: the logical processors the page may use.
	@(link_name = "Navigator_hardwareConcurrency") wr_Navigator_hardwareConcurrency :: proc() -> i32 ---
	// navigator.onLine: whether the system has a network connection.
	@(link_name = "Navigator_onLine") wr_Navigator_onLine :: proc() -> i32 ---
	// navigator.maxTouchPoints: the touches the touch screen takes at once (0: none), as browser.touch.expose says.
	@(link_name = "Navigator_maxTouchPoints") wr_Navigator_maxTouchPoints :: proc() -> i32 ---
	// navigator.cookieEnabled: whether the document may use cookies.
	@(link_name = "Navigator_cookieEnabled") wr_Navigator_cookieEnabled :: proc() -> i32 ---
	// navigator.userActivation.isActive: whether the document has transient activation now (a recent click or key press
	// within the transient activation window, security.webauthn.user_activation_ms).
	@(link_name = "UserActivation_isActive") wr_UserActivation_isActive :: proc() -> i32 ---
	// navigator.userActivation.hasBeenActive: whether the document has ever had an activation-triggering input (sticky:
	// it does not expire).
	@(link_name = "UserActivation_hasBeenActive") wr_UserActivation_hasBeenActive :: proc() -> i32 ---
	// navigator.sendBeacon(url, data): a POST queued with the page's policy (CORS no-cors mode, credentials included),
	// whose response nobody reads; it is not cancelled when the page closes. False when the beacon is refused (too large:
	// navigator.beacon_max_bytes, or an invalid URL). `content_type` "" sends none.
	@(link_name = "Beacon_send") wr_Beacon_send :: proc(url: [^]u8, url_len: u32, data: [^]u8, data_len: u32, content_type: [^]u8, content_type_len: u32) -> i32 ---
	// navigator.clipboard.writeText(data): puts the text on the system clipboard. Fulfilled when it is there; rejected
	// with NotAllowedError when the document is not focused and has no recent click or key press, when the clipboard
	// cannot be had, or when writing is turned off (navigator.clipboard_write).
	@(link_name = "Clipboard_writeText") wr_Clipboard_writeText :: proc(data: [^]u8, data_len: u32) -> u64 ---
	// navigator.clipboard.readText(): the text on the system clipboard (an empty string when it holds none). Rejected
	// with NotAllowedError unless the document is focused and has a recent click or key press (there is no permission
	// prompt), or when reading is turned off (navigator.clipboard_read).
	@(link_name = "Clipboard_readText") wr_Clipboard_readText :: proc() -> u64 ---
}

// module media
foreign import _wr_wj_media "media"
@(default_calling_convention = "contextless")
foreign _wr_wj_media {
	// window.matchMedia(query): an invalid query is "not all" (it never matches).
	@(link_name = "MediaQueryList_create") wr_MediaQueryList_create :: proc(query: [^]u8, query_len: u32) -> u64 ---
	// mql.media: the query list serialized.
