	// and takes them with IntersectionObserver_takeRecords. Syntax when a margin is not one to four lengths in px or %.
	@(link_name = "IntersectionObserver_create") wr_IntersectionObserver_create :: proc(notify: i32, user: i32, root: u64, root_margin: [^]u8, root_margin_len: u32, scroll_margin: [^]u8, scroll_margin_len: u32, thresholds: [^]u8, thresholds_len: u32, _ret: ^u64) -> i32 ---
	// observer.rootMargin / scrollMargin: the four sides, each a number and its unit ("10px 0px 10px 0px").
