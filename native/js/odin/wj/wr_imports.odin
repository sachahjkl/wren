	// A token that gives another agent of the cluster this shared memory; 0 when this realm may not (not cross-origin isolated).
	@(link_name = "WebAssembly_Memory_share") wr_WebAssembly_Memory_share :: proc(memory: i32) -> i64 ---
	// The shared memory of a token, a number: -1 when the token is not of this agent cluster.
	@(link_name = "WebAssembly_Memory_adopt") wr_WebAssembly_Memory_adopt :: proc(token: i64) -> i32 ---
	// A token that gives another agent of the cluster this module.
	@(link_name = "WebAssembly_Module_share") wr_WebAssembly_Module_share :: proc(module: u64) -> i64 ---
	// The module of a token: Data_Clone when the token is not of this agent cluster.
	@(link_name = "WebAssembly_Module_adopt") wr_WebAssembly_Module_adopt :: proc(token: i64, _ret: ^u64) -> i32 ---
	// HTML's cross-origin isolated capability of this realm.
	@(link_name = "WebAssembly_crossOriginIsolated") wr_WebAssembly_crossOriginIsolated :: proc() -> i32 ---
	// Whether this realm's agent may block ([[CanBlock]]): a dedicated or shared worker.
	@(link_name = "WebAssembly_canBlock") wr_WebAssembly_canBlock :: proc() -> i32 ---
	// new WebAssembly.Table: a number. `element` "r" (funcref) or "e" (externref), `maximum` -1 for none.
	@(link_name = "WebAssembly_Table_create") wr_WebAssembly_Table_create :: proc(element: [^]u8, element_len: u32, initial: i64, maximum: i64, init: i64) -> i32 ---
	// "r", "e", or "" for no such table.
	@(link_name = "WebAssembly_Table_element") wr_WebAssembly_Table_element :: proc(table: i32, _buf: [^]u8, _cap: u32) -> i32 ---
	@(link_name = "WebAssembly_Table_length") wr_WebAssembly_Table_length :: proc(table: i32) -> i64 ---
	// The cell at `index`, into `cell` (8 bytes): 0, or the opposite of a failure.
	@(link_name = "WebAssembly_Table_get") wr_WebAssembly_Table_get :: proc(table: i32, index: i64, cell: [^]u8, cell_cap: u32) -> i32 ---
	@(link_name = "WebAssembly_Table_set") wr_WebAssembly_Table_set :: proc(table: i32, index: i64, cell: i64) -> i32 ---
	// table.grow: the previous length.
	@(link_name = "WebAssembly_Table_grow") wr_WebAssembly_Table_grow :: proc(table: i32, delta: i64, init: i64) -> i64 ---
	// new WebAssembly.Global: a number. `type` a value type's letter.
	@(link_name = "WebAssembly_Global_create") wr_WebAssembly_Global_create :: proc(type: [^]u8, type_len: u32, mutable: i32, cell: i64) -> i32 ---
	// The value type's letter, then "m" when it can change; "" for no such global.
	@(link_name = "WebAssembly_Global_type") wr_WebAssembly_Global_type :: proc(global: i32, _buf: [^]u8, _cap: u32) -> i32 ---
	@(link_name = "WebAssembly_Global_get") wr_WebAssembly_Global_get :: proc(global: i32) -> i64 ---
	@(link_name = "WebAssembly_Global_set") wr_WebAssembly_Global_set :: proc(global: i32, cell: i64) -> i32 ---
	// A function of signature `sig` that runs import `slot` of the realm (wj_wasm_import).
	@(link_name = "WebAssembly_Func_import") wr_WebAssembly_Func_import :: proc(slot: i32, sig: [^]u8, sig_len: u32) -> i32 ---
	// The signature of a function, "params:results" (see src/wasm/user_store.odin); "" for no such function.
	@(link_name = "WebAssembly_Func_sig") wr_WebAssembly_Func_sig :: proc(func: i32, _buf: [^]u8, _cap: u32) -> i32 ---
	// Calls a function: `args` its cells (8 bytes each). 0, or the opposite of a failure.
	@(link_name = "WebAssembly_Func_call") wr_WebAssembly_Func_call :: proc(func: i32, args: [^]u8, args_len: u32) -> i32 ---
	// The results of the call that just ended, as cells (apart: the call may have moved the engine's memory).
	@(link_name = "WebAssembly_Func_results") wr_WebAssembly_Func_results :: proc(_buf: [^]u8, _cap: u32) -> i32 ---
	// The arguments of the import running, as cells.
	@(link_name = "WebAssembly_import_args") wr_WebAssembly_import_args :: proc(_buf: [^]u8, _cap: u32) -> i32 ---
	// The results of the import running, as cells.
	@(link_name = "WebAssembly_import_results") wr_WebAssembly_import_results :: proc(results: [^]u8, results_len: u32) ---
	// Why the import running failed.
	@(link_name = "WebAssembly_import_failed") wr_WebAssembly_import_failed :: proc(message: [^]u8, message_len: u32) ---
	// new WebAssembly.Tag: a number. `parameters` a value type's letter for each.
	@(link_name = "WebAssembly_Tag_create") wr_WebAssembly_Tag_create :: proc(parameters: [^]u8, parameters_len: u32) -> i32 ---
	// The parameters of a tag, one letter each.
	@(link_name = "WebAssembly_Tag_sig") wr_WebAssembly_Tag_sig :: proc(tag: i32, _buf: [^]u8, _cap: u32) -> i32 ---
	// The tag of the exception a call just failed with (failure 5); its values come from WebAssembly_Func_results.
	@(link_name = "WebAssembly_exception_tag") wr_WebAssembly_exception_tag :: proc() -> i32 ---
	// The import running ends by throwing a WebAssembly exception of `tag` with `values` (cells).
	@(link_name = "WebAssembly_import_throw") wr_WebAssembly_import_throw :: proc(tag: i32, values: [^]u8, values_len: u32) ---
	// The number of an externref no reference is left to, one at each call; 0 when there is none.
	@(link_name = "WebAssembly_extern_released") wr_WebAssembly_extern_released :: proc() -> i32 ---
	// new WebAssembly.Instance: a number. `externs` the number of a thing for each import (4 bytes each); the start function
	// runs here.
	@(link_name = "WebAssembly_Instance_create") wr_WebAssembly_Instance_create :: proc(module: u64, externs: [^]u8, externs_len: u32) -> i32 ---
	// The exports of an instance, as JSON: [{name, kind, id, index}].
	@(link_name = "WebAssembly_Instance_exports") wr_WebAssembly_Instance_exports :: proc(instance: i32, module: u64, _buf: [^]u8, _cap: u32) -> i32 ---
}

// module webcodecs
foreign import _wr_wj_webcodecs "webcodecs"
@(default_calling_convention = "contextless")
foreign _wr_wj_webcodecs {
	// /////////////////////////////
	// new VideoFrame(image, init): build from a drawable source (an element handle img / canvas / video, or an object
	// handle ImageBitmap / OffscreenCanvas / VideoFrame). The source's pixels are captured now. `timestamp` (microseconds)
	// is required for a source without an intrinsic one; `has_ts` says it was given. Invalid_State when the source has no
	// pixels (not loaded, empty, a GPU-only video), Quota when it is too large, Not_Supported when WebCodecs is off.
	@(link_name = "VideoFrame_fromImage") wr_VideoFrame_fromImage :: proc(source: u64, timestamp: i64, has_ts: i32, duration: i64, has_duration: i32, _ret: ^u64) -> i32 ---
	// new VideoFrame(bufferSource, init): build from raw pixel bytes with a VideoFrameBufferInit. `format`, `coded_w`,
	// `coded_h` and `timestamp` are required (the engine checks). `has_visible` / `has_display` carry the optional
	// visibleRect and displaySize; a custom plane layout gives `layout_offsets` / `layout_strides` (one per plane) when
	// `has_layout`. Colour space members are -1 when absent; `cp_has` says a colorSpace was given at all.
	@(link_name = "VideoFrame_fromBuffer") wr_VideoFrame_fromBuffer :: proc(data: [^]u8, data_len: u32, format: i32, coded_w: i32, coded_h: i32, timestamp: i64, duration: i64, has_duration: i32, vis_x: i32, vis_y: i32, vis_w: i32, vis_h: i32, has_visible: i32, display_w: i32, display_h: i32, has_display: i32, layout_offsets: [^]i32, layout_offsets_len: u32, layout_strides: [^]i32, layout_strides_len: u32, has_layout: i32, cp_prim: i32, cp_trans: i32, cp_matrix: i32, cp_full: i32, cp_has: i32, _ret: ^u64) -> i32 ---
	// /////////////////////////////
	// frame.format: -1 (null) for a closed frame.
	@(link_name = "VideoFrame_format") wr_VideoFrame_format :: proc(frame: u64) -> i32 ---
	@(link_name = "VideoFrame_codedWidth") wr_VideoFrame_codedWidth :: proc(frame: u64) -> u32 ---
	@(link_name = "VideoFrame_codedHeight") wr_VideoFrame_codedHeight :: proc(frame: u64) -> u32 ---
	@(link_name = "VideoFrame_displayWidth") wr_VideoFrame_displayWidth :: proc(frame: u64) -> u32 ---
	@(link_name = "VideoFrame_displayHeight") wr_VideoFrame_displayHeight :: proc(frame: u64) -> u32 ---
	// frame.timestamp / duration, in microseconds (duration is -1 when the frame has none, which the engine maps to null).
	@(link_name = "VideoFrame_timestamp") wr_VideoFrame_timestamp :: proc(frame: u64) -> i64 ---
	@(link_name = "VideoFrame_duration") wr_VideoFrame_duration :: proc(frame: u64) -> i64 ---
	// frame.visibleRect: `which` 0..3 selects x, y, width, height. -1 for a closed frame (null).
	@(link_name = "VideoFrame_visibleRect") wr_VideoFrame_visibleRect :: proc(frame: u64, which: i32) -> f64 ---
	// frame.colorSpace: which selects primaries (0), transfer (1), matrix (2) or full-range (3); -1 means null (absent),
	// else the enum index (VideoColorPrimaries / VideoTransferCharacteristics / VideoMatrixCoefficients) or the bool.
	@(link_name = "VideoFrame_colorSpace") wr_VideoFrame_colorSpace :: proc(frame: u64, which: i32) -> i32 ---
	// Whether the frame has been closed (its pixels freed).
	@(link_name = "VideoFrame_isClosed") wr_VideoFrame_isClosed :: proc(frame: u64) -> i32 ---
	// /////////////////////////////
	// frame.allocationSize(options): the bytes copyTo needs. `format` -1 keeps the frame's own; `has_rect` gives a crop
	// rectangle; a custom layout's strides are honoured when `has_layout`.
	@(link_name = "VideoFrame_allocationSize") wr_VideoFrame_allocationSize :: proc(frame: u64, format: i32, rx: i32, ry: i32, rw: i32, rh: i32, has_rect: i32, layout_offsets: [^]i32, layout_offsets_len: u32, layout_strides: [^]i32, layout_strides_len: u32, has_layout: i32, _ret: ^i32) -> i32 ---
	// frame.copyTo(destination, options): copies the frame (or its crop rectangle) into `dst` as `format` (-1 = own).
	// The plane layout used is kept on the frame (read it with VideoFrame_copyLayout); the return is the plane
	// count. The engine wraps this in a promise resolving to a PlaneLayout[]. Range for a rectangle outside the picture,
	// Not_Supported for an unsupported conversion, Invalid_State for a closed frame.
	@(link_name = "VideoFrame_copyTo") wr_VideoFrame_copyTo :: proc(frame: u64, dst: [^]u8, dst_cap: u32, format: i32, rx: i32, ry: i32, rw: i32, rh: i32, has_rect: i32, in_offsets: [^]i32, in_offsets_len: u32, in_strides: [^]i32, in_strides_len: u32, has_layout: i32, _ret: ^i32) -> i32 ---
	// The plane layout the last copyTo of `frame` used: `which` 0 is the offset, 1 the stride, of plane `plane`.
	@(link_name = "VideoFrame_copyLayout") wr_VideoFrame_copyLayout :: proc(frame: u64, plane: i32, which: i32) -> i32 ---
	// /////////////////////////////
	// frame.clone(): a new VideoFrame sharing the timing, with its own copy of the pixels.
	@(link_name = "VideoFrame_clone") wr_VideoFrame_clone :: proc(frame: u64, _ret: ^u64) -> i32 ---
	// frame.close(): free the pixels; the handle stays valid but closed.
	@(link_name = "VideoFrame_close") wr_VideoFrame_close :: proc(frame: u64) ---
	// postMessage transfer within one realm: move the pixels into a new object (owner = the receiving realm's instance),
	// closing the original. Data_Clone when it is already detached.
	@(link_name = "VideoFrame_transfer") wr_VideoFrame_transfer :: proc(frame: u64, owner: u32, _ret: ^u64) -> i32 ---
	// Cross-realm transfer (postMessage to a worker): the source realm detaches the frame into a process-wide token;
	// the destination realm adopts it. The pixels stay host-owned throughout. Both are used by structured clone
	// (native/js/runtime/clone.c). takeForTransfer returns 0 when the frame is already closed; adoptTransfer returns 0
	// when the token is unknown or the destination is over its memory budget.
	@(link_name = "VideoFrame_takeForTransfer") wr_VideoFrame_takeForTransfer :: proc(frame: u64) -> u64 ---
	@(link_name = "VideoFrame_adoptTransfer") wr_VideoFrame_adoptTransfer :: proc(token: u64) -> u64 ---
}

// module webcodecs_audio_decoder
foreign import _wr_wj_webcodecs_audio_decoder "webcodecs_audio_decoder"
@(default_calling_convention = "contextless")
foreign _wr_wj_webcodecs_audio_decoder {
	@(link_name = "AudioDecoder_create") wr_AudioDecoder_create :: proc(output: i32, output_user: i32, error: i32, error_user: i32, _ret: ^u64) -> i32 ---
	// AudioDecoder.isConfigSupported(config.codec): honest (AAC, MP3, Opus, FLAC).
	@(link_name = "AudioDecoder_isConfigSupported") wr_AudioDecoder_isConfigSupported :: proc(codec: [^]u8, codec_len: u32) -> i32 ---
	@(link_name = "AudioDecoder_configure") wr_AudioDecoder_configure :: proc(decoder: u64, codec: [^]u8, codec_len: u32, description: [^]u8, description_len: u32, sample_rate: u32, channels: u32) -> i32 ---
	@(link_name = "AudioDecoder_decode") wr_AudioDecoder_decode :: proc(decoder: u64, key: i32, timestamp: i64, duration: i64, has_duration: i32, data: [^]u8, data_len: u32) -> i32 ---
	@(link_name = "AudioDecoder_flush") wr_AudioDecoder_flush :: proc(decoder: u64) -> i32 ---
	@(link_name = "AudioDecoder_reset") wr_AudioDecoder_reset :: proc(decoder: u64) ---
	@(link_name = "AudioDecoder_close") wr_AudioDecoder_close :: proc(decoder: u64) ---
	@(link_name = "AudioDecoder_decodeQueueSize") wr_AudioDecoder_decodeQueueSize :: proc(decoder: u64) -> u32 ---
	@(link_name = "AudioDecoder_state") wr_AudioDecoder_state :: proc(decoder: u64) -> i32 ---
}

// module webcodecs_codec
foreign import _wr_wj_webcodecs_codec "webcodecs_codec"
@(default_calling_convention = "contextless")
foreign _wr_wj_webcodecs_codec {
	// new EncodedVideoChunk / EncodedAudioChunk({type, timestamp, duration, data}). `key` is type == "key".
	@(link_name = "EncodedVideoChunk_create") wr_EncodedVideoChunk_create :: proc(key: i32, timestamp: i64, duration: i64, has_duration: i32, data: [^]u8, data_len: u32, _ret: ^u64) -> i32 ---
	@(link_name = "EncodedAudioChunk_create") wr_EncodedAudioChunk_create :: proc(key: i32, timestamp: i64, duration: i64, has_duration: i32, data: [^]u8, data_len: u32, _ret: ^u64) -> i32 ---
	// chunk.type: true "key", false "delta".
	@(link_name = "EncodedVideoChunk_type") wr_EncodedVideoChunk_type :: proc(chunk: u64) -> i32 ---
	@(link_name = "EncodedVideoChunk_timestamp") wr_EncodedVideoChunk_timestamp :: proc(chunk: u64) -> i64 ---
	// chunk.duration: -1 (null) when absent.
	@(link_name = "EncodedVideoChunk_duration") wr_EncodedVideoChunk_duration :: proc(chunk: u64) -> i64 ---
	@(link_name = "EncodedVideoChunk_byteLength") wr_EncodedVideoChunk_byteLength :: proc(chunk: u64) -> u32 ---
	// chunk.copyTo(dst): the bytes written. Type when the destination is too small.
	@(link_name = "EncodedVideoChunk_copyTo") wr_EncodedVideoChunk_copyTo :: proc(chunk: u64, dst: [^]u8, dst_cap: u32, _ret: ^i32) -> i32 ---
	@(link_name = "EncodedAudioChunk_type") wr_EncodedAudioChunk_type :: proc(chunk: u64) -> i32 ---
	@(link_name = "EncodedAudioChunk_timestamp") wr_EncodedAudioChunk_timestamp :: proc(chunk: u64) -> i64 ---
	@(link_name = "EncodedAudioChunk_duration") wr_EncodedAudioChunk_duration :: proc(chunk: u64) -> i64 ---
	@(link_name = "EncodedAudioChunk_byteLength") wr_EncodedAudioChunk_byteLength :: proc(chunk: u64) -> u32 ---
	@(link_name = "EncodedAudioChunk_copyTo") wr_EncodedAudioChunk_copyTo :: proc(chunk: u64, dst: [^]u8, dst_cap: u32, _ret: ^i32) -> i32 ---
	// new AudioData({format, sampleRate, numberOfFrames, numberOfChannels, timestamp, data}).
	@(link_name = "AudioData_create") wr_AudioData_create :: proc(format: i32, sample_rate: f64, frames: u32, channels: u32, timestamp: i64, data: [^]u8, data_len: u32, _ret: ^u64) -> i32 ---
	// data.format: -1 (null) for a closed AudioData.
	@(link_name = "AudioData_format") wr_AudioData_format :: proc(data: u64) -> i32 ---
	@(link_name = "AudioData_sampleRate") wr_AudioData_sampleRate :: proc(data: u64) -> f64 ---
	@(link_name = "AudioData_numberOfFrames") wr_AudioData_numberOfFrames :: proc(data: u64) -> u32 ---
	@(link_name = "AudioData_numberOfChannels") wr_AudioData_numberOfChannels :: proc(data: u64) -> u32 ---
	@(link_name = "AudioData_timestamp") wr_AudioData_timestamp :: proc(data: u64) -> i64 ---
	// data.duration, microseconds.
	@(link_name = "AudioData_duration") wr_AudioData_duration :: proc(data: u64) -> i64 ---
	// data.allocationSize(options): bytes for one plane (planar) or the interleaved block, in `format` (-1 = own).
	@(link_name = "AudioData_allocationSize") wr_AudioData_allocationSize :: proc(data: u64, plane_index: u32, format: i32, frame_offset: u32, frame_count: u32, has_count: i32, _ret: ^i32) -> i32 ---
	// data.copyTo(destination, options): converts and copies; returns the bytes written.
	@(link_name = "AudioData_copyTo") wr_AudioData_copyTo :: proc(data: u64, dst: [^]u8, dst_cap: u32, plane_index: u32, format: i32, frame_offset: u32, frame_count: u32, has_count: i32, _ret: ^i32) -> i32 ---
	@(link_name = "AudioData_clone") wr_AudioData_clone :: proc(data: u64, _ret: ^u64) -> i32 ---
	@(link_name = "AudioData_close") wr_AudioData_close :: proc(data: u64) ---
}

// module webcodecs_encoders
foreign import _wr_wj_webcodecs_encoders "webcodecs_encoders"
@(default_calling_convention = "contextless")
foreign _wr_wj_webcodecs_encoders {
	@(link_name = "VideoEncoder_create") wr_VideoEncoder_create :: proc(output: i32, output_user: i32, error: i32, error_user: i32, _ret: ^u64) -> i32 ---
	@(link_name = "AudioEncoder_create") wr_AudioEncoder_create :: proc(output: i32, output_user: i32, error: i32, error_user: i32, _ret: ^u64) -> i32 ---
	// Honest: false for every codec (no encoder is linked).
	@(link_name = "VideoEncoder_isConfigSupported") wr_VideoEncoder_isConfigSupported :: proc(codec: [^]u8, codec_len: u32) -> i32 ---
	@(link_name = "AudioEncoder_isConfigSupported") wr_AudioEncoder_isConfigSupported :: proc(codec: [^]u8, codec_len: u32) -> i32 ---
	// Raises NotSupportedError (no encoder).
	@(link_name = "VideoEncoder_configure") wr_VideoEncoder_configure :: proc(encoder: u64, codec: [^]u8, codec_len: u32) -> i32 ---
	@(link_name = "AudioEncoder_configure") wr_AudioEncoder_configure :: proc(encoder: u64, codec: [^]u8, codec_len: u32) -> i32 ---
	@(link_name = "VideoEncoder_encode") wr_VideoEncoder_encode :: proc(encoder: u64) -> i32 ---
	@(link_name = "AudioEncoder_encode") wr_AudioEncoder_encode :: proc(encoder: u64) -> i32 ---
	@(link_name = "VideoEncoder_flush") wr_VideoEncoder_flush :: proc(encoder: u64) -> i32 ---
	@(link_name = "AudioEncoder_flush") wr_AudioEncoder_flush :: proc(encoder: u64) -> i32 ---
	@(link_name = "VideoEncoder_reset") wr_VideoEncoder_reset :: proc(encoder: u64) ---
	@(link_name = "AudioEncoder_reset") wr_AudioEncoder_reset :: proc(encoder: u64) ---
	@(link_name = "VideoEncoder_close") wr_VideoEncoder_close :: proc(encoder: u64) ---
	@(link_name = "AudioEncoder_close") wr_AudioEncoder_close :: proc(encoder: u64) ---
	@(link_name = "VideoEncoder_encodeQueueSize") wr_VideoEncoder_encodeQueueSize :: proc(encoder: u64) -> u32 ---
	@(link_name = "AudioEncoder_encodeQueueSize") wr_AudioEncoder_encodeQueueSize :: proc(encoder: u64) -> u32 ---
	@(link_name = "VideoEncoder_state") wr_VideoEncoder_state :: proc(encoder: u64) -> i32 ---
	@(link_name = "AudioEncoder_state") wr_AudioEncoder_state :: proc(encoder: u64) -> i32 ---
}

// module webcodecs_image
foreign import _wr_wj_webcodecs_image "webcodecs_image"
@(default_calling_convention = "contextless")
foreign _wr_wj_webcodecs_image {
	// new ImageDecoder({data, type, ...}): `data` is the encoded bytes (a BufferSource; the engine also reads a Blob or
	// a ReadableStream to bytes first), `mime` the `type` option. Quota past the image limits / page memory, Type for
	// empty data, Not_Supported when WebCodecs is off.
	@(link_name = "ImageDecoder_create") wr_ImageDecoder_create :: proc(data: [^]u8, data_len: u32, mime: [^]u8, mime_len: u32, prefer_animation: i32, _ret: ^u64) -> i32 ---
	// ImageDecoder.isTypeSupported(type): honest — true only for a format we decode (not SVG).
	@(link_name = "ImageDecoder_isTypeSupported") wr_ImageDecoder_isTypeSupported :: proc(mime: [^]u8, mime_len: u32) -> i32 ---
	// decoder.type.
	@(link_name = "ImageDecoder_type") wr_ImageDecoder_type :: proc(decoder: u64, _buf: [^]u8, _cap: u32) -> i32 ---
	// decoder.complete: the bytes are all available (always true for a BufferSource / Blob).
	@(link_name = "ImageDecoder_complete") wr_ImageDecoder_complete :: proc(decoder: u64) -> i32 ---
	// The decoded frame count (0 before a successful decode).
	@(link_name = "ImageDecoder_frameCount") wr_ImageDecoder_frameCount :: proc(decoder: u64) -> u32 ---
	// decoder.decode({frameIndex}): the frame wrapped as a VideoFrame (the engine wraps it in the ImageDecodeResult and
	// the promise). Range when frameIndex is past the frame count, Encoding when the image cannot be decoded,
	// Invalid_State when the decoder is closed.
	@(link_name = "ImageDecoder_decode") wr_ImageDecoder_decode :: proc(decoder: u64, frame_index: u32, _ret: ^u64) -> i32 ---
	// decoder.reset() / close().
	@(link_name = "ImageDecoder_reset") wr_ImageDecoder_reset :: proc(decoder: u64) ---
	@(link_name = "ImageDecoder_close") wr_ImageDecoder_close :: proc(decoder: u64) ---
	// decoder.tracks: the ImageTrackList (made on first access).
	@(link_name = "ImageDecoder_tracks") wr_ImageDecoder_tracks :: proc(decoder: u64) -> u64 ---
	@(link_name = "ImageTrackList_length") wr_ImageTrackList_length :: proc(list: u64) -> u32 ---
	// list[index]: Not_Found past the end (one track).
	@(link_name = "ImageTrackList_item") wr_ImageTrackList_item :: proc(list: u64, index: u32, _ret: ^u64) -> i32 ---
	// list.selectedIndex: -1 when none / not decoded yet.
	@(link_name = "ImageTrackList_selectedIndex") wr_ImageTrackList_selectedIndex :: proc(list: u64) -> i32 ---
	@(link_name = "ImageTrack_animated") wr_ImageTrack_animated :: proc(track: u64) -> i32 ---
	@(link_name = "ImageTrack_frameCount") wr_ImageTrack_frameCount :: proc(track: u64) -> u32 ---
	// track.repetitionCount: 0 play once, -1 the engine maps to Infinity (loops forever), else the repeat count.
	@(link_name = "ImageTrack_repetitionCount") wr_ImageTrack_repetitionCount :: proc(track: u64) -> i32 ---
	@(link_name = "ImageTrack_selected") wr_ImageTrack_selected :: proc(track: u64) -> i32 ---
}

// module webcodecs_video_decoder
foreign import _wr_wj_webcodecs_video_decoder "webcodecs_video_decoder"
@(default_calling_convention = "contextless")
foreign _wr_wj_webcodecs_video_decoder {
	// new VideoDecoder({output, error}).
	@(link_name = "VideoDecoder_create") wr_VideoDecoder_create :: proc(output: i32, output_user: i32, error: i32, error_user: i32, _ret: ^u64) -> i32 ---
	// VideoDecoder.isConfigSupported(config.codec): honest — true only when src/media can decode the codec.
	@(link_name = "VideoDecoder_isConfigSupported") wr_VideoDecoder_isConfigSupported :: proc(codec: [^]u8, codec_len: u32) -> i32 ---
	// decoder.configure({codec, description, codedWidth, codedHeight}).
	@(link_name = "VideoDecoder_configure") wr_VideoDecoder_configure :: proc(decoder: u64, codec: [^]u8, codec_len: u32, description: [^]u8, description_len: u32, coded_w: u32, coded_h: u32) -> i32 ---
	// decoder.decode(EncodedVideoChunk): the engine passes the chunk's fields and bytes.
	@(link_name = "VideoDecoder_decode") wr_VideoDecoder_decode :: proc(decoder: u64, key: i32, timestamp: i64, duration: i64, has_duration: i32, data: [^]u8, data_len: u32) -> i32 ---
	// decoder.flush(): drain the pipeline (the engine resolves the promise).
	@(link_name = "VideoDecoder_flush") wr_VideoDecoder_flush :: proc(decoder: u64) -> i32 ---
	@(link_name = "VideoDecoder_reset") wr_VideoDecoder_reset :: proc(decoder: u64) ---
	@(link_name = "VideoDecoder_close") wr_VideoDecoder_close :: proc(decoder: u64) ---
	@(link_name = "VideoDecoder_decodeQueueSize") wr_VideoDecoder_decodeQueueSize :: proc(decoder: u64) -> u32 ---
	// 0 unconfigured, 1 configured, 2 closed.
	@(link_name = "VideoDecoder_state") wr_VideoDecoder_state :: proc(decoder: u64) -> i32 ---
}

// module websocket
foreign import _wr_wj_websocket "websocket"
@(default_calling_convention = "contextless")
foreign _wr_wj_websocket {
	// new WebSocket(url, protocols): `protocols` is a comma-separated list ("" = none). Syntax for an invalid URL or
	// protocol list.
	@(link_name = "WebSocket_create") wr_WebSocket_create :: proc(url: [^]u8, url_len: u32, protocols: [^]u8, protocols_len: u32, _ret: ^u64) -> i32 ---
	@(link_name = "WebSocket_readyState") wr_WebSocket_readyState :: proc(socket: u64) -> i32 ---
	@(link_name = "WebSocket_url") wr_WebSocket_url :: proc(socket: u64, _buf: [^]u8, _cap: u32) -> i32 ---
	@(link_name = "WebSocket_protocol") wr_WebSocket_protocol :: proc(socket: u64, _buf: [^]u8, _cap: u32) -> i32 ---
	@(link_name = "WebSocket_extensions") wr_WebSocket_extensions :: proc(socket: u64, _buf: [^]u8, _cap: u32) -> i32 ---
	@(link_name = "WebSocket_bufferedAmount") wr_WebSocket_bufferedAmount :: proc(socket: u64) -> i64 ---
	// 0 = "arraybuffer" (buffer handles), the only binary type of this platform.
	@(link_name = "WebSocket_binaryType") wr_WebSocket_binaryType :: proc(socket: u64) -> i32 ---
	// Not_Supported for anything but 0.
	@(link_name = "WebSocket_setBinaryType") wr_WebSocket_setBinaryType :: proc(socket: u64, binary_type: i32) -> i32 ---
	// socket.send(text). Invalid_State while connecting.
	@(link_name = "WebSocket_send") wr_WebSocket_send :: proc(socket: u64, text: [^]u8, text_len: u32) -> i32 ---
	// socket.send(buffer): a binary message.
	@(link_name = "WebSocket_sendBuffer") wr_WebSocket_sendBuffer :: proc(socket: u64, data: u64) -> i32 ---
	// socket.close(code, reason): code < 0 means absent. Invalid_Access for a code that is not 1000 or 3000-4999,
	// Syntax for a reason over 123 bytes.
	@(link_name = "WebSocket_close") wr_WebSocket_close :: proc(socket: u64, code: i32, reason: [^]u8, reason_len: u32) -> i32 ---
	// CloseEvent.wasClean
	@(link_name = "CloseEvent_wasClean") wr_CloseEvent_wasClean :: proc(event: u64) -> i32 ---
}

// module workers
foreign import _wr_wj_workers "workers"
@(default_calling_convention = "contextless")
foreign _wr_wj_workers {
	// new Worker(url, {name}). Not_Allowed when the browser refuses it (the console says why).
	@(link_name = "Worker_create") wr_Worker_create :: proc(url: [^]u8, url_len: u32, name: [^]u8, name_len: u32, _ret: ^u64) -> i32 ---
	// worker.postMessage(message, transfer)
	@(link_name = "Worker_postMessage") wr_Worker_postMessage :: proc(worker: u64, message: [^]u8, message_len: u32, transfer: [^]u64, transfer_len: u32) -> i32 ---
	// worker.terminate()
	@(link_name = "Worker_terminate") wr_Worker_terminate :: proc(worker: u64) -> i32 ---
	// self, in a worker (null in a page).
	@(link_name = "DedicatedWorkerGlobalScope_self") wr_DedicatedWorkerGlobalScope_self :: proc() -> u64 ---
	// postMessage(message, transfer), in a worker.
	@(link_name = "DedicatedWorkerGlobalScope_postMessage") wr_DedicatedWorkerGlobalScope_postMessage :: proc(message: [^]u8, message_len: u32, transfer: [^]u64, transfer_len: u32) -> i32 ---
	// close(), in a worker.
	@(link_name = "DedicatedWorkerGlobalScope_close") wr_DedicatedWorkerGlobalScope_close :: proc() -> i32 ---
	// self.name, in a worker.
	@(link_name = "DedicatedWorkerGlobalScope_name") wr_DedicatedWorkerGlobalScope_name :: proc(_buf: [^]u8, _cap: u32) -> i32 ---
	// close(), in a shared worker: no connect event any more; the worker stops after the current task.
	@(link_name = "SharedWorkerGlobalScope_close") wr_SharedWorkerGlobalScope_close :: proc() -> i32 ---
	// self.name, in a shared worker.
	@(link_name = "SharedWorkerGlobalScope_name") wr_SharedWorkerGlobalScope_name :: proc(_buf: [^]u8, _cap: u32) -> i32 ---
	// location.href, in a worker: the script's URL.
	@(link_name = "WorkerGlobalScope_location") wr_WorkerGlobalScope_location :: proc(_buf: [^]u8, _cap: u32) -> i32 ---
	// The index-th buffer that came with a message event (null when none).
	@(link_name = "MessageEvent_transfer") wr_MessageEvent_transfer :: proc(event: u64, index: i32) -> u64 ---
}

