@(default_calling_convention = "contextless")
foreign _wr_wj_dnd {
	// new DataTransfer(): an empty store in read/write mode.
	@(link_name = "DataTransfer_create") wr_DataTransfer_create :: proc() -> u64 ---
	// dataTransfer.dropEffect ("none", "copy", "link", "move")
	@(link_name = "DataTransfer_get_dropEffect") wr_DataTransfer_get_dropEffect :: proc(dt: u64, _buf: [^]u8, _cap: u32) -> i32 ---
	// Values other than the four are ignored.
