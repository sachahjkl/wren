	// element.ended
	@(link_name = "HTMLMediaElement_ended") wr_HTMLMediaElement_ended :: proc(element: u64) -> i32 ---
	@(link_name = "HTMLMediaElement_defaultPlaybackRate") wr_HTMLMediaElement_defaultPlaybackRate :: proc(element: u64) -> f64 ---
	@(link_name = "HTMLMediaElement_set_defaultPlaybackRate") wr_HTMLMediaElement_set_defaultPlaybackRate :: proc(element: u64, value: f64) ---
	@(link_name = "HTMLMediaElement_playbackRate") wr_HTMLMediaElement_playbackRate :: proc(element: u64) -> f64 ---
	@(link_name = "HTMLMediaElement_set_playbackRate") wr_HTMLMediaElement_set_playbackRate :: proc(element: u64, value: f64) ---
	@(link_name = "HTMLMediaElement_preservesPitch") wr_HTMLMediaElement_preservesPitch :: proc(element: u64) -> i32 ---
	@(link_name = "HTMLMediaElement_set_preservesPitch") wr_HTMLMediaElement_set_preservesPitch :: proc(element: u64, value: i32) ---
	@(link_name = "HTMLMediaElement_volume") wr_HTMLMediaElement_volume :: proc(element: u64) -> f64 ---
	// element.volume = value: IndexSize outside [0, 1].
	@(link_name = "HTMLMediaElement_set_volume") wr_HTMLMediaElement_set_volume :: proc(element: u64, value: f64) -> i32 ---
	@(link_name = "HTMLMediaElement_muted") wr_HTMLMediaElement_muted :: proc(element: u64) -> i32 ---
	@(link_name = "HTMLMediaElement_set_muted") wr_HTMLMediaElement_set_muted :: proc(element: u64, value: i32) ---
	// element.buffered (0), played (1) or seekable (2) as pairs of f64 (start, end), seconds, little endian: the engine
	// makes the TimeRanges object of them.
