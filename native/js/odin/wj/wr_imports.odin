	@(link_name = "TextMetrics_actualBoundingBoxAscent") wr_TextMetrics_actualBoundingBoxAscent :: proc(m: u64) -> f64 ---
	@(link_name = "TextMetrics_actualBoundingBoxDescent") wr_TextMetrics_actualBoundingBoxDescent :: proc(m: u64) -> f64 ---
	@(link_name = "TextMetrics_emHeightAscent") wr_TextMetrics_emHeightAscent :: proc(m: u64) -> f64 ---
	@(link_name = "TextMetrics_emHeightDescent") wr_TextMetrics_emHeightDescent :: proc(m: u64) -> f64 ---
	@(link_name = "TextMetrics_hangingBaseline") wr_TextMetrics_hangingBaseline :: proc(m: u64) -> f64 ---
	@(link_name = "TextMetrics_alphabeticBaseline") wr_TextMetrics_alphabeticBaseline :: proc(m: u64) -> f64 ---
	@(link_name = "TextMetrics_ideographicBaseline") wr_TextMetrics_ideographicBaseline :: proc(m: u64) -> f64 ---
	// drawImage: `source` is an element handle (img, canvas, video) or an object handle (ImageBitmap, OffscreenCanvas);
	// `form` is the number of arguments after the image, 2 (dx, dy), 4 (dx, dy, dw, dh) or 8 (sx, sy, sw, sh, dx, dy, dw,
	// dh); the unused ones are 0. An image that is not available yet draws nothing; a broken one, or a canvas with no
	// pixels, raises Invalid_State.
	@(link_name = "CanvasDrawImage_drawImage") wr_CanvasDrawImage_drawImage :: proc(ctx: u64, source: u64, form: i32, sx: f64, sy: f64, sw: f64, sh: f64, dx: f64, dy: f64, dw: f64, dh: f64) -> i32 ---
	// The largest ImageData a script may make or read back, in bytes (canvas.max_image_data_bytes).
	@(link_name = "CanvasImageData_maxBytes") wr_CanvasImageData_maxBytes :: proc() -> u64 ---
	// getImageData's pixels: straight RGBA8 of the w x h block at (x, y) into `data` (w * h * 4 bytes). Security when the
	// canvas is tainted, Index_Size for an empty block (blocks over canvas.max_image_data_bytes never get here: the binding
	// asks CanvasImageData_maxBytes first and throws a RangeError).
	@(link_name = "CanvasImageData_get") wr_CanvasImageData_get :: proc(ctx: u64, x: i32, y: i32, w: i32, h: i32, data: [^]u8, data_cap: u32) -> i32 ---
	// putImageData: the dirty rectangle of `data` (data_w x data_h straight RGBA8) at (dx, dy).
	@(link_name = "CanvasImageData_put") wr_CanvasImageData_put :: proc(ctx: u64, data: [^]u8, data_len: u32, data_w: i32, data_h: i32, dx: i32, dy: i32, dirty_x: i32, dirty_y: i32, dirty_w: i32, dirty_h: i32) ---
	@(link_name = "CanvasPathDrawingStyles_lineWidth") wr_CanvasPathDrawingStyles_lineWidth :: proc(ctx: u64) -> f64 ---
	// Zero, negative or non-finite: ignored.
	@(link_name = "CanvasPathDrawingStyles_set_lineWidth") wr_CanvasPathDrawingStyles_set_lineWidth :: proc(ctx: u64, value: f64) ---
	@(link_name = "CanvasPathDrawingStyles_lineCap") wr_CanvasPathDrawingStyles_lineCap :: proc(ctx: u64, _buf: [^]u8, _cap: u32) -> i32 ---
	@(link_name = "CanvasPathDrawingStyles_set_lineCap") wr_CanvasPathDrawingStyles_set_lineCap :: proc(ctx: u64, value: [^]u8, value_len: u32) ---
