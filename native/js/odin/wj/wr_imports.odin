// module navigation
foreign import _wr_wj_navigation "navigation"
@(default_calling_convention = "contextless")
foreign _wr_wj_navigation {
	// navigation.entries(): "<current index>\n" then "<key> <id> <same document 0|1> <url>\n" per entry (the same-origin
	// entries around the current one; none for an opaque origin, current index -1).
	@(link_name = "Navigation_entries") wr_Navigation_entries :: proc(_buf: [^]u8, _cap: u32) -> i32 ---
	// Changes with every change of the session history (the engine reads the entries again only then).
	@(link_name = "Navigation_serial") wr_Navigation_serial :: proc() -> i64 ---
	// entry.getState(): the state of the entry `key` while its id is `id`; Not_Found when it has none.
	@(link_name = "Navigation_getState") wr_Navigation_getState :: proc(key: i64, id: i64, _buf: [^]u8, _cap: u32) -> i32 ---
	// navigation.updateCurrentEntry({state}): Data_Clone past history.max_state_bytes, Invalid_State without entries.
	@(link_name = "Navigation_updateCurrentEntry") wr_Navigation_updateCurrentEntry :: proc(state: [^]u8, state_len: u32) -> i32 ---
	// navigation.navigate(url, {state, history}) (history: 0 auto, 1 push, 2 replace): Syntax for an invalid URL,
	// Not_Supported for a push to a javascript: URL, Data_Clone for a state too big. navigate fires inside the call.
	@(link_name = "Navigation_navigate") wr_Navigation_navigate :: proc(url: [^]u8, url_len: u32, state: [^]u8, state_len: u32, history: i32) -> i32 ---
	// navigation.reload({state}): without a state the entry keeps its own.
	@(link_name = "Navigation_reload") wr_Navigation_reload :: proc(state: [^]u8, state_len: u32) -> i32 ---
	// navigation.traverseTo(key), back(), forward(): Invalid_State when no entry has this key. From a task of its own.
	@(link_name = "Navigation_traverseTo") wr_Navigation_traverseTo :: proc(key: i64) -> i32 ---
	// The navigation whose navigate event is being fired: "<type> <flags> <key> <id> <index> <url>" (type: 0 push,
	// 1 replace, 2 reload, 3 traverse; flags: 1 same document, 2 user initiated, 4 hash change, 8 can intercept,
	// 16 cancelable, 32 has a state). Not_Found outside the firing.
	@(link_name = "Navigation_pending") wr_Navigation_pending :: proc(_buf: [^]u8, _cap: u32) -> i32 ---
	// destination.getState() of that navigation: Not_Found when it has none.
	@(link_name = "Navigation_pendingState") wr_Navigation_pendingState :: proc(_buf: [^]u8, _cap: u32) -> i32 ---
	@(link_name = "Navigation_pendingSource") wr_Navigation_pendingSource :: proc(_ret: ^wr_NavigationSource) ---
	// navigation.activation: "<type> <from key>" (type as Navigation_pending's; from key 0: null, the entry of the
	// document this one replaced when it is among navigation.entries()); "" when the document was not reached by a
	// navigation the browser measured (activation null).
	@(link_name = "Navigation_activation") wr_Navigation_activation :: proc(_buf: [^]u8, _cap: u32) -> i32 ---
}

// module net
foreign import _wr_wj_net "net"
@(default_calling_convention = "contextless")
foreign _wr_wj_net {
	// fetch(url, {method, headers, body, ...}) with a callback. `headers` are "Name: value" lines (CR LF or LF). A
	// relative URL resolves against the document (or the worker's script).
	@(link_name = "Fetch_start") wr_Fetch_start :: proc(url: [^]u8, url_len: u32, callback: i32, user: i32, method: [^]u8, method_len: u32, headers: [^]u8, headers_len: u32, body: [^]u8, body_len: u32, options_mode: u32, options_credentials: u32, options_redirect: u32, options_referrer_policy: u32, options_no_referrer: i32, options_cache: u32) -> u64 ---
	@(link_name = "Fetch_state") wr_Fetch_state :: proc(request: u64) -> i32 ---
	// The HTTP status (0 for an opaque response).
	@(link_name = "Fetch_status") wr_Fetch_status :: proc(request: u64) -> i32 ---
	@(link_name = "Fetch_type") wr_Fetch_type :: proc(request: u64) -> i32 ---
	@(link_name = "Fetch_redirected") wr_Fetch_redirected :: proc(request: u64) -> i32 ---
	// The response headers the module may see: "Name: value" lines, CR LF terminated.
	@(link_name = "Fetch_headers") wr_Fetch_headers :: proc(request: u64, _buf: [^]u8, _cap: u32) -> i32 ---
	// The final URL (after redirects).
	@(link_name = "Fetch_url") wr_Fetch_url :: proc(request: u64, _buf: [^]u8, _cap: u32) -> i32 ---
	// Why it failed ("" before a failure).
	@(link_name = "Fetch_error") wr_Fetch_error :: proc(request: u64, _buf: [^]u8, _cap: u32) -> i32 ---
	// The fetch.Error_Kind of a failure (0 none, then Bad_URL, Bad_Scheme... in the browser's order).
	@(link_name = "Fetch_errorKind") wr_Fetch_errorKind :: proc(request: u64) -> i32 ---
	// The bytes of the body received so far.
	@(link_name = "Fetch_bodyLength") wr_Fetch_bodyLength :: proc(request: u64) -> u64 ---
	// Copies the body from `offset` into `buffer`; returns how many bytes were copied.
	@(link_name = "Fetch_readBody") wr_Fetch_readBody :: proc(request: u64, offset: u64, buffer: [^]u8, buffer_cap: u32) -> i32 ---
	// Cancels the request if needed and frees the record.
	@(link_name = "Fetch_release") wr_Fetch_release :: proc(request: u64) -> i32 ---
}

// module performance
foreign import _wr_wj_performance "performance"
@(default_calling_convention = "contextless")
foreign _wr_wj_performance {
	// performance.now()
	@(link_name = "Performance_now") wr_Performance_now :: proc() -> f64 ---
	// performance.timeOrigin (ms since the Unix epoch).
	@(link_name = "Performance_timeOrigin") wr_Performance_timeOrigin :: proc() -> f64 ---
	// performance.mark(name, {startTime}): a negative or NaN start_time means now. Syntax for an empty name.
	@(link_name = "Performance_mark") wr_Performance_mark :: proc(name: [^]u8, name_len: u32, start_time: f64) -> i32 ---
	// performance.measure(name, startMark, endMark): an empty start is the time origin, an empty end is now. Syntax for
	// a mark that does not exist.
	@(link_name = "Performance_measure") wr_Performance_measure :: proc(name: [^]u8, name_len: u32, start_mark: [^]u8, start_mark_len: u32, end_mark: [^]u8, end_mark_len: u32) -> i32 ---
	// performance.measure(name, {start, end})
	@(link_name = "Performance_measureTimes") wr_Performance_measureTimes :: proc(name: [^]u8, name_len: u32, start: f64, end: f64) -> i32 ---
	// How many entries match `name` ("" = any) and `entry_type`.
	@(link_name = "Performance_entryCount") wr_Performance_entryCount :: proc(name: [^]u8, name_len: u32, entry_type: i32) -> i32 ---
	// startTime of the index-th matching entry (NaN when none).
	@(link_name = "Performance_entryStartTime") wr_Performance_entryStartTime :: proc(name: [^]u8, name_len: u32, entry_type: i32, index: i32) -> f64 ---
	// duration of the index-th matching entry (NaN when none).
	@(link_name = "Performance_entryDuration") wr_Performance_entryDuration :: proc(name: [^]u8, name_len: u32, entry_type: i32, index: i32) -> f64 ---
	// name of the index-th matching entry: Not_Found when none.
	@(link_name = "Performance_entryName") wr_Performance_entryName :: proc(name: [^]u8, name_len: u32, entry_type: i32, index: i32, _buf: [^]u8, _cap: u32) -> i32 ---
	// entryType of the index-th matching entry (Mark or Measure): Not_Found when none.
	@(link_name = "Performance_entryType") wr_Performance_entryType :: proc(name: [^]u8, name_len: u32, entry_type: i32, index: i32, _ret: ^i32) -> i32 ---
	// performance.clearMarks(name): "" clears all.
	@(link_name = "Performance_clearMarks") wr_Performance_clearMarks :: proc(name: [^]u8, name_len: u32) ---
	// performance.clearMeasures(name): "" clears all.
	@(link_name = "Performance_clearMeasures") wr_Performance_clearMeasures :: proc(name: [^]u8, name_len: u32) ---
	// The timeline entries of `entry_type` (Navigation, Resource, Paint, Event or First_Input) whose sequence number is at
	// least `from_seq`, in order, as a JSON array of objects with the members of the entry's interface (name, startTime,
	// duration, initiatorType, responseStart...) and `seq`. A kept entry never changes; the buffers drop their oldest
	// entries (performance.resource_timing_entries...).
	@(link_name = "Performance_timeline") wr_Performance_timeline :: proc(entry_type: i32, from_seq: u64, _buf: [^]u8, _cap: u32) -> i32 ---
	// The sequence number the next entry of this kind will have.
	@(link_name = "Performance_timelineNextSeq") wr_Performance_timelineNextSeq :: proc(entry_type: i32) -> u64 ---
	// Wraps the DOM node a timeline entry refers to and returns its handle, or 0 when there is none or it is no longer in
	// the document: the element of the `index`-th member of entry `seq` of `entry_type` — for Largest_Contentful_Paint and
	// Element, index 0 is the entry's own element (its `element` attribute); for Layout_Shift, index i is the node of its
	// i-th source (LayoutShiftAttribution.node). The engine carries the other members of each entry in the JSON of
	// Performance_timeline; only live node handles come from here (a handle cannot be put in JSON and stay valid).
	@(link_name = "Performance_timelineNode") wr_Performance_timelineNode :: proc(entry_type: i32, seq: u64, index: u32) -> u64 ---
	// The kinds (bits 1 << PerformanceEntryType) a PerformanceObserver wants to hear of: only those wake the realm.
	@(link_name = "Performance_timelineInterest") wr_Performance_timelineInterest :: proc(kinds: u32) ---
	// Where the browser announces new entries of the kinds of Performance_timelineInterest (a task of the page).
	@(link_name = "Performance_onTimeline") wr_Performance_onTimeline :: proc(callback: i32, user: i32) ---
	// performance.setResourceTimingBufferSize(n) / performance.clearResourceTimings().
	@(link_name = "Performance_setResourceTimingBufferSize") wr_Performance_setResourceTimingBufferSize :: proc(entries: u32) ---
	@(link_name = "Performance_clearResourceTimings") wr_Performance_clearResourceTimings :: proc() ---
	// performance.timing (Navigation Timing 1): the moment of attribute `which` of PerformanceTiming (0 navigationStart,
	// 1 unloadEventStart ... 20 loadEventEnd, in the interface's order) on the page's timeline (ms since the time
	// origin), or NaN when it has not happened or does not apply (the attribute is then 0). The network phases of the
	// document's own fetch are not measured: they are all the time origin.
	@(link_name = "Performance_timingOf") wr_Performance_timingOf :: proc(which: i32) -> f64 ---
}

// module popover
foreign import _wr_wj_popover "popover"
@(default_calling_convention = "contextless")
foreign _wr_wj_popover {
	// element.showPopover({source}): Not_Supported without a valid popover attribute, Invalid_State when it is not
	// connected or is the fullscreen element; nothing when it is showing already or a beforetoggle listener cancelled.
	@(link_name = "Popover_show") wr_Popover_show :: proc(element: u64, source: u64) -> i32 ---
	// element.hidePopover(): the same errors.
	@(link_name = "Popover_hide") wr_Popover_hide :: proc(element: u64) -> i32 ---
	// element.togglePopover(force): force -1 none, 0 false (hide only), 1 true (show only). Whether it shows after.
	@(link_name = "Popover_toggle") wr_Popover_toggle :: proc(element: u64, force: i32, source: u64, _ret: ^u8) -> i32 ---
	// The popover attribute's state: 0 none, 1 auto, 2 manual, 3 hint.
	@(link_name = "Popover_state") wr_Popover_state :: proc(element: u64) -> i32 ---
	// The popover a button's popovertarget names (0: none).
	@(link_name = "Popover_targetOf") wr_Popover_targetOf :: proc(invoker: u64) -> u64 ---
}

// module ports
foreign import _wr_wj_ports "ports"
@(default_calling_convention = "contextless")
foreign _wr_wj_ports {
	// A new pair of entangled port ends: the first end's id (the second is that id + 1), owned by nobody yet.
	@(link_name = "Port_entangle") wr_Port_entangle :: proc() -> u64 ---
	// The calling realm owns this end from now on: what was posted to it meanwhile is delivered (each message from a
	// task: the engine's wj_port_message). Invalid_Argument for an end that is gone or owned.
	@(link_name = "Port_bind") wr_Port_bind :: proc(end: u64) -> i32 ---
	// The calling realm gives this end up (it is in a message being sent).
	@(link_name = "Port_ship") wr_Port_ship :: proc(end: u64) ---
	// port.postMessage(message, [ports]) on an end: delivered to the other end's owner (queued while it has none).
	// Data_Clone for a message over frames.max_message_bytes.
	@(link_name = "Port_post") wr_Port_post :: proc(end: u64, data: [^]u8, data_len: u32, ports: [^]u64, ports_len: u32) -> i32 ---
	// port.close(): the pair is disentangled; nothing more is delivered to either end.
	@(link_name = "Port_close") wr_Port_close :: proc(end: u64) ---
	// worker.postMessage(message, transfer) with MessagePorts in the transfer list (shipped as `ports`).
	@(link_name = "Worker_postSerializedPorts") wr_Worker_postSerializedPorts :: proc(worker: u64, data: [^]u8, data_len: u32, ports: [^]u64, ports_len: u32) -> i32 ---
	// postMessage(message, transfer) in a worker, with MessagePorts.
	@(link_name = "DedicatedWorkerGlobalScope_postSerializedPorts") wr_DedicatedWorkerGlobalScope_postSerializedPorts :: proc(data: [^]u8, data_len: u32, ports: [^]u64, ports_len: u32) -> i32 ---
	// new BroadcastChannel(name): a port end of the channel (the realm's origin and the name), owned by the calling
	// realm; 0 for an opaque origin (the object sends and receives nothing). Port_close closes it.
	@(link_name = "Broadcast_open") wr_Broadcast_open :: proc(name: [^]u8, name_len: u32) -> u64 ---
	// broadcastChannel.postMessage: the serialized message to every other end of the channel, in every realm.
	// Data_Clone for a message over frames.max_message_bytes.
	@(link_name = "Broadcast_post") wr_Broadcast_post :: proc(end: u64, data: [^]u8, data_len: u32) -> i32 ---
	// The port ends that came with a worker's message event (8 bytes each), given once: the caller binds them.
	@(link_name = "MessageEvent_portEnds") wr_MessageEvent_portEnds :: proc(event: u64, _buf: [^]u8, _cap: u32) -> i32 ---
}

// module scheduler
foreign import _wr_wj_scheduler "scheduler"
@(default_calling_convention = "contextless")
foreign _wr_wj_scheduler {
	// Post a task; `callback` (a function-table index) runs with (user: i32) when the task is due. `delay_ms` 0 queues
	// it at once. Returns the task id (for cancel / setPriority), 0 when there is no page realm.
	@(link_name = "Scheduler_post") wr_Scheduler_post :: proc(callback: u32, user: i32, priority: i32, delay_ms: f64) -> u64 ---
	// Drop a queued (or delayed) task: its signal aborted, or the realm released it.
	@(link_name = "Scheduler_cancel") wr_Scheduler_cancel :: proc(id: u64) -> i32 ---
	// Change a queued task's priority (TaskController.setPriority).
	@(link_name = "Scheduler_setPriority") wr_Scheduler_setPriority :: proc(id: u64, priority: i32) -> i32 ---
	// navigator.scheduling.isInputPending.
	@(link_name = "Scheduler_isInputPending") wr_Scheduler_isInputPending :: proc(include_continuous: i32) -> i32 ---
}

// module serviceworker
foreign import _wr_wj_serviceworker "serviceworker"
@(default_calling_convention = "contextless")
foreign _wr_wj_serviceworker {
	// navigator.serviceWorker.register(script, {scope, updateViaCache, type}): a promise of the registration's id,
	// resolved once the script ran (an unchanged script: at once; TypeError when it failed). Security outside a secure
	// context, for another origin or a scope outside what the script may control.
	@(link_name = "ServiceWorker_register") wr_ServiceWorker_register :: proc(script: [^]u8, script_len: u32, scope: [^]u8, scope_len: u32, update_via_cache: [^]u8, update_via_cache_len: u32, module: i32, _ret: ^u64) -> i32 ---
	// navigator.serviceWorker.ready: a promise of the id of the active registration whose scope holds the page.
	@(link_name = "ServiceWorker_ready") wr_ServiceWorker_ready :: proc() -> u64 ---
	// getRegistration(clientURL): the id of the registration matching the URL (0: none).
	@(link_name = "ServiceWorker_getRegistration") wr_ServiceWorker_getRegistration :: proc(client_url: [^]u8, client_url_len: u32) -> u64 ---
	// getRegistrations(): the ids of the origin's registrations, "\n"-separated.
	@(link_name = "ServiceWorker_registrationIds") wr_ServiceWorker_registrationIds :: proc(_buf: [^]u8, _cap: u32) -> i32 ---
	// navigator.serviceWorker.controller: the id of the version controlling the page (0: none).
	@(link_name = "ServiceWorker_controller") wr_ServiceWorker_controller :: proc() -> u64 ---
	// A registration ("" when it is gone), "\n"-separated: scope, updateViaCache, the installing, waiting and active
	// versions' ids (0: none), navigation preload enabled (1 / 0), its header value.
	@(link_name = "ServiceWorkerRegistration_info") wr_ServiceWorkerRegistration_info :: proc(id: u64, _buf: [^]u8, _cap: u32) -> i32 ---
	// A version ("" when unknown): its state, then its script URL ("\n"-separated).
	@(link_name = "ServiceWorker_info") wr_ServiceWorker_info :: proc(version: u64, _buf: [^]u8, _cap: u32) -> i32 ---
	// registration.unregister(): true when it was the origin's and is gone.
	@(link_name = "ServiceWorkerRegistration_unregisterId") wr_ServiceWorkerRegistration_unregisterId :: proc(id: u64) -> i32 ---
	// registration.update(): a promise of the registration's id once its script was checked (a new version then
	// installs). Invalid_State when the registration is gone.
	@(link_name = "ServiceWorkerRegistration_updateId") wr_ServiceWorkerRegistration_updateId :: proc(id: u64, _ret: ^u64) -> i32 ---
	// registration.navigationPreload: op 0 getState, 1 enable, 2 disable, 3 setHeaderValue(header). The state after:
	// enabled (1 / 0), "\n", the header value. Invalid_State for enable / disable without an active version.
	@(link_name = "ServiceWorkerRegistration_preload") wr_ServiceWorkerRegistration_preload :: proc(id: u64, op: i32, header: [^]u8, header_len: u32, _buf: [^]u8, _cap: u32) -> i32 ---
	// serviceWorker.postMessage(message): the serialized message to that version's worker (started if it stopped).
	@(link_name = "ServiceWorker_postToWorker") wr_ServiceWorker_postToWorker :: proc(version: u64, data: [^]u8, data_len: u32) -> i32 ---
	// The next message a service worker sent this page (Not_Found when none waits): the sender's version id (8 bytes)
	// then the serialized message.
	@(link_name = "ServiceWorker_takeMessage") wr_ServiceWorker_takeMessage :: proc(_buf: [^]u8, _cap: u32) -> i32 ---
	// In a service worker's realm: its registration's id (0 in any other realm), its version's id, scope, script URL.
	@(link_name = "ServiceWorkerGlobalScope_registration") wr_ServiceWorkerGlobalScope_registration :: proc() -> u64 ---
	@(link_name = "ServiceWorkerGlobalScope_version") wr_ServiceWorkerGlobalScope_version :: proc() -> u64 ---
	@(link_name = "ServiceWorkerGlobalScope_scope") wr_ServiceWorkerGlobalScope_scope :: proc(_buf: [^]u8, _cap: u32) -> i32 ---
	@(link_name = "ServiceWorkerGlobalScope_scriptURL") wr_ServiceWorkerGlobalScope_scriptURL :: proc(_buf: [^]u8, _cap: u32) -> i32 ---
	// The current event; its strings (0 URL / an answer's text, 1 method, 2 header lines), its body; done: the next one.
	@(link_name = "SwEvent_next") wr_SwEvent_next :: proc(_ret: ^wr_SwEventInfo) ---
	@(link_name = "SwEvent_text") wr_SwEvent_text :: proc(which: i32, _buf: [^]u8, _cap: u32) -> i32 ---
	@(link_name = "SwEvent_body") wr_SwEvent_body :: proc(_buf: [^]u8, _cap: u32) -> i32 ---
	@(link_name = "SwEvent_done") wr_SwEvent_done :: proc() ---
	// What the worker did: 1 install done (code 1 ok, 0 failed), 2 activate done, 3 respond (code = status, headers,
	// text = the response's URL, body), 4 fall back to the network, 5 fail (text: why), 6 skipWaiting, 7 clients.claim,
	// 8 a message to a client (code = the client's id, 0 every controlled page; body = the serialized message),
	// 10 a request answered later by an event 5 (id = the request's id, code = 1 clients.matchAll (headers:
	// "includeUncontrolled TAB type"), 2 clients.get (text: id), 3 clients.openWindow (text: URL), 4 navigate (text: URL,
	// headers: the client's id), 5 focus (text: the client's id), 6 registration.update, 7 registration.unregister),
	// 11 navigation preload (code = op as ServiceWorkerRegistration_preload, text = the header value).
	@(link_name = "ServiceWorkerGlobalScope_reply") wr_ServiceWorkerGlobalScope_reply :: proc(kind: i32, id: u64, code: i64, headers: [^]u8, headers_len: u32, text: [^]u8, text_len: u32, body: [^]u8, body_len: u32) ---
}

