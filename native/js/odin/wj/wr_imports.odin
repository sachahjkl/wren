	@(link_name = "AbortSignal_abort") wr_AbortSignal_abort :: proc(code: i64, reason: [^]u8, reason_len: u32) -> u64 ---
	// AbortSignal.timeout(ms): aborted with TimeoutError after `ms`. Range for a negative or NaN delay.
	@(link_name = "AbortSignal_timeout") wr_AbortSignal_timeout :: proc(ms: f64, _ret: ^u64) -> i32 ---
	// AbortSignal.any(signals). Invalid_Handle when one is not a signal, Range past abort.max_signal_sources.
	@(link_name = "AbortSignal_any") wr_AbortSignal_any :: proc(signals: [^]u64, signals_len: u32, _ret: ^u64) -> i32 ---
}

// module animations
foreign import _wr_wj_animations "animations"
@(default_calling_convention = "contextless")
foreign _wr_wj_animations {
	// new Animation(): no effect, on the document timeline. `notify(user)` runs as a microtask when there is something
	// to take (Animation_takeOps).
	@(link_name = "Animation_create") wr_Animation_create :: proc(notify: i32, user: i32) -> u64 ---
	// Sets the animation's keyframe effect: its target (0: none), its keyframes packed by the engine (offsets computed:
	// keyframes separated by U+001E, fields by U+001F: offset, easing, then property / value pairs), its timing
	// (duration NaN: "auto"; direction and fill as the style engine's enums, fill "auto" as none) and composite
	// operation (0 replace, 1 add, 2 accumulate). Type when an easing does not parse.
	@(link_name = "Animation_setEffect") wr_Animation_setEffect :: proc(animation: u64, target: u64, keyframes: [^]u8, keyframes_len: u32, duration: f64, delay: f64, end_delay: f64, iterations: f64, iteration_start: f64, direction: i32, fill: i32, easing: [^]u8, easing_len: u32, composite: i32) -> i32 ---
	// animation.effect = null
	@(link_name = "Animation_clearEffect") wr_Animation_clearEffect :: proc(animation: u64) ---
	// animation.timeline = document.timeline (true) or null (false).
	@(link_name = "Animation_setTimeline") wr_Animation_setTimeline :: proc(animation: u64, document_timeline: i32) ---
	// play(): Invalid_State to play backwards an effect that never ends.
	@(link_name = "Animation_play") wr_Animation_play :: proc(animation: u64) -> i32 ---
	// pause(): Invalid_State to pause before the start of an effect that never ends, backwards.
	@(link_name = "Animation_pause") wr_Animation_pause :: proc(animation: u64) -> i32 ---
	// finish(): Invalid_State at a playback rate of 0, or forwards with an effect that never ends.
	@(link_name = "Animation_finish") wr_Animation_finish :: proc(animation: u64) -> i32 ---
	// cancel()
	@(link_name = "Animation_cancel") wr_Animation_cancel :: proc(animation: u64) ---
	// reverse(): Invalid_State without a timeline, or as play().
	@(link_name = "Animation_reverse") wr_Animation_reverse :: proc(animation: u64) -> i32 ---
	// persist()
	@(link_name = "Animation_persist") wr_Animation_persist :: proc(animation: u64) ---
	// commitStyles(): the effect's animated values written into the target's style attribute. No_Modification_Allowed
	// without a target element, Invalid_State when it is not rendered.
	@(link_name = "Animation_commitStyles") wr_Animation_commitStyles :: proc(animation: u64) -> i32 ---
	// updatePlaybackRate(rate)
	@(link_name = "Animation_updatePlaybackRate") wr_Animation_updatePlaybackRate :: proc(animation: u64, rate: f64) ---
	// animation.playbackRate
	@(link_name = "Animation_playbackRate") wr_Animation_playbackRate :: proc(animation: u64) -> f64 ---
	// animation.playbackRate = rate (the current time is kept)
	@(link_name = "Animation_set_playbackRate") wr_Animation_set_playbackRate :: proc(animation: u64, rate: f64) ---
	// animation.currentTime (NaN: null)
	@(link_name = "Animation_currentTime") wr_Animation_currentTime :: proc(animation: u64) -> f64 ---
	// animation.currentTime = t: Type for null when the current time is resolved.
	@(link_name = "Animation_set_currentTime") wr_Animation_set_currentTime :: proc(animation: u64, time: f64) -> i32 ---
	// animation.startTime (NaN: null)
	@(link_name = "Animation_startTime") wr_Animation_startTime :: proc(animation: u64) -> f64 ---
	// animation.startTime = t (NaN: null)
	@(link_name = "Animation_set_startTime") wr_Animation_set_startTime :: proc(animation: u64, time: f64) ---
	// animation.playState
	@(link_name = "Animation_playState") wr_Animation_playState :: proc(animation: u64) -> i32 ---
	// animation.replaceState
	@(link_name = "Animation_replaceState") wr_Animation_replaceState :: proc(animation: u64) -> i32 ---
	// animation.pending
	@(link_name = "Animation_pending") wr_Animation_pending :: proc(animation: u64) -> i32 ---
	// What changed for the engine since the last call, one letter each, in order: r the ready promise is resolved, R it
	// is rejected (AbortError) and replaced by a resolved one, n a new pending ready promise; f the finished promise is
	// resolved, F it is rejected (AbortError) and replaced by a pending one, m a new pending finished promise; k / u the
	// wrapper must be kept alive (the animation may still fire events or show its effect) / may go.
	// Nothing is taken away: Animation_dropOps does once the engine applied them.
	@(link_name = "Animation_takeOps") wr_Animation_takeOps :: proc(animation: u64, _buf: [^]u8, _cap: u32) -> i32 ---
	// The first `count` letters of Animation_takeOps were applied.
	@(link_name = "Animation_dropOps") wr_Animation_dropOps :: proc(animation: u64, count: i32) ---
	// AnimationPlaybackEvent of the browser: which 0 currentTime, 1 timelineTime (NaN: null).
	@(link_name = "AnimationPlaybackEvent_time") wr_AnimationPlaybackEvent_time :: proc(event: u64, which: i32) -> f64 ---
	// effect.getComputedTiming() of the animation's effect: which 0 localTime, 1 progress, 2 currentIteration; NaN: null.
	@(link_name = "Animation_computedTiming") wr_Animation_computedTiming :: proc(animation: u64, which: i32) -> f64 ---
	// The relevant animations (Web Animations 1 §5.7) of `root` (with `subtree`: of it and its descendants), or of the
	// whole document when `root` is 0, in composite order: 8 bytes per handle.
	@(link_name = "Animation_relevant") wr_Animation_relevant :: proc(root: u64, subtree: i32, _buf: [^]u8, _cap: u32) -> i32 ---
	// What a CSS animation or transition is, for its wrapper; `notify(user)` then runs as for Animation_create.
	@(link_name = "Animation_cssBind") wr_Animation_cssBind :: proc(animation: u64, notify: i32, user: i32, _ret: ^wr_CssAnimationInfo) ---
	// CSSAnimation.animationName / CSSTransition.transitionProperty ("" once it is gone).
	@(link_name = "Animation_cssName") wr_Animation_cssName :: proc(animation: u64, _buf: [^]u8, _cap: u32) -> i32 ---
	// document.timeline.currentTime (NaN: null)
	@(link_name = "DocumentTimeline_currentTime") wr_DocumentTimeline_currentTime :: proc() -> f64 ---
	// Whether `easing` is an easing function (CSS Easing 2).
	@(link_name = "Animation_validEasing") wr_Animation_validEasing :: proc(easing: [^]u8, easing_len: u32) -> i32 ---
}

// module async
foreign import _wr_wj_async "async"
@(default_calling_convention = "contextless")
foreign _wr_wj_async {
	// queueMicrotask(callback)
	@(link_name = "queueMicrotask") wr_queueMicrotask :: proc(callback: i32, user: i32) ---
	// A pending promise the module settles itself.
	@(link_name = "Promise_create") wr_Promise_create :: proc() -> u64 ---
	// Fulfils a pending promise. Invalid_Argument when it is settled already.
	@(link_name = "Promise_resolve") wr_Promise_resolve :: proc(promise: u64, value: i64, text: [^]u8, text_len: u32) -> i32 ---
	// Rejects a pending promise with an Error code (or any value) and a message. Invalid_Argument when settled already.
	@(link_name = "Promise_reject") wr_Promise_reject :: proc(promise: u64, code: i64, message: [^]u8, message_len: u32) -> i32 ---
	// Adds a reaction; queued at once when the promise is settled already.
	@(link_name = "Promise_then") wr_Promise_then :: proc(promise: u64, callback: i32, user: i32) ---
	@(link_name = "Promise_state") wr_Promise_state :: proc(promise: u64) -> i32 ---
	// The value (fulfilled) or the code (rejected).
	@(link_name = "Promise_value") wr_Promise_value :: proc(promise: u64) -> i64 ---
	// The text result (fulfilled) or the message (rejected).
	@(link_name = "Promise_text") wr_Promise_text :: proc(promise: u64, _buf: [^]u8, _cap: u32) -> i32 ---
	// Promise.all: fulfilled (value = the count) when every one is, rejected with the first rejection's value and text.
	@(link_name = "Promise_all") wr_Promise_all :: proc(promises: [^]u64, promises_len: u32) -> u64 ---
	// Releases a host object of any kind.
	@(link_name = "Object_release") wr_Object_release :: proc(object: u64) -> i32 ---
	// The interface name of an object ("Promise", "ArrayBuffer"...).
	@(link_name = "Object_kind") wr_Object_kind :: proc(object: u64, _buf: [^]u8, _cap: u32) -> i32 ---
	// A buffer holding a copy of `data`. Quota past the page's memory limit.
	@(link_name = "Buffer_create") wr_Buffer_create :: proc(data: [^]u8, data_len: u32, _ret: ^u64) -> i32 ---
	// A zero-filled buffer of `length` bytes. Quota past the page's memory limit, Range for a negative length.
	@(link_name = "Buffer_alloc") wr_Buffer_alloc :: proc(length: i64, _ret: ^u64) -> i32 ---
	// byteLength (0 once detached by a transfer).
	@(link_name = "Buffer_length") wr_Buffer_length :: proc(buffer: u64) -> i64 ---
	// Copies bytes from `offset` into `destination`; returns how many.
	@(link_name = "Buffer_read") wr_Buffer_read :: proc(buffer: u64, offset: i64, destination: [^]u8, destination_cap: u32) -> i32 ---
	// Copies `source` into the buffer at `offset` (what fits); returns how many bytes were written.
	@(link_name = "Buffer_write") wr_Buffer_write :: proc(buffer: u64, offset: i64, source: [^]u8, source_len: u32) -> i32 ---
	// buffer.slice(start, end): a copy; negative positions count from the end. Quota past the page's memory limit.
	@(link_name = "Buffer_slice") wr_Buffer_slice :: proc(buffer: u64, start: i64, end: i64, _ret: ^u64) -> i32 ---
}

// module caches
foreign import _wr_wj_caches "caches"
@(default_calling_convention = "contextless")
foreign _wr_wj_caches {
	// Whether the calling realm may use caches.
	@(link_name = "CacheStorage_check") wr_CacheStorage_check :: proc() -> i32 ---
	// caches.open(name): the cache exists afterwards.
	@(link_name = "CacheStorage_openName") wr_CacheStorage_openName :: proc(name: [^]u8, name_len: u32) -> i32 ---
	// caches.has(name)
	@(link_name = "CacheStorage_hasName") wr_CacheStorage_hasName :: proc(name: [^]u8, name_len: u32, _ret: ^u8) -> i32 ---
	// caches.delete(name)
	@(link_name = "CacheStorage_deleteName") wr_CacheStorage_deleteName :: proc(name: [^]u8, name_len: u32, _ret: ^u8) -> i32 ---
	// caches.keys(): the names in creation order, "\n"-separated.
	@(link_name = "CacheStorage_names") wr_CacheStorage_names :: proc(_buf: [^]u8, _cap: u32) -> i32 ---
	// The ids of the entries of `cache` matching the request (url "" = every entry), decimal, "\n"-separated. Unless
	// ignore_vary, an entry whose response has a Vary header matches only when the named request headers are the same
	// in `request_headers` ("Name: value" lines) as in its stored request (Vary: * never matches).
	@(link_name = "Cache_matchIds") wr_Cache_matchIds :: proc(cache: [^]u8, cache_len: u32, url: [^]u8, url_len: u32, method: [^]u8, method_len: u32, request_headers: [^]u8, request_headers_len: u32, ignore_search: i32, ignore_method: i32, ignore_vary: i32, _buf: [^]u8, _cap: u32) -> i32 ---
	// The header lines of an entry's request (Not_Found when it is gone).
	@(link_name = "Cache_entryRequestHeaders") wr_Cache_entryRequestHeaders :: proc(cache: [^]u8, cache_len: u32, id: u64, _buf: [^]u8, _cap: u32) -> i32 ---
	// An entry's head: status, statusText, the response's URL, the request's method, the request's URL, then the
	// response's header lines, "\n"-separated (Not_Found when it is gone).
	@(link_name = "Cache_entryHead") wr_Cache_entryHead :: proc(cache: [^]u8, cache_len: u32, id: u64, _buf: [^]u8, _cap: u32) -> i32 ---
	// An entry's body (Not_Found when it is gone).
	@(link_name = "Cache_entryBody") wr_Cache_entryBody :: proc(cache: [^]u8, cache_len: u32, id: u64, _buf: [^]u8, _cap: u32) -> i32 ---
	// cache.put(request, response) with the response's body read: replaces the entries the request matches (Vary
	// considered). Quota past caches.max_bytes_per_origin.
	@(link_name = "Cache_putEntry") wr_Cache_putEntry :: proc(cache: [^]u8, cache_len: u32, url: [^]u8, url_len: u32, request_headers: [^]u8, request_headers_len: u32, status: i32, status_text: [^]u8, status_text_len: u32, response_url: [^]u8, response_url_len: u32, headers: [^]u8, headers_len: u32, body: [^]u8, body_len: u32) -> i32 ---
	// cache.delete(request, options)
	@(link_name = "Cache_deleteEntries") wr_Cache_deleteEntries :: proc(cache: [^]u8, cache_len: u32, url: [^]u8, url_len: u32, method: [^]u8, method_len: u32, request_headers: [^]u8, request_headers_len: u32, ignore_search: i32, ignore_method: i32, ignore_vary: i32, _ret: ^u8) -> i32 ---
}

// module canvas
foreign import _wr_wj_canvas "canvas"
@(default_calling_convention = "contextless")
foreign _wr_wj_canvas {
	// /////////////////////////////
	// canvas.width: the `width` attribute as HTML parses it (a non-negative integer, 300 when absent or invalid).
	@(link_name = "HTMLCanvasElement_width") wr_HTMLCanvasElement_width :: proc(canvas: u64) -> u32 ---
	// canvas.width = n: sets the attribute and resets the canvas (cleared, context state back to the default).
	@(link_name = "HTMLCanvasElement_set_width") wr_HTMLCanvasElement_set_width :: proc(canvas: u64, value: u32) ---
	// canvas.height: 150 when absent or invalid.
	@(link_name = "HTMLCanvasElement_height") wr_HTMLCanvasElement_height :: proc(canvas: u64) -> u32 ---
	@(link_name = "HTMLCanvasElement_set_height") wr_HTMLCanvasElement_set_height :: proc(canvas: u64, value: u32) ---
	// getContext("2d", { alpha, willReadFrequently }): the canvas's 2D context, made on the first call (the bitmap is
	// allocated then) and the same object afterwards. `alpha` false: an opaque canvas (black until drawn on). Quota when
	// the size is over canvas.max_dimension / canvas.max_pixels or the page's canvas memory (canvas.max_page_bytes).
	@(link_name = "HTMLCanvasElement_context2d") wr_HTMLCanvasElement_context2d :: proc(canvas: u64, alpha: i32, will_read_frequently: i32, _ret: ^u64) -> i32 ---
	// The canvas (an element, or an OffscreenCanvas handle) encoded as `type`: "image/png", or "image/jpeg" at `quality`
	// (0 to 1; outside it the default, canvas.encode.jpeg_quality). Security when the canvas is tainted. An empty buffer
	// for a canvas with no pixels (width or height 0).
	@(link_name = "Canvas_encode") wr_Canvas_encode :: proc(canvas: u64, type: [^]u8, type_len: u32, quality: f64, _ret: ^u64) -> i32 ---
	// /////////////////////////////
	// context.canvas
	@(link_name = "CanvasRenderingContext2D_canvas") wr_CanvasRenderingContext2D_canvas :: proc(ctx: u64) -> u64 ---
	// OffscreenCanvasRenderingContext2D.canvas
	@(link_name = "OffscreenCanvasRenderingContext2D_canvas") wr_OffscreenCanvasRenderingContext2D_canvas :: proc(ctx: u64) -> u64 ---
	// getContextAttributes().alpha / .willReadFrequently
	@(link_name = "CanvasSettings_alpha") wr_CanvasSettings_alpha :: proc(ctx: u64) -> i32 ---
	@(link_name = "CanvasSettings_willReadFrequently") wr_CanvasSettings_willReadFrequently :: proc(ctx: u64) -> i32 ---
	// save(): ignored once canvas.max_save_depth states are saved.
	@(link_name = "CanvasState_save") wr_CanvasState_save :: proc(ctx: u64) ---
	@(link_name = "CanvasState_restore") wr_CanvasState_restore :: proc(ctx: u64) ---
	// reset(): clears the canvas and puts every attribute back.
	@(link_name = "CanvasState_reset") wr_CanvasState_reset :: proc(ctx: u64) ---
	// Always false: the software canvas is not lost.
	@(link_name = "CanvasState_isContextLost") wr_CanvasState_isContextLost :: proc(ctx: u64) -> i32 ---
	@(link_name = "CanvasTransform_scale") wr_CanvasTransform_scale :: proc(ctx: u64, x: f64, y: f64) ---
	@(link_name = "CanvasTransform_rotate") wr_CanvasTransform_rotate :: proc(ctx: u64, angle: f64) ---
	@(link_name = "CanvasTransform_translate") wr_CanvasTransform_translate :: proc(ctx: u64, x: f64, y: f64) ---
	@(link_name = "CanvasTransform_transform") wr_CanvasTransform_transform :: proc(ctx: u64, m11: f64, m12: f64, m21: f64, m22: f64, m41: f64, m42: f64) ---
	@(link_name = "CanvasTransform_setTransform") wr_CanvasTransform_setTransform :: proc(ctx: u64, m11: f64, m12: f64, m21: f64, m22: f64, m41: f64, m42: f64) ---
	@(link_name = "CanvasTransform_resetTransform") wr_CanvasTransform_resetTransform :: proc(ctx: u64) ---
	// One element of the current transform: 0 to 5 are a, b, c, d, e, f.
	@(link_name = "CanvasTransform_matrixElement") wr_CanvasTransform_matrixElement :: proc(ctx: u64, index: i32) -> f64 ---
	@(link_name = "CanvasCompositing_globalAlpha") wr_CanvasCompositing_globalAlpha :: proc(ctx: u64) -> f64 ---
	// Outside 0 to 1, or NaN: ignored.
	@(link_name = "CanvasCompositing_set_globalAlpha") wr_CanvasCompositing_set_globalAlpha :: proc(ctx: u64, value: f64) ---
	@(link_name = "CanvasCompositing_globalCompositeOperation") wr_CanvasCompositing_globalCompositeOperation :: proc(ctx: u64, _buf: [^]u8, _cap: u32) -> i32 ---
	// source-over, source-in, source-out, source-atop, destination-over / -in / -out / -atop, lighter, copy, xor, and the
	// blend modes multiply, screen, overlay, darken, lighten, color-dodge, color-burn, hard-light, soft-light, difference,
	// exclusion, hue, saturation, color, luminosity. Anything else is ignored.
	@(link_name = "CanvasCompositing_set_globalCompositeOperation") wr_CanvasCompositing_set_globalCompositeOperation :: proc(ctx: u64, value: [^]u8, value_len: u32) ---
	@(link_name = "CanvasImageSmoothing_imageSmoothingEnabled") wr_CanvasImageSmoothing_imageSmoothingEnabled :: proc(ctx: u64) -> i32 ---
	@(link_name = "CanvasImageSmoothing_set_imageSmoothingEnabled") wr_CanvasImageSmoothing_set_imageSmoothingEnabled :: proc(ctx: u64, value: i32) ---
	@(link_name = "CanvasImageSmoothing_imageSmoothingQuality") wr_CanvasImageSmoothing_imageSmoothingQuality :: proc(ctx: u64, _buf: [^]u8, _cap: u32) -> i32 ---
	@(link_name = "CanvasImageSmoothing_set_imageSmoothingQuality") wr_CanvasImageSmoothing_set_imageSmoothingQuality :: proc(ctx: u64, value: [^]u8, value_len: u32) ---
	// Which kind of style fillStyle (`stroke` false) or strokeStyle currently is.
	@(link_name = "CanvasStyle_kind") wr_CanvasStyle_kind :: proc(ctx: u64, stroke: i32) -> i32 ---
	// The color style as `#rrggbb` or `rgba(...)`.
	@(link_name = "CanvasStyle_color") wr_CanvasStyle_color :: proc(ctx: u64, stroke: i32, _buf: [^]u8, _cap: u32) -> i32 ---
	// The script object of a gradient or pattern style: the one it was set from while that is alive, else a new one the
	// caller owns (0 for a color style).
	@(link_name = "CanvasStyle_object") wr_CanvasStyle_object :: proc(ctx: u64, stroke: i32) -> u64 ---
	// fillStyle = "color": false (and nothing changes) when it is not a color.
	@(link_name = "CanvasStyle_setColor") wr_CanvasStyle_setColor :: proc(ctx: u64, stroke: i32, color: [^]u8, color_len: u32) -> i32 ---
	// fillStyle = gradient or pattern object.
	@(link_name = "CanvasStyle_setObject") wr_CanvasStyle_setObject :: proc(ctx: u64, stroke: i32, object: u64) ---
	// createLinearGradient (the arguments are finite: the binding refuses others).
	@(link_name = "CanvasFillStrokeStyles_createLinearGradient") wr_CanvasFillStrokeStyles_createLinearGradient :: proc(ctx: u64, x0: f64, y0: f64, x1: f64, y1: f64) -> u64 ---
	// createRadialGradient: a negative radius raises Index_Size.
	@(link_name = "CanvasFillStrokeStyles_createRadialGradient") wr_CanvasFillStrokeStyles_createRadialGradient :: proc(ctx: u64, x0: f64, y0: f64, r0: f64, x1: f64, y1: f64, r1: f64, _ret: ^u64) -> i32 ---
	@(link_name = "CanvasFillStrokeStyles_createConicGradient") wr_CanvasFillStrokeStyles_createConicGradient :: proc(ctx: u64, start_angle: f64, x: f64, y: f64) -> u64 ---
	// createPattern(image, repetition): `source` is an element handle (img, canvas) or an object handle (ImageBitmap,
	// OffscreenCanvas); repetition "repeat", "repeat-x", "repeat-y", "no-repeat". Not_Found: no pattern (an image that is
	// not available yet); Syntax: bad repetition; Invalid_State: a canvas with no pixels.
	@(link_name = "Canvas_createPattern") wr_Canvas_createPattern :: proc(ctx: u64, source: u64, repetition: [^]u8, repetition_len: u32, _ret: ^u64) -> i32 ---
	// addColorStop(offset, color): Index_Size outside 0 to 1, Syntax for a color that does not parse.
	@(link_name = "CanvasGradient_addColorStop") wr_CanvasGradient_addColorStop :: proc(gradient: u64, offset: f64, color: [^]u8, color_len: u32) -> i32 ---
	// pattern.setTransform(matrix): the six elements a b c d e f as m11 m12 m21 m22 m41 m42.
	@(link_name = "CanvasPattern_setTransformMatrix") wr_CanvasPattern_setTransformMatrix :: proc(pattern: u64, m11: f64, m12: f64, m21: f64, m22: f64, m41: f64, m42: f64) ---
	@(link_name = "CanvasShadowStyles_shadowOffsetX") wr_CanvasShadowStyles_shadowOffsetX :: proc(ctx: u64) -> f64 ---
	@(link_name = "CanvasShadowStyles_set_shadowOffsetX") wr_CanvasShadowStyles_set_shadowOffsetX :: proc(ctx: u64, value: f64) ---
	@(link_name = "CanvasShadowStyles_shadowOffsetY") wr_CanvasShadowStyles_shadowOffsetY :: proc(ctx: u64) -> f64 ---
	@(link_name = "CanvasShadowStyles_set_shadowOffsetY") wr_CanvasShadowStyles_set_shadowOffsetY :: proc(ctx: u64, value: f64) ---
	@(link_name = "CanvasShadowStyles_shadowBlur") wr_CanvasShadowStyles_shadowBlur :: proc(ctx: u64) -> f64 ---
	// Negative or non-finite: ignored.
	@(link_name = "CanvasShadowStyles_set_shadowBlur") wr_CanvasShadowStyles_set_shadowBlur :: proc(ctx: u64, value: f64) ---
	@(link_name = "CanvasShadowStyles_shadowColor") wr_CanvasShadowStyles_shadowColor :: proc(ctx: u64, _buf: [^]u8, _cap: u32) -> i32 ---
	@(link_name = "CanvasShadowStyles_set_shadowColor") wr_CanvasShadowStyles_set_shadowColor :: proc(ctx: u64, value: [^]u8, value_len: u32) ---
	@(link_name = "CanvasFilters_filter") wr_CanvasFilters_filter :: proc(ctx: u64, _buf: [^]u8, _cap: u32) -> i32 ---
	// "none" or a list of CSS filter functions (blur, brightness, contrast, grayscale, hue-rotate, invert, opacity,
	// saturate, sepia, drop-shadow); anything that does not parse is ignored.
	@(link_name = "CanvasFilters_set_filter") wr_CanvasFilters_set_filter :: proc(ctx: u64, value: [^]u8, value_len: u32) ---
	@(link_name = "CanvasRect_clearRect") wr_CanvasRect_clearRect :: proc(ctx: u64, x: f64, y: f64, w: f64, h: f64) ---
	@(link_name = "CanvasRect_fillRect") wr_CanvasRect_fillRect :: proc(ctx: u64, x: f64, y: f64, w: f64, h: f64) ---
	@(link_name = "CanvasRect_strokeRect") wr_CanvasRect_strokeRect :: proc(ctx: u64, x: f64, y: f64, w: f64, h: f64) ---
	@(link_name = "CanvasDrawPath_beginPath") wr_CanvasDrawPath_beginPath :: proc(ctx: u64) ---
	// fill(path?, rule): `path` is a Path2D handle, 0 for the current path; rule "nonzero" or "evenodd".
	@(link_name = "CanvasDrawPath_fill") wr_CanvasDrawPath_fill :: proc(ctx: u64, path: u64, rule: [^]u8, rule_len: u32) ---
	@(link_name = "CanvasDrawPath_stroke") wr_CanvasDrawPath_stroke :: proc(ctx: u64, path: u64) ---
	@(link_name = "CanvasDrawPath_clip") wr_CanvasDrawPath_clip :: proc(ctx: u64, path: u64, rule: [^]u8, rule_len: u32) ---
