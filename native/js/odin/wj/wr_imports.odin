	@(link_name = "Element_attachInternals") wr_Element_attachInternals :: proc(element: u64, _ret: ^u64) -> i32 ---
	// internals.shadowRoot: the host's shadow root when it is available to element internals (else null).
	@(link_name = "ElementInternals_shadowRootOf") wr_ElementInternals_shadowRootOf :: proc(internals: u64) -> u64 ---
	// The element of an ElementInternals.
	@(link_name = "ElementInternals_element") wr_ElementInternals_element :: proc(internals: u64) -> u64 ---
	// CustomStateSet: add / delete (true when it was there) / has / clear / the states (each followed by a NUL byte).
	@(link_name = "CustomStates_add") wr_CustomStates_add :: proc(internals: u64, state: [^]u8, state_len: u32) ---
	@(link_name = "CustomStates_delete") wr_CustomStates_delete :: proc(internals: u64, state: [^]u8, state_len: u32) -> i32 ---
	@(link_name = "CustomStates_has") wr_CustomStates_has :: proc(internals: u64, state: [^]u8, state_len: u32) -> i32 ---
	@(link_name = "CustomStates_clear") wr_CustomStates_clear :: proc(internals: u64) ---
	@(link_name = "CustomStates_list") wr_CustomStates_list :: proc(internals: u64, _buf: [^]u8, _cap: u32) -> i32 ---
	// new CSSStyleSheet(options): a constructed stylesheet (an object of the page).
	@(link_name = "CSSStyleSheet_create") wr_CSSStyleSheet_create :: proc(media: [^]u8, media_len: u32, disabled: i32, base_url: [^]u8, base_url_len: u32) -> u64 ---
	// replaceSync(text) / replace(text): the rules of `text`, @import rules dropped.
	@(link_name = "CSSStyleSheet_replaceText") wr_CSSStyleSheet_replaceText :: proc(sheet: u64, text: [^]u8, text_len: u32) -> i32 ---
	// The number of top-level rules, and the text of one (Index_Size past the end).
	@(link_name = "CSSStyleSheet_ruleCount") wr_CSSStyleSheet_ruleCount :: proc(sheet: u64) -> u32 ---
	@(link_name = "CSSStyleSheet_ruleText") wr_CSSStyleSheet_ruleText :: proc(sheet: u64, index: u32, _buf: [^]u8, _cap: u32) -> i32 ---
	// insertRule(rule, index): Index_Size past the end, Syntax when `rule` is not one rule; the index.
	@(link_name = "CSSStyleSheet_insertRuleAt") wr_CSSStyleSheet_insertRuleAt :: proc(sheet: u64, rule: [^]u8, rule_len: u32, index: u32, _ret: ^u32) -> i32 ---
	// deleteRule(index): Index_Size past the end.
	@(link_name = "CSSStyleSheet_deleteRuleAt") wr_CSSStyleSheet_deleteRuleAt :: proc(sheet: u64, index: u32) -> i32 ---
	// sheet.disabled
	@(link_name = "CSSStyleSheet_isDisabled") wr_CSSStyleSheet_isDisabled :: proc(sheet: u64) -> i32 ---
	@(link_name = "CSSStyleSheet_setDisabled") wr_CSSStyleSheet_setDisabled :: proc(sheet: u64, disabled: i32) ---
	// sheet.media.mediaText
	@(link_name = "CSSStyleSheet_mediaText") wr_CSSStyleSheet_mediaText :: proc(sheet: u64, _buf: [^]u8, _cap: u32) -> i32 ---
	@(link_name = "CSSStyleSheet_setMediaText") wr_CSSStyleSheet_setMediaText :: proc(sheet: u64, media: [^]u8, media_len: u32) ---
	// Whether `sheet` is a constructed stylesheet of this page.
	@(link_name = "CSSStyleSheet_isConstructed") wr_CSSStyleSheet_isConstructed :: proc(sheet: u64) -> i32 ---
	// document.adoptedStyleSheets / shadowRoot.adoptedStyleSheets = sheets (constructed sheets, in order):
	// Not_Allowed for a sheet that was not constructed.
	@(link_name = "DocumentOrShadowRoot_adopt") wr_DocumentOrShadowRoot_adopt :: proc(root: u64, sheets: [^]u64, sheets_len: u32) -> i32 ---
	// new XMLSerializer().serializeToString(node): the node and its subtree as XML (DOM Parsing §3.2, not
	// well-formed-checked). Range past page.max_fetch_bytes.
	@(link_name = "XMLSerializer_serialize") wr_XMLSerializer_serialize :: proc(node: u64, _buf: [^]u8, _cap: u32) -> i32 ---
}

// module encoding
foreign import _wr_wj_encoding "encoding"
@(default_calling_convention = "contextless")
foreign _wr_wj_encoding {
	// new TextEncoder().encode(text): a buffer of UTF-8. Quota past the page's memory limit.
	@(link_name = "TextEncoder_encode") wr_TextEncoder_encode :: proc(text: [^]u8, text_len: u32, _ret: ^u64) -> i32 ---
	// encoder.encodeInto(source, destination): invalid UTF-8 in the source counts as U+FFFD (3 bytes).
	@(link_name = "TextEncoder_encodeInto") wr_TextEncoder_encodeInto :: proc(source: [^]u8, source_len: u32, destination: [^]u8, destination_cap: u32, _ret: ^wr_EncodeIntoResult) ---
	// new TextDecoder(label, options): Range for an unknown label ("" = utf-8).
	@(link_name = "TextDecoder_create") wr_TextDecoder_create :: proc(label: [^]u8, label_len: u32, options: u32, _ret: ^u64) -> i32 ---
	// decoder.encoding (lower case)
	@(link_name = "TextDecoder_encoding") wr_TextDecoder_encoding :: proc(decoder: u64, _buf: [^]u8, _cap: u32) -> i32 ---
	// decoder.fatal and decoder.ignoreBOM
	@(link_name = "TextDecoder_flags") wr_TextDecoder_flags :: proc(decoder: u64) -> u32 ---
	// decoder.decode(input, {stream}): Type for invalid input in fatal mode. TextDecoder_output reads the whole result
	// again when the buffer was too small.
	@(link_name = "TextDecoder_decode") wr_TextDecoder_decode :: proc(decoder: u64, input: [^]u8, input_len: u32, stream: i32, _buf: [^]u8, _cap: u32) -> i32 ---
	// The same from a buffer (a fetch body, a stream chunk).
	@(link_name = "TextDecoder_decodeBuffer") wr_TextDecoder_decodeBuffer :: proc(decoder: u64, input: u64, stream: i32, _buf: [^]u8, _cap: u32) -> i32 ---
	// The result of the last decode.
	@(link_name = "TextDecoder_output") wr_TextDecoder_output :: proc(decoder: u64, _buf: [^]u8, _cap: u32) -> i32 ---
}

// module events
foreign import _wr_wj_events "events"
@(default_calling_convention = "contextless")
foreign _wr_wj_events {
	// target.addEventListener(type, listener, options). Returns the listener's id (for removeEventListener); adding the
	// same (type, callback, user) again returns the existing id.
	@(link_name = "EventTarget_addEventListener") wr_EventTarget_addEventListener :: proc(target: u64, type: [^]u8, type_len: u32, callback: i32, user: i32, options: u32, _ret: ^i32) -> i32 ---
	// target.removeEventListener(id). Not_Found when there is no such listener.
	@(link_name = "EventTarget_removeEventListener") wr_EventTarget_removeEventListener :: proc(target: u64, id: i32) -> i32 ---
	// target.dispatchEvent(new Event(type, init)): false when a listener cancelled it.
	@(link_name = "EventTarget_dispatchEvent") wr_EventTarget_dispatchEvent :: proc(target: u64, type: [^]u8, type_len: u32, init: u32, _ret: ^u8) -> i32 ---
	// event.preventDefault() (ignored when the event is not cancelable).
	@(link_name = "Event_preventDefault") wr_Event_preventDefault :: proc(event: u64) ---
	// event.stopPropagation()
	@(link_name = "Event_stopPropagation") wr_Event_stopPropagation :: proc(event: u64) ---
	// event.stopImmediatePropagation()
	@(link_name = "Event_stopImmediatePropagation") wr_Event_stopImmediatePropagation :: proc(event: u64) ---
	// event.target
	@(link_name = "Event_target") wr_Event_target :: proc(event: u64) -> u64 ---
	// event.currentTarget
	@(link_name = "Event_currentTarget") wr_Event_currentTarget :: proc(event: u64) -> u64 ---
	// event.type
	@(link_name = "Event_type") wr_Event_type :: proc(event: u64, _buf: [^]u8, _cap: u32) -> i32 ---
	// event.defaultPrevented
	@(link_name = "Event_defaultPrevented") wr_Event_defaultPrevented :: proc(event: u64) -> i32 ---
	// The main string payload of a non-UI event: MessageEvent.data, InputEvent.data, ErrorEvent.message...
	@(link_name = "Event_data") wr_Event_data :: proc(event: u64, _buf: [^]u8, _cap: u32) -> i32 ---
	// The second string payload: CloseEvent.reason, InputEvent.inputType, MessageEvent.lastEventId, the reason of an abort...
	@(link_name = "Event_text") wr_Event_text :: proc(event: u64, _buf: [^]u8, _cap: u32) -> i32 ---
	// The numeric payload: CloseEvent.code, an abort reason's code, the number of buffers of a message...
	@(link_name = "Event_code") wr_Event_code :: proc(event: u64) -> i64 ---
	// The object payload: a buffer, SubmitEvent.submitter, FocusEvent.relatedTarget, FormDataEvent.formData...
	@(link_name = "Event_object") wr_Event_object :: proc(event: u64) -> u64 ---
	// MouseEvent.clientX
	@(link_name = "MouseEvent_clientX") wr_MouseEvent_clientX :: proc(event: u64) -> f64 ---
	// MouseEvent.clientY
	@(link_name = "MouseEvent_clientY") wr_MouseEvent_clientY :: proc(event: u64) -> f64 ---
	// MouseEvent.button
	@(link_name = "MouseEvent_button") wr_MouseEvent_button :: proc(event: u64) -> i32 ---
	// KeyboardEvent.keyCode
	@(link_name = "KeyboardEvent_keyCode") wr_KeyboardEvent_keyCode :: proc(event: u64) -> i32 ---
	// The number of touches in a list of a TouchEvent the browser dispatches (0 for another event).
	@(link_name = "TouchEvent_count") wr_TouchEvent_count :: proc(event: u64, list: i32) -> i32 ---
	// A touch of that list (Invalid_Argument past its end).
	@(link_name = "TouchEvent_touch") wr_TouchEvent_touch :: proc(event: u64, list: i32, index: i32, _ret: ^wr_TouchPoint) -> i32 ---
	// Element.setPointerCapture(pointerId): Not_Found for a pointer that is not active, Invalid_State for an element
	// that is not connected. The capture takes effect at the pointer's next event (gotpointercapture).
	@(link_name = "PointerCapture_set") wr_PointerCapture_set :: proc(element: u64, pointer_id: i32) -> i32 ---
	// Element.releasePointerCapture(pointerId): Not_Found for a pointer that is not active.
	@(link_name = "PointerCapture_release") wr_PointerCapture_release :: proc(element: u64, pointer_id: i32) -> i32 ---
	// Element.hasPointerCapture(pointerId)
	@(link_name = "PointerCapture_has") wr_PointerCapture_has :: proc(element: u64, pointer_id: i32) -> i32 ---
	// The details of a UI event being dispatched.
	@(link_name = "Event_uiData") wr_Event_uiData :: proc(event: u64, _ret: ^wr_UiEventData) ---
	// KeyboardEvent.key ("Enter", "a"...): "Unidentified" when unknown.
	@(link_name = "UiEvent_key") wr_UiEvent_key :: proc(event: u64, _buf: [^]u8, _cap: u32) -> i32 ---
	// KeyboardEvent.code ("KeyA", "Enter"...): "" when unknown.
	@(link_name = "UiEvent_code") wr_UiEvent_code :: proc(event: u64, _buf: [^]u8, _cap: u32) -> i32 ---
	// target.dispatchEvent(event) for an Event the engine owns: like EventTarget_dispatchEvent, with the engine's
	// identifier of the object (Event_engineId gives it back to the listeners) and its timeStamp. Returns false when a
	// listener cancelled it. The event is not trusted (isTrusted is false).
	@(link_name = "EventTarget_dispatchEngineEvent") wr_EventTarget_dispatchEngineEvent :: proc(target: u64, type: [^]u8, type_len: u32, init: u32, engine_id: i64, time_stamp: f64, _ret: ^u8) -> i32 ---
	// The engine's identifier given to EventTarget_dispatchEngineEvent (0 for an event the browser made).
	@(link_name = "Event_engineId") wr_Event_engineId :: proc(event: u64) -> i64 ---
	// The interface of the wrapper of an event the browser made (MouseEvent, KeyboardEvent...): an index into the
	// engine's interface table.
	@(link_name = "Event_interface") wr_Event_interface :: proc(event: u64) -> u32 ---
	// Whether the event is still being dispatched (its handle is live).
	@(link_name = "Event_isLive") wr_Event_isLive :: proc(event: u64) -> i32 ---
	// event.bubbles
	@(link_name = "Event_bubbles") wr_Event_bubbles :: proc(event: u64) -> i32 ---
	// event.cancelable
	@(link_name = "Event_cancelable") wr_Event_cancelable :: proc(event: u64) -> i32 ---
	// event.composed: whether the event crosses shadow boundaries (the browser's UI events, fullscreenchange...).
	@(link_name = "Event_composed") wr_Event_composed :: proc(event: u64) -> i32 ---
	// event.eventPhase: 0 none, 1 capturing, 2 at target, 3 bubbling.
	@(link_name = "Event_eventPhase") wr_Event_eventPhase :: proc(event: u64) -> i32 ---
	// event.timeStamp, on the performance.now() timeline of the page.
	@(link_name = "Event_timeStamp") wr_Event_timeStamp :: proc(event: u64) -> f64 ---
	// event.isTrusted
	@(link_name = "Event_isTrusted") wr_Event_isTrusted :: proc(event: u64) -> i32 ---
	// Whether stopPropagation was called.
	@(link_name = "Event_propagationStopped") wr_Event_propagationStopped :: proc(event: u64) -> i32 ---
	// new EventTarget(): a host object with nothing but listeners.
	@(link_name = "EventTarget_create") wr_EventTarget_create :: proc() -> u64 ---
	// event.composedPath() of the event being dispatched: what a listener at the current target may see (closed
	// shadow trees it is not in are hidden); 8 bytes per handle, the Window's handle for the Window.
	@(link_name = "Event_composedPathPacked") wr_Event_composedPathPacked :: proc(event: u64, _buf: [^]u8, _cap: u32) -> i32 ---
	// The target of the last event dispatched by EventTarget_dispatchEngineEvent once its dispatch ended (0: null, it
	// was in a shadow tree).
	@(link_name = "EventTarget_lastTarget") wr_EventTarget_lastTarget :: proc() -> u64 ---
	// ... and its relatedTarget (0: null or cleared).
	@(link_name = "EventTarget_lastRelated") wr_EventTarget_lastRelated :: proc() -> u64 ---
	// The relatedTarget (a node) of the next EventTarget_dispatchEngineEvent: retargeted along its path.
	@(link_name = "Event_setNextRelated") wr_Event_setNextRelated :: proc(related: u64) ---
	// The relatedTarget of the event being dispatched as the current listener sees it (retargeted; 0: null).
	@(link_name = "Event_relatedNow") wr_Event_relatedNow :: proc(event: u64) -> u64 ---
	// Whether the current listener's node was in a shadow tree when the event's path was built (window.event is then
	// left as it was).
	@(link_name = "Event_inShadowTreeNow") wr_Event_inShadowTreeNow :: proc(event: u64) -> i32 ---
}

// module eventsource
foreign import _wr_wj_eventsource "eventsource"
@(default_calling_convention = "contextless")
foreign _wr_wj_eventsource {
	// new EventSource(url, {withCredentials}). Syntax for an invalid URL.
	@(link_name = "EventSource_create") wr_EventSource_create :: proc(url: [^]u8, url_len: u32, with_credentials: i32, _ret: ^u64) -> i32 ---
	@(link_name = "EventSource_readyState") wr_EventSource_readyState :: proc(source: u64) -> i32 ---
	@(link_name = "EventSource_url") wr_EventSource_url :: proc(source: u64, _buf: [^]u8, _cap: u32) -> i32 ---
	@(link_name = "EventSource_withCredentials") wr_EventSource_withCredentials :: proc(source: u64) -> i32 ---
	// source.close()
	@(link_name = "EventSource_close") wr_EventSource_close :: proc(source: u64) ---
	// MessageEvent.origin
	@(link_name = "MessageEvent_origin") wr_MessageEvent_origin :: proc(event: u64, _buf: [^]u8, _cap: u32) -> i32 ---
	// MessageEvent.lastEventId ("" for messages that do not come from an EventSource).
	@(link_name = "MessageEvent_lastEventId") wr_MessageEvent_lastEventId :: proc(event: u64, _buf: [^]u8, _cap: u32) -> i32 ---
}

// module fetch
foreign import _wr_wj_fetch "fetch"
@(default_calling_convention = "contextless")
foreign _wr_wj_fetch {
	// fetch(url, init): the body is `body`, or the bytes of `body_buffer` when given. Type when the signal is not an
	// AbortSignal or the buffer not a buffer.
	@(link_name = "Fetch_promise") wr_Fetch_promise :: proc(url: [^]u8, url_len: u32, method: [^]u8, method_len: u32, headers: [^]u8, headers_len: u32, body: [^]u8, body_len: u32, body_buffer: u64, signal: u64, options_mode: u32, options_credentials: u32, options_redirect: u32, options_referrer_policy: u32, options_no_referrer: i32, options_cache: u32, _ret: ^u64) -> i32 ---
	// The callback API (Fetch_start) with an abort signal and an optional buffer body.
	@(link_name = "Fetch_startWithSignal") wr_Fetch_startWithSignal :: proc(url: [^]u8, url_len: u32, callback: i32, user: i32, method: [^]u8, method_len: u32, headers: [^]u8, headers_len: u32, body: [^]u8, body_len: u32, body_buffer: u64, signal: u64, options_mode: u32, options_credentials: u32, options_redirect: u32, options_referrer_policy: u32, options_no_referrer: i32, options_cache: u32, _ret: ^u64) -> i32 ---
	// A synchronous XMLHttpRequest of a worker: the request Fetch_startWithSignal would make, waited for on the worker's
	// thread; the finished record (read it with Fetch_status, Fetch_headers, Fetch_readBody..., then release it).
	// Not_Supported in a document (its thread is the page's), Timeout past `timeout_ms` (0: none), Network on a failure.
	@(link_name = "Fetch_sync") wr_Fetch_sync :: proc(url: [^]u8, url_len: u32, method: [^]u8, method_len: u32, headers: [^]u8, headers_len: u32, body: [^]u8, body_len: u32, options_mode: u32, options_credentials: u32, options_redirect: u32, options_referrer_policy: u32, options_no_referrer: i32, options_cache: u32, timeout_ms: u32, _ret: ^u64) -> i32 ---
	// response.text(): settles with the text (decoded as UTF-8) in the promise's text, its length as value.
	// A callback fetch can be read once it is done (Invalid_State before).
	@(link_name = "Response_text") wr_Response_text :: proc(response: u64) -> u64 ---
	// response.arrayBuffer(): settles with a buffer.
	@(link_name = "Response_arrayBuffer") wr_Response_arrayBuffer :: proc(response: u64) -> u64 ---
	// response.bytes(): the same as arrayBuffer on this platform.
	@(link_name = "Response_bytes") wr_Response_bytes :: proc(response: u64) -> u64 ---
	// response.bodyUsed
	@(link_name = "Response_bodyUsed") wr_Response_bodyUsed :: proc(response: u64) -> i32 ---
	// response.body: the body as a stream. Type when the body was used already.
	@(link_name = "Response_body") wr_Response_body :: proc(response: u64, _ret: ^u64) -> i32 ---
	// reader.read(): settles with a buffer, or with 0 at the end.
	@(link_name = "Stream_read") wr_Stream_read :: proc(stream: u64) -> u64 ---
	// reader.cancel(): the download stops, waiting reads settle with "done".
	@(link_name = "Stream_cancel") wr_Stream_cancel :: proc(stream: u64) ---
	// fetch with a FormData body: the Content-Type (with its boundary) is set unless `headers` name one. Same callback
	// and options as Fetch_start.
	@(link_name = "Fetch_startFormData") wr_Fetch_startFormData :: proc(url: [^]u8, url_len: u32, data: u64, callback: i32, user: i32, method: [^]u8, method_len: u32, headers: [^]u8, headers_len: u32, enctype: i32, options_mode: u32, options_credentials: u32, options_redirect: u32, options_referrer_policy: u32, options_no_referrer: i32, options_cache: u32) -> u64 ---
}

