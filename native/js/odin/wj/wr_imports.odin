	@(link_name = "console_error") wr_console_error :: proc(message: [^]u8, message_len: u32) ---
}

// module credentials
foreign import _wr_wj_credentials "credentials"
@(default_calling_convention = "contextless")
foreign _wr_wj_credentials {
	// navigator.credentials.create({publicKey}): settles with a PublicKeyCredential, or 0 (null) for silent mediation.
	// Conditional mediation is not supported (Not_Allowed).
	@(link_name = "CredentialsContainer_create") wr_CredentialsContainer_create :: proc(options: [^]u8, options_len: u32, mediation: i32, signal: u64) -> u64 ---
	// navigator.credentials.get({publicKey}): settles with a PublicKeyCredential, or 0 (null) for silent mediation.
	// Conditional mediation is not supported (Type, as Credential Management says).
	@(link_name = "CredentialsContainer_get") wr_CredentialsContainer_get :: proc(options: [^]u8, options_len: u32, mediation: i32, signal: u64) -> u64 ---
	// navigator.credentials.preventSilentAccess(): nothing to forget for public key credentials (they always involve
	// the user); settles once the document is checked.
	@(link_name = "CredentialsContainer_preventSilentAccess") wr_CredentialsContainer_preventSilentAccess :: proc() -> u64 ---
	// Whether the API is on for this document (security.webauthn.enabled and a secure context).
	@(link_name = "PublicKeyCredential_enabled") wr_PublicKeyCredential_enabled :: proc() -> i32 ---
	// PublicKeyCredential.isUserVerifyingPlatformAuthenticatorAvailable() (Windows Hello is set up).
	@(link_name = "PublicKeyCredential_isUserVerifyingPlatformAuthenticatorAvailable") wr_PublicKeyCredential_isUserVerifyingPlatformAuthenticatorAvailable :: proc() -> u64 ---
	// PublicKeyCredential.isConditionalMediationAvailable(): false (no autofill of passkeys yet).
	@(link_name = "PublicKeyCredential_isConditionalMediationAvailable") wr_PublicKeyCredential_isConditionalMediationAvailable :: proc() -> u64 ---
	// PublicKeyCredential.getClientCapabilities(): settles with the record as JSON text ({"hybridTransport":true,...},
	// keys in ascending order, extensions as "extension:<id>").
	@(link_name = "PublicKeyCredential_getClientCapabilities") wr_PublicKeyCredential_getClientCapabilities :: proc() -> u64 ---
	// The RP ID check of the signal methods (signalUnknownCredential...): Security when `rp_id` is not a registrable
	// domain suffix of, nor equal to, the document's domain. The signals themselves reach no authenticator on this
	// platform: their promises settle with undefined once checked, as for an authenticator that ignores them.
	@(link_name = "PublicKeyCredential_checkRpId") wr_PublicKeyCredential_checkRpId :: proc(rp_id: [^]u8, rp_id_len: u32) -> i32 ---
	// true for an assertion (get), false for a new credential (create).
	@(link_name = "PublicKeyCredential_isAssertion") wr_PublicKeyCredential_isAssertion :: proc(credential: u64) -> i32 ---
	// id: rawId in base64url.
	@(link_name = "PublicKeyCredential_id") wr_PublicKeyCredential_id :: proc(credential: u64, _buf: [^]u8, _cap: u32) -> i32 ---
	// A binary member as a new buffer. Not_Found when the credential has none (userHandle absent, getPublicKey() null,
	// a member of the other kind of response).
	@(link_name = "PublicKeyCredential_bytes") wr_PublicKeyCredential_bytes :: proc(credential: u64, which: i32, _ret: ^u64) -> i32 ---
	// authenticatorAttachment ("platform", "cross-platform"); Not_Found for null.
	@(link_name = "PublicKeyCredential_authenticatorAttachment") wr_PublicKeyCredential_authenticatorAttachment :: proc(credential: u64, _buf: [^]u8, _cap: u32) -> i32 ---
	// response.getTransports(), comma separated, in lexicographical order.
	@(link_name = "PublicKeyCredential_transports") wr_PublicKeyCredential_transports :: proc(credential: u64, _buf: [^]u8, _cap: u32) -> i32 ---
	// response.getPublicKeyAlgorithm() (a COSE algorithm identifier); 0 for an assertion.
	@(link_name = "PublicKeyCredential_publicKeyAlgorithm") wr_PublicKeyCredential_publicKeyAlgorithm :: proc(credential: u64) -> i32 ---
	// getClientExtensionResults() in its JSON form (AuthenticationExtensionsClientOutputsJSON).
	@(link_name = "PublicKeyCredential_clientExtensionResults") wr_PublicKeyCredential_clientExtensionResults :: proc(credential: u64, _buf: [^]u8, _cap: u32) -> i32 ---
	// toJSON(): RegistrationResponseJSON or AuthenticationResponseJSON, as text.
	@(link_name = "PublicKeyCredential_toJSON") wr_PublicKeyCredential_toJSON :: proc(credential: u64, _buf: [^]u8, _cap: u32) -> i32 ---
}

