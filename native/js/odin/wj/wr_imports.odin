// module frames
foreign import _wr_wj_frames "frames"
@(default_calling_convention = "contextless")
foreign _wr_wj_frames {
	// The navigable of the calling document.
	@(link_name = "Frame_self") wr_Frame_self :: proc() -> u64 ---
	// The navigable of a frame element (<iframe>, <frame>) of the calling document; 0 when it has none (not
	// connected, frames off).
	@(link_name = "Frame_ofElement") wr_Frame_ofElement :: proc(element: u64) -> u64 ---
	// The parent navigable; 0 for a top-level one, or one that is gone.
	@(link_name = "Frame_parent") wr_Frame_parent :: proc(navigable: u64) -> u64 ---
	// The top-level navigable of its tab; 0 when it is gone.
	@(link_name = "Frame_top") wr_Frame_top :: proc(navigable: u64) -> u64 ---
	// How many child navigables its document has (window.length).
	@(link_name = "Frame_length") wr_Frame_length :: proc(navigable: u64) -> u32 ---
	// Its document's index-th child navigable in tree order of their containers (window[index]); 0 when none.
	@(link_name = "Frame_child") wr_Frame_child :: proc(navigable: u64, index: u32) -> u64 ---
	// Its document's child navigable named `name` (window[name], reachable across origins); 0 when none.
	@(link_name = "Frame_named") wr_Frame_named :: proc(navigable: u64, name: [^]u8, name_len: u32) -> u64 ---
	// The names of its document's child navigables, NUL separated (the WindowProxy's own property names).
	@(link_name = "Frame_childNames") wr_Frame_childNames :: proc(navigable: u64, _buf: [^]u8, _cap: u32) -> i32 ---
	// window.closed: the navigable is gone, or has no document.
	@(link_name = "Frame_closed") wr_Frame_closed :: proc(navigable: u64) -> i32 ---
	// Whether its document is same origin with the calling one.
	@(link_name = "Frame_sameOrigin") wr_Frame_sameOrigin :: proc(navigable: u64) -> i32 ---
	// otherWindow.postMessage(message, targetOrigin): `data` is the message's structured serialization
	// (runtime/clone.c); `target_origin` is "*", "/" or a URL. The message is delivered from a task of the target's,
	// if its document's origin then matches. Syntax for an invalid target origin, Data_Clone for a message over
	// frames.max_message_bytes.
	@(link_name = "Frame_postMessage") wr_Frame_postMessage :: proc(navigable: u64, data: [^]u8, data_len: u32, target_origin: [^]u8, target_origin_len: u32) -> i32 ---
	// otherWindow.location = url, location.href = url, location.replace(url): Security when the calling document may
	// not navigate it (HTML "allowed to navigate", the sandbox; the console says why), Syntax for an invalid URL.
	@(link_name = "Frame_navigate") wr_Frame_navigate :: proc(navigable: u64, url: [^]u8, url_len: u32, replace: i32) -> i32 ---
	// window.open(url, target): a frame's name, _self, _parent or _top is navigated and its navigable returned; any
	// other target opens a new tab (when the embedder can) and gives 0 (no opener relationship, as noopener).
	// Not_Allowed in a sandboxed document without allow-popups, Syntax for an invalid URL.
	@(link_name = "Frame_open") wr_Frame_open :: proc(url: [^]u8, url_len: u32, target: [^]u8, target_len: u32, _ret: ^u64) -> i32 ---
	// otherWindow.postMessage(message, targetOrigin, [ports]): the same, with the MessagePorts of the transfer list
	// shipped as port ends (Port_ship / Port_entangle): the receiver's MessageEvent.ports are bound to them.
	@(link_name = "Frame_postMessagePorts") wr_Frame_postMessagePorts :: proc(navigable: u64, data: [^]u8, data_len: u32, target_origin: [^]u8, target_origin_len: u32, ports: [^]u64, ports_len: u32) -> i32 ---
	// window.name: its navigable's name.
	@(link_name = "Window_get_name") wr_Window_get_name :: proc(_buf: [^]u8, _cap: u32) -> i32 ---
	// window.name = value
	@(link_name = "Window_set_name") wr_Window_set_name :: proc(value: [^]u8, value_len: u32) ---
}

// module fs
foreign import _wr_wj_fs "fs"
@(default_calling_convention = "contextless")
foreign _wr_wj_fs {
	// navigator.storage.getDirectory(): the root of the realm's origin private file system. Security outside a secure
	// context, for an opaque origin or a profile without a folder. `bucket`: a storage bucket's (StorageBucket.getDirectory),
	// "" for the default one; Invalid_State once the bucket was deleted.
	@(link_name = "Fs_opfsRoot") wr_Fs_opfsRoot :: proc(bucket: [^]u8, bucket_len: u32, _ret: ^u64) -> i32 ---
	// getFileHandle / getDirectoryHandle(name, {create}) on the directory at `path`: the child's path. Not_Found,
	// Type (an invalid name), Not_Allowed (no permission), Invalid_State ("TypeMismatchError": the other kind).
	@(link_name = "Fs_getEntry") wr_Fs_getEntry :: proc(root: u64, path: [^]u8, path_len: u32, name: [^]u8, name_len: u32, directory: i32, create: i32, _buf: [^]u8, _cap: u32) -> i32 ---
	// removeEntry(name, {recursive}): Invalid_Modification for a directory that is not empty, No_Modification_Allowed
	// for an entry in use.
	@(link_name = "Fs_removeEntry") wr_Fs_removeEntry :: proc(root: u64, path: [^]u8, path_len: u32, name: [^]u8, name_len: u32, recursive: i32) -> i32 ---
	// The directory's entries: "f" or "d", a tab, the name, one per line.
	@(link_name = "Fs_list") wr_Fs_list :: proc(root: u64, path: [^]u8, path_len: u32, _buf: [^]u8, _cap: u32) -> i32 ---
	// resolve(): the names from the first entry down to the second, "/"-joined (Not_Found: not below it).
	@(link_name = "Fs_resolve") wr_Fs_resolve :: proc(root: u64, path: [^]u8, path_len: u32, root2: u64, path2: [^]u8, path2_len: u32, _buf: [^]u8, _cap: u32) -> i32 ---
	// isSameEntry
	@(link_name = "Fs_same") wr_Fs_same :: proc(root: u64, path: [^]u8, path_len: u32, root2: u64, path2: [^]u8, path2_len: u32) -> i32 ---
	// getFile(): a File object (a LocalFile of module dnd: read on demand).
	@(link_name = "Fs_getFile") wr_Fs_getFile :: proc(root: u64, path: [^]u8, path_len: u32, _ret: ^u64) -> i32 ---
	// createWritable({keepExistingData}) (a temporary file) or createSyncAccessHandle() (`sync`: the file itself,
	// exclusive): an open entry's id. No_Modification_Allowed while it is locked.
	@(link_name = "Fs_open") wr_Fs_open :: proc(root: u64, path: [^]u8, path_len: u32, keep: i32, sync: i32, _ret: ^u64) -> i32 ---
	// Writes at `at` (-1: the cursor): the bytes written. Quota past opfs.max_bytes_per_origin.
	@(link_name = "Fs_write") wr_Fs_write :: proc(id: u64, at: i64, data: [^]u8, data_len: u32, _ret: ^i64) -> i32 ---
	// Reads into `into` from `at` (-1: the cursor): the bytes read.
	@(link_name = "Fs_read") wr_Fs_read :: proc(id: u64, at: i64, into: [^]u8, into_cap: u32, _ret: ^i64) -> i32 ---
	@(link_name = "Fs_seek") wr_Fs_seek :: proc(id: u64, position: i64) -> i32 ---
	@(link_name = "Fs_truncate") wr_Fs_truncate :: proc(id: u64, size: i64) -> i32 ---
	@(link_name = "Fs_size") wr_Fs_size :: proc(id: u64, _ret: ^i64) -> i32 ---
	@(link_name = "Fs_flush") wr_Fs_flush :: proc(id: u64) -> i32 ---
	// close(): a writable's temporary file replaces the entry (`commit` false: abort); a sync handle's lock goes.
	@(link_name = "Fs_close") wr_Fs_close :: proc(id: u64, commit: i32) -> i32 ---
	// queryPermission: 0 granted, 1 prompt, 2 denied.
	@(link_name = "Fs_permission") wr_Fs_permission :: proc(root: u64, write: i32) -> i32 ---
	// requestPermission({mode}): a promise of the state after (the user may be asked).
	@(link_name = "Fs_requestPermission") wr_Fs_requestPermission :: proc(root: u64, write: i32, _ret: ^u64) -> i32 ---
	// showOpenFilePicker (kind 0), showSaveFilePicker (1), showDirectoryPicker (2): a promise of the number of
	// handles, its text one line per handle: root TAB path TAB "f" or "d" TAB name. Abort when cancelled, Security
	// without a user gesture, Not_Supported when disabled. `types`: a line per type, description TAB patterns...
	@(link_name = "Fs_showPicker") wr_Fs_showPicker :: proc(kind: i32, types: [^]u8, types_len: u32, multiple: i32, exclude_all: i32, suggested: [^]u8, suggested_len: u32, start_in: [^]u8, start_in_len: u32, start_root: u64, start_path: [^]u8, start_path_len: u32, id: [^]u8, id_len: u32, readwrite: i32, _ret: ^u64) -> i32 ---
	// A root as structuredClone keeps it ("" when unknown).
	@(link_name = "Fs_describe") wr_Fs_describe :: proc(root: u64, _buf: [^]u8, _cap: u32) -> i32 ---
	// The root a kept description stands for in this realm. Data_Clone for another origin's.
	@(link_name = "Fs_restore") wr_Fs_restore :: proc(description: [^]u8, description_len: u32, _ret: ^u64) -> i32 ---
}

// module fullscreen
foreign import _wr_wj_fullscreen "fullscreen"
@(default_calling_convention = "contextless")
foreign _wr_wj_fullscreen {
	// element.requestFullscreen(options): settled once the window is in full screen. Rejected with TypeError when the
	// element cannot go (not connected, not an element that may, the document is not allowed by the permissions policy or
	// has no recent click or key press, the tab is not shown, full screen is turned off); "fullscreenerror" is fired too.
	@(link_name = "Element_requestFullscreen") wr_Element_requestFullscreen :: proc(element: u64, navigationUI: i32) -> u64 ---
	// document.exitFullscreen(): settled once the window is back. Rejected with TypeError when the document has no
	// fullscreen element.
	@(link_name = "Document_exitFullscreen") wr_Document_exitFullscreen :: proc() -> u64 ---
	// document.fullscreenElement: the fullscreen element, retargeted against the document; null when there is none.
	@(link_name = "Document_fullscreenElement") wr_Document_fullscreenElement :: proc() -> u64 ---
	// shadowRoot.fullscreenElement: the fullscreen element retargeted against the root (null when not in its tree).
	@(link_name = "ShadowRoot_fullscreenElement") wr_ShadowRoot_fullscreenElement :: proc(root: u64) -> u64 ---
	// document.fullscreenEnabled: the document may request full screen (turned on, permissions policy "fullscreen").
	@(link_name = "Document_fullscreenEnabled") wr_Document_fullscreenEnabled :: proc() -> i32 ---
	// document.fullscreen (legacy): the document has a fullscreen element.
	@(link_name = "Document_fullscreen") wr_Document_fullscreen :: proc() -> i32 ---
}

// module history
foreign import _wr_wj_history "history"
@(default_calling_convention = "contextless")
foreign _wr_wj_history {
	// window (the same object every time).
	@(link_name = "Window_self") wr_Window_self :: proc() -> u64 ---
	// document, as a node (target of visibilitychange, readystatechange...).
	@(link_name = "Document_self") wr_Document_self :: proc() -> u64 ---
	// location.href, location.protocol...
	@(link_name = "Location_get") wr_Location_get :: proc(component: i32, _buf: [^]u8, _cap: u32) -> i32 ---
	// location.protocol = ..., location.hash = ... (href behaves like assign). Syntax for an invalid URL, Type when too long.
	@(link_name = "Location_set") wr_Location_set :: proc(component: i32, value: [^]u8, value_len: u32) -> i32 ---
	// location.assign(url)
	@(link_name = "Location_assign") wr_Location_assign :: proc(url: [^]u8, url_len: u32) -> i32 ---
	// location.replace(url)
	@(link_name = "Location_replace") wr_Location_replace :: proc(url: [^]u8, url_len: u32) -> i32 ---
	// location.reload()
	@(link_name = "Location_reload") wr_Location_reload :: proc() ---
	// history.length
	@(link_name = "History_length") wr_History_length :: proc() -> i32 ---
	// history.state: Not_Found when null.
	@(link_name = "History_state") wr_History_state :: proc(_buf: [^]u8, _cap: u32) -> i32 ---
	// history.pushState(state, "", url): Data_Clone past history.max_state_bytes, Syntax for an invalid URL, Security
	// for a URL the document cannot be rewritten to.
	@(link_name = "History_pushState") wr_History_pushState :: proc(state: [^]u8, state_len: u32, url: [^]u8, url_len: u32) -> i32 ---
	// history.replaceState(state, "", url)
	@(link_name = "History_replaceState") wr_History_replaceState :: proc(state: [^]u8, state_len: u32, url: [^]u8, url_len: u32) -> i32 ---
	// history.go(delta): back() is go(-1), forward() go(1), go(0) reloads. Asynchronous.
	@(link_name = "History_go") wr_History_go :: proc(delta: i32) ---
	// history.scrollRestoration, of the current entry.
	@(link_name = "History_scrollRestoration") wr_History_scrollRestoration :: proc() -> i32 ---
	// history.scrollRestoration = mode, for the current entry (and the entries this document adds after it).
	@(link_name = "History_set_scrollRestoration") wr_History_set_scrollRestoration :: proc(mode: i32) ---
}

