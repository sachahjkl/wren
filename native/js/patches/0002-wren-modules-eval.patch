diff --git a/quickjs.c b/quickjs.c
--- a/quickjs.c
+++ b/quickjs.c
@@ -383,6 +383,10 @@ struct JSRuntime {
     void (*gc_prologue)(JSRuntime *rt, void *opaque); /* WREN: called before each collection */
     void *gc_prologue_opaque;
     void *interrupt_opaque;
+    JSDynamicImportHook *dynamic_import_hook; /* WREN: import() goes to the host */
+    void *dynamic_import_opaque;
+    JSCompileStringsHook *compile_strings_hook; /* WREN: eval / Function ask the host first */
+    void *compile_strings_opaque;
 
     JSPromiseHook *promise_hook;
     void *promise_hook_opaque;
@@ -31925,6 +31929,42 @@ JSValue JS_LoadModule(JSContext *ctx, const char *basename,
     return promise;
 }
 
+/* WREN: the host's side of import() and of module graphs fetched before evaluation */
+void JS_LoadModuleWithFuncs(JSContext *ctx, const char *basename, const char *filename,
+                            JSValueConst *resolving_funcs, JSValueConst attributes)
+{
+    JS_LoadModuleInternal(ctx, basename, filename, resolving_funcs, attributes);
+}
+
+void JS_SetDynamicImportHook(JSRuntime *rt, JSDynamicImportHook *hook, void *opaque)
+{
+    rt->dynamic_import_hook = hook;
+    rt->dynamic_import_opaque = opaque;
+}
+
+void JS_SetCompileStringsHook(JSRuntime *rt, JSCompileStringsHook *hook, void *opaque)
+{
+    rt->compile_strings_hook = hook;
+    rt->compile_strings_opaque = opaque;
+}
+
+int JS_GetModuleRequestCount(JSModuleDef *m)
+{
+    return m ? m->req_module_entries_count : 0;
+}
+
+JSAtom JS_GetModuleRequest(JSContext *ctx, JSModuleDef *m, int i, JSValue *attributes)
+{
+    if (!m || i < 0 || i >= m->req_module_entries_count) {
+        if (attributes)
+            *attributes = JS_UNDEFINED;
+        return JS_ATOM_NULL;
+    }
+    if (attributes)
+        *attributes = js_dup(m->req_module_entries[i].attributes);
+    return JS_DupAtom(ctx, m->req_module_entries[i].module_name);
+}
+
 static JSValue js_dynamic_import_job(JSContext *ctx,
                                      int argc, JSValueConst *argv)
 {
@@ -32045,6 +32085,13 @@ static JSValue js_dynamic_import(JSContext *ctx, JSValueConst specifier,
     args[3] = specifier_str;
     args[4] = attributes;
 
+    if (ctx->rt->dynamic_import_hook) {
+        /* WREN: the host fetches the module graph first, then settles the promise */
+        if (ctx->rt->dynamic_import_hook(ctx, basename_val, specifier_str, attributes,
+                                         vc(resolving_funcs), ctx->rt->dynamic_import_opaque) < 0)
+            goto exception;
+        goto done;
+    }
     /* cannot run JS_LoadModuleInternal synchronously because it would
        cause an unexpected recursion in js_evaluate_module() */
     JS_EnqueueJob(ctx, js_dynamic_import_job, 5, vc(args));
@@ -38277,7 +38324,8 @@ static JSValue __JS_EvalInternal(JSContext *ctx, JSValueConst this_obj,
     /* Could add a flag to avoid resolution if necessary */
     if (m) {
         m->func_obj = fun_obj;
-        if (js_resolve_module(ctx, m) < 0)
+        /* WREN: a module the host compiles before the rest of its graph arrived is linked later */
+        if (!(flags & JS_EVAL_FLAG_WREN_NO_RESOLVE) && js_resolve_module(ctx, m) < 0)
             goto fail1;
         fun_obj = JS_NewModuleValue(ctx, m);
     }
@@ -38323,6 +38371,10 @@ static JSValue JS_EvalObject(JSContext *ctx, JSValueConst this_obj,
 
     if (!JS_IsString(val))
         return js_dup(val);
+    if (ctx->rt->compile_strings_hook &&
+        ctx->rt->compile_strings_hook(ctx, val, (flags & JS_EVAL_TYPE_MASK) == JS_EVAL_TYPE_DIRECT,
+                                      ctx->rt->compile_strings_opaque) < 0)
+        return JS_EXCEPTION;
     str = JS_ToCStringLen(ctx, &len, val);
     if (!str)
         return JS_EXCEPTION;
diff --git a/quickjs.h b/quickjs.h
--- a/quickjs.h
+++ b/quickjs.h
@@ -460,6 +460,9 @@ static inline bool JS_VALUE_IS_NAN(JSValue v)
 /* allow top-level await in normal script. JS_Eval() returns a
    promise. Only allowed with JS_EVAL_TYPE_GLOBAL */
 #define JS_EVAL_FLAG_ASYNC (1 << 7)
+/* WREN: compile a module without resolving its imports (with JS_EVAL_FLAG_COMPILE_ONLY): they are linked later, by
+   JS_LoadModule / JS_ResolveModule */
+#define JS_EVAL_FLAG_WREN_NO_RESOLVE (1 << 9)
 
 typedef JSValue JSCFunction(JSContext *ctx, JSValueConst this_val, int argc, JSValueConst *argv);
 typedef JSValue JSCFunctionMagic(JSContext *ctx, JSValueConst this_val, int argc, JSValueConst *argv, int magic);
@@ -1238,6 +1241,25 @@ JS_EXTERN void JS_SetModuleLoaderFunc2(JSRuntime *rt,
 JS_EXTERN void JS_SetModuleNormalizeFunc2(JSRuntime *rt,
                                           JSModuleNormalizeFunc2 *module_normalize);
 
+/* WREN: the static imports of a compiled module (the host fetches a whole graph before evaluating it): their count,
+   and the specifier of the i-th (an atom the caller frees) with its import attributes (a new reference, undefined
+   when there are none). */
+JS_EXTERN int JS_GetModuleRequestCount(JSModuleDef *m);
+JS_EXTERN JSAtom JS_GetModuleRequest(JSContext *ctx, JSModuleDef *m, int i, JSValue *attributes);
+/* WREN: import() hands the request to the host instead of loading the module at once; the host settles
+   resolving_funcs later (JS_LoadModuleWithFuncs once the graph is there). Return -1 with an exception pending to
+   reject the promise at once. */
+typedef int JSDynamicImportHook(JSContext *ctx, JSValueConst basename, JSValueConst specifier,
+                                JSValueConst attributes, JSValueConst *resolving_funcs, void *opaque);
+JS_EXTERN void JS_SetDynamicImportHook(JSRuntime *rt, JSDynamicImportHook *hook, void *opaque);
+/* WREN: resolves, links and evaluates a module, then settles resolving_funcs with its namespace or its error. */
+JS_EXTERN void JS_LoadModuleWithFuncs(JSContext *ctx, const char *basename, const char *filename,
+                                      JSValueConst *resolving_funcs, JSValueConst attributes);
+/* WREN: HostEnsureCanCompileStrings: called before eval() or the Function constructors compile a string (`direct`
+   for a direct eval). Return -1 with an exception pending to refuse. */
+typedef int JSCompileStringsHook(JSContext *ctx, JSValueConst source, bool direct, void *opaque);
+JS_EXTERN void JS_SetCompileStringsHook(JSRuntime *rt, JSCompileStringsHook *hook, void *opaque);
+
 /* return the import.meta object of a module */
 JS_EXTERN JSValue JS_GetImportMeta(JSContext *ctx, JSModuleDef *m);
 JS_EXTERN JSAtom JS_GetModuleName(JSContext *ctx, JSModuleDef *m);
