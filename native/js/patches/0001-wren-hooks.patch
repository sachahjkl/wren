+                sf.arg_count = 1;
+                sf.arg_buf = &val;
+                rt->current_stack_frame = &sf;
+                ret = setter->u.cfunc.c_function.setter(setter->u.cfunc.realm, this_obj, val);
+                rt->current_stack_frame = sf.prev_frame;
