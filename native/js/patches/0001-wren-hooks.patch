+/* WREN: property reads of the browser's bindings are C getters; calling them through JS_CallInternal costs as much as
+   the rest of the read. Same frame bookkeeping as js_call_c_function (backtraces, realm), nothing else. */
+static JSValue js_call_getter(JSContext *ctx, JSObject *getter, JSValueConst this_obj)
+{
+    JSValue func = js_dup(JS_MKPTR(JS_TAG_OBJECT, getter));   /* the property could be removed in the getter */
+    JSValue ret;
+    if (getter->class_id == JS_CLASS_C_FUNCTION && getter->u.cfunc.cproto == JS_CFUNC_getter) {
+        JSRuntime *rt = ctx->rt;
+        JSStackFrame sf;
+        if (js_check_stack_overflow(rt, 0)) {
+            JS_FreeValue(ctx, func);
+            return JS_ThrowStackOverflow(ctx);
+        }
+        sf.prev_frame = rt->current_stack_frame;
+        sf.is_strict_mode = false;
+        sf.is_constructor = false;
+        sf.cur_func = func;
+        sf.arg_count = 0;
+        sf.arg_buf = NULL;
+        rt->current_stack_frame = &sf;
+        ret = getter->u.cfunc.c_function.getter(getter->u.cfunc.realm, this_obj);
+        rt->current_stack_frame = sf.prev_frame;
+        JS_FreeValue(ctx, func);
+        return ret;
+    }
+    return JS_CallFree(ctx, func, this_obj, 0, NULL);
+}
