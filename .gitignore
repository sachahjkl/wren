build/
*.exe
*.pdb
*.obj
*.ilk
examples/site/counter.wasm
examples/site/formstest.wasm
examples/site/fetchpage.wasm
examples/site/mutation.wasm
examples/site/workerstest_worker.wasm
src/browser/wren.res
# cargo run by hand inside the native/ workspace (wrentool build native uses build/native/target)
native/target/
native/media/target/
# release packages (wrentool package writes them under build/)
*.zip
# a policy file next to the exe overrides every preference (browser --policy)
policies.txt
.vs/
.vscode/
src/browser/wren_dev.res
# licences: the private signing key (wrentool license keygen writes it to %USERPROFILE%\.wren-license, outside the
# repository) and the licences issued to supporters never belong here
.wren-license/
private.key
*.private.key
*.wrenlicense

# SOPS: a decrypted copy of secrets/ never stays (secrets/README.md)
secrets/*.plain.yaml
secrets/*.plain.json
secrets/*.plain.env

# big media made by wrentool gen perf-media (the yt_* scenarios of wrentool bench perf)
examples/site/media/video/perf_*
examples/site/mutation_class.wasm
