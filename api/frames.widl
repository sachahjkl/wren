/// Nested browsing contexts for JavaScript (src/page/frames.odin, frames_scripts.odin, frames_access.odin;
/// native/js/odin/frames.odin). A window of another document is named by its navigable's id: each document runs in its
/// own engine instance, so another window is a WindowProxy of the calling realm. Across origins it reaches what HTML lets
/// a cross-origin window reach (postMessage, location as a setter, closed, frames, length, top, parent, opener, window,
/// self, close, focus, blur). Between documents of one origin, nodes are reached directly: every node handle names its
/// document (base.pool_insert_tagged), the browser routes the call to it and checks the origin on each call.
[Exposed=Window]
module frames {
  /// The navigable of the calling document.
  u64 Frame_self();
  /// The navigable of a frame element (<iframe>, <frame>) of the calling document; 0 when it has none (not
  /// connected, frames off).
  u64 Frame_ofElement(u64 element);
  /// The parent navigable; 0 for a top-level one, or one that is gone.
  u64 Frame_parent(u64 navigable);
  /// The top-level navigable of its tab; 0 when it is gone.
  u64 Frame_top(u64 navigable);
  /// How many child navigables its document has (window.length).
  u32 Frame_length(u64 navigable);
  /// Its document's index-th child navigable in tree order of their containers (window[index]); 0 when none.
  u64 Frame_child(u64 navigable, u32 index);
  /// Its document's child navigable named `name` (window[name], reachable across origins); 0 when none.
  u64 Frame_named(u64 navigable, string name);
  /// The names of its document's child navigables, NUL separated (the WindowProxy's own property names).
  string Frame_childNames(u64 navigable);
  /// window.closed: the navigable is gone, or has no document.
  bool Frame_closed(u64 navigable);
  /// Whether its document is same origin with the calling one.
  bool Frame_sameOrigin(u64 navigable);
  /// Its document's Document node, when the calling document may reach it (same origin); 0 otherwise.
  /// iframe.contentDocument, otherWindow.document.
  u64 Frame_documentOf(u64 navigable);
  /// The frame element holding this navigable's document, when the calling document may reach it; 0 otherwise
  /// (window.frameElement).
  u64 Frame_elementOf(u64 navigable);
  /// The navigable whose document holds `node`, a node the calling document may reach; 0 otherwise
  /// (document.defaultView of another document).
  u64 Frame_ofDocument(u64 node);
  /// The next import of the calling realm that names no node acts on the document holding `node`
  /// (document.createTextNode of another document). False when that document cannot be reached (gone, another origin).
  bool Frame_target(u64 node);
  /// The browser's object for the window of this navigable (a target for events), when the calling document may reach it; 0 otherwise.
  u64 Frame_windowTarget(u64 navigable);
  /// The realm of the calling document (a number for Frame_bridge).
  u64 Frame_realmSelf();
  /// The realm of the document this navigable shows, when the calling document may reach it; 0 otherwise.
  u64 Frame_realmOf(u64 navigable);
  /// A request of the value bridge (native/js/odin/frames_bridge.odin) to another realm: the size of its reply, read
  /// with Frame_bridgeReply; 0 when that realm is gone or may not be reached.
  u32 Frame_bridge(u64 realm, bytes request);
  /// The reply of the last Frame_bridge.
  bytes Frame_bridgeReply();
  /// Moves `node`, of another document, to the document holding `into` (DOM "adopt"), as lone nodes: the handles of the
  /// nodes moved, each old one (u64) followed by its new one (the first pair is `node`'s). Security when one of the two
  /// cannot be reached.
  bytes Frame_adoptNode(u64 node, u64 into) raises;
  /// otherWindow.postMessage(message, targetOrigin): `data` is the message's structured serialization
  /// (runtime/clone.c); `target_origin` is "*", "/" or a URL. The message is delivered from a task of the target's,
  /// if its document's origin then matches. Syntax for an invalid target origin, Data_Clone for a message over
  /// frames.max_message_bytes.
  void Frame_postMessage(u64 navigable, bytes data, usvstring target_origin) raises;
  /// otherWindow.location = url, location.href = url, location.replace(url): Security when the calling document may
  /// not navigate it (HTML "allowed to navigate", the sandbox; the console says why), Syntax for an invalid URL.
  void Frame_navigate(u64 navigable, usvstring url, bool replace) raises;
  /// window.open(url, target): a frame's name, _self, _parent or _top is navigated and its navigable returned; any
  /// other target opens a new tab (when the embedder can) and gives 0 (no opener relationship, as noopener).
  /// Not_Allowed in a sandboxed document without allow-popups, Syntax for an invalid URL.
  u64 Frame_open(usvstring url, string target) raises;

  /// otherWindow.postMessage(message, targetOrigin, [ports]): the same, with the MessagePorts of the transfer list
  /// shipped as port ends (Port_ship / Port_entangle): the receiver's MessageEvent.ports are bound to them.
  void Frame_postMessagePorts(u64 navigable, bytes data, usvstring target_origin, u64[] ports) raises;

  /// window.name: its navigable's name.
  string Window_get_name();
  /// window.name = value
  void Window_set_name(string value);
}

/// <iframe srcdoc>, reflected as a string (TrustedHTML is not supported: strings are).
partial module dom {
  /// iframe.srcdoc
  string HTMLIFrameElement_srcdoc(Element element);
  /// iframe.srcdoc = value
  void HTMLIFrameElement_set_srcdoc(Element element, string value) raises;
}
