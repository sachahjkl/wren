/// WebGL 1 and 2 for native/js/odin/web_webgl.js: a context is a host object over a device of its own (native/webgl, a thread); the
/// script sends it command buffers and waits only for what it has to know. A context that is gone (its canvas freed, its
/// device lost) does nothing and answers -1 or false: these calls also come from a Wasm module of the page with any numbers, and
/// the command stream is checked on the device's side.
[Exposed=Window]
module webgl {
  /// What a context has to say: kind 1 it was lost.
  callback WebGLNotify(i32 user, i32 kind);

  /// The preference webgl.enabled, and webgl.webgl2 for `version` 2.
  bool WebGL_enabled(i32 version);
  /// A context on a canvas (an element or an OffscreenCanvas). flags: 1 WebGL 2, 2 alpha, 4 depth, 8 stencil, 16 antialias,
  /// 32 premultipliedAlpha, 64 preserveDrawingBuffer, 128 failIfMajorPerformanceCaveat. `info`: 8 i32, for the script. 0: refused,
  /// WebGL_createError says why (nothing when the canvas already has a context of another kind).
  u64 WebGL_create(HTMLCanvasElement canvas, u32 flags, WebGLNotify notify, i32 user, out bytes info);
  u64 WebGL_createOffscreen(OffscreenCanvas canvas, u32 flags, WebGLNotify notify, i32 user, out bytes info);
  string WebGL_createError();
  /// Commands; `data` is the bytes of the last one. `drew`: the canvas changed.
  void WebGL_submit(u64 context, bytes commands, bytes data, bool drew);
  /// A question: waits for the answer (its bytes in `reply`). Its length, or the length it needs when it does not fit; -1: the
  /// context did not answer in time or is gone.
  f64 WebGL_query(u64 context, bytes request, out bytes reply);
  /// As WebGL_query, with bytes after the request (a name).
  f64 WebGL_queryText(u64 context, bytes request, bytes text, out bytes reply);
  /// texImage2D of an element or an ImageBitmap: the command with the source's pixels and size. Raises Security for what the
  /// page may not read. 1: nothing to read yet (an image still loading), the page gets INVALID_VALUE.
  i32 WebGL_upload(u64 context, bytes command, u64 source) raises;
  /// The drawing buffer's size.
  u32 WebGL_width(u64 context);
  u32 WebGL_height(u64 context);
  /// What was drawn so far into the canvas's bitmap, now (toDataURL, drawImage).
  void WebGL_snapshot(u64 context);
  bool WebGL_isLost(u64 context);
  void WebGL_lose(u64 context);
  bool WebGL_restore(u64 context);
}
