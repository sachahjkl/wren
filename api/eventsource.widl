/// Server-sent events (HTML EventSource) and the MessageEvent members that are not plain payload. Messages arrive as
/// "message" (or named) events: data in Event_data, the last event id in Event_text.
[Exposed=Window]
module eventsource {
  handle EventSource : Object = Event_Source via lookup_EventSource;

  /// new EventSource(url, {withCredentials}). Syntax for an invalid URL.
  EventSource EventSource_create(string url, bool with_credentials = false) raises;
  /// readyState: 0 connecting, 1 open, 2 closed.
  i32 EventSource_readyState(EventSource source);
  string EventSource_url(EventSource source);
  bool EventSource_withCredentials(EventSource source);
  /// source.close()
  void EventSource_close(EventSource source);
  /// MessageEvent.origin
  string MessageEvent_origin(Event event);
  /// MessageEvent.lastEventId ("" for messages that do not come from an EventSource).
  string MessageEvent_lastEventId(Event event);
}
