/// The track lists of a media element (src/page/media_tracks.odin, media_texttracks.odin): AudioTrackList, VideoTrackList
/// and TextTrackList (EventTargets: addtrack / removetrack / change), the AudioTrack / VideoTrack / TextTrack they hold,
/// the TextTrackCue / VTTCue and TextTrackCueList of a text track, and the <track> element. The audio and video tracks
/// are built from what the container demuxer announced; text tracks come from <track src> (WebVTT, parsed natively by
/// media.vtt_parse) or addTextTrack. Which cues are active is tracked by the player's time and the shell draws the
/// showing tracks over the video.
[Exposed=Window]
module mediatracks {
  handle AudioTrackList : Object = Track_List_Object via lookup_AudioTrackList;
  handle VideoTrackList : Object = Track_List_Object via lookup_VideoTrackList;
  handle TextTrackList : Object = Track_List_Object via lookup_TextTrackList;
  handle AudioTrack : Object = Track_Entry via lookup_AudioTrack;
  handle VideoTrack : Object = Track_Entry via lookup_VideoTrack;
  handle TextTrack : Object = Text_Track_Object via lookup_TextTrack;
  handle TextTrackCue : Object = Text_Cue_Object via lookup_TextTrackCue;
  handle TextTrackCueList : Object = Text_Cue_List_Object via lookup_TextTrackCueList;
  handle HTMLTrackElement : Element = dom.Node via lookup_HTMLTrackElement;

  u32 AudioTrackList_length(AudioTrackList list);
  /// list[index]: Not_Found past the end.
  AudioTrack AudioTrackList_item(AudioTrackList list, u32 index) raises;
  /// list.getTrackById(id): 0 (null) when none matches.
  AudioTrack AudioTrackList_getTrackById(AudioTrackList list, string id);

  u32 VideoTrackList_length(VideoTrackList list);
  VideoTrack VideoTrackList_item(VideoTrackList list, u32 index) raises;
  VideoTrack VideoTrackList_getTrackById(VideoTrackList list, string id);
  /// videoTrackList.selectedIndex: the index of the selected track, -1 when none.
  i32 VideoTrackList_selectedIndex(VideoTrackList list);

  u32 TextTrackList_length(TextTrackList list);
  TextTrack TextTrackList_item(TextTrackList list, u32 index) raises;
  TextTrack TextTrackList_getTrackById(TextTrackList list, string id);

  string AudioTrack_id(AudioTrack track);
  string AudioTrack_kind(AudioTrack track);
  string AudioTrack_label(AudioTrack track);
  string AudioTrack_language(AudioTrack track);
  bool AudioTrack_enabled(AudioTrack track);
  void AudioTrack_set_enabled(AudioTrack track, bool value);

  string VideoTrack_id(VideoTrack track);
  string VideoTrack_kind(VideoTrack track);
  string VideoTrack_label(VideoTrack track);
  string VideoTrack_language(VideoTrack track);
  bool VideoTrack_selected(VideoTrack track);
  void VideoTrack_set_selected(VideoTrack track, bool value);

  /// track.kind / label / language / id (TextTrack).
  string TextTrack_kind(TextTrack track);
  string TextTrack_label(TextTrack track);
  string TextTrack_language(TextTrack track);
  string TextTrack_id(TextTrack track);
  /// track.mode: "disabled", "hidden" or "showing".
  string TextTrack_mode(TextTrack track);
  void TextTrack_set_mode(TextTrack track, string value);
  /// track.cues / activeCues: a TextTrackCueList (0: the track is disabled).
  TextTrackCueList TextTrack_cues(TextTrack track);
  TextTrackCueList TextTrack_activeCues(TextTrack track);
  /// track.addCue(cue) / removeCue(cue).
  void TextTrack_addCue(TextTrack track, TextTrackCue cue) raises;
  void TextTrack_removeCue(TextTrack track, TextTrackCue cue) raises;

  string TextTrackCue_id(TextTrackCue cue);
  void TextTrackCue_set_id(TextTrackCue cue, string value);
  f64 TextTrackCue_startTime(TextTrackCue cue);
  void TextTrackCue_set_startTime(TextTrackCue cue, f64 value);
  f64 TextTrackCue_endTime(TextTrackCue cue);
  void TextTrackCue_set_endTime(TextTrackCue cue, f64 value);
  bool TextTrackCue_pauseOnExit(TextTrackCue cue);
  void TextTrackCue_set_pauseOnExit(TextTrackCue cue, bool value);
  /// cue.track: the TextTrack it is in (0: none).
  TextTrack TextTrackCue_track(TextTrackCue cue);

  /// new VTTCue(startTime, endTime, text): a script-made cue.
  TextTrackCue VTTCue_create(f64 start, f64 end, string text) raises;
  /// vttCue.text (the cue payload).
  string VTTCue_text(TextTrackCue cue);
  void VTTCue_set_text(TextTrackCue cue, string value);

  u32 TextTrackCueList_length(TextTrackCueList list);
  TextTrackCue TextTrackCueList_item(TextTrackCueList list, u32 index) raises;
  TextTrackCue TextTrackCueList_getCueById(TextTrackCueList list, string id);

  /// track.track: the <track> element's TextTrack (0: not attached to a media element).
  TextTrack HTMLTrackElement_track(HTMLTrackElement track);
  /// track.readyState: 0 NONE, 1 LOADING, 2 LOADED, 3 ERROR.
  i32 HTMLTrackElement_readyState(HTMLTrackElement track);
}
