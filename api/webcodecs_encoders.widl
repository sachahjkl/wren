/// WebCodecs VideoEncoder / AudioEncoder (src/page/bindings_encoders.odin, native/js/runtime/web_webcodecs_encoders.c).
/// No encoder is linked in this build, so isConfigSupported is honestly false and configure raises NotSupportedError.
/// The objects and their state machine exist so feature detection and `new VideoEncoder({...})` behave; when an encoder
/// crate is added, configure()/encode() wire to it here.
[Exposed=(Window,Worker)]
module webcodecs_encoders {
  handle VideoEncoder : Object = Encoder_Obj via lookup_VideoEncoder;
  handle AudioEncoder : Object = Encoder_Obj via lookup_AudioEncoder;

  callback VideoEncoderOutput(i32 user, u64 chunk);
  callback VideoEncoderError(i32 user, i32 code);
  callback AudioEncoderOutput(i32 user, u64 chunk);
  callback AudioEncoderError(i32 user, i32 code);

  [Owned] VideoEncoder VideoEncoder_create(VideoEncoderOutput output, i32 output_user, VideoEncoderError error, i32 error_user) raises;
  [Owned] AudioEncoder AudioEncoder_create(AudioEncoderOutput output, i32 output_user, AudioEncoderError error, i32 error_user) raises;

  /// Honest: false for every codec (no encoder is linked).
  bool VideoEncoder_isConfigSupported(string codec);
  bool AudioEncoder_isConfigSupported(string codec);

  /// Raises NotSupportedError (no encoder).
  void VideoEncoder_configure(VideoEncoder encoder, string codec) raises;
  void AudioEncoder_configure(AudioEncoder encoder, string codec) raises;
  void VideoEncoder_encode(VideoEncoder encoder) raises;
  void AudioEncoder_encode(AudioEncoder encoder) raises;
  void VideoEncoder_flush(VideoEncoder encoder) raises;
  void AudioEncoder_flush(AudioEncoder encoder) raises;
  void VideoEncoder_reset(VideoEncoder encoder);
  void AudioEncoder_reset(AudioEncoder encoder);
  void VideoEncoder_close(VideoEncoder encoder);
  void AudioEncoder_close(AudioEncoder encoder);
  u32 VideoEncoder_encodeQueueSize(VideoEncoder encoder);
  u32 AudioEncoder_encodeQueueSize(AudioEncoder encoder);
  i32 VideoEncoder_state(VideoEncoder encoder);
  i32 AudioEncoder_state(AudioEncoder encoder);
}
