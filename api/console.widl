/// The console of the page (or of the worker): messages appear in the browser's console. Invalid UTF-8 is shown as
/// U+FFFD.
[Exposed=(Window,Worker)]
module console {
  /// console.log(message)
  void console_log(usvstring message);
  /// console.warn(message)
  void console_warn(usvstring message);
  /// console.error(message)
  void console_error(usvstring message);
}
